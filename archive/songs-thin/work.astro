---
import LyricsBlock from '../../components/LyricsBlock.astro';
import QuickSlang from '../../components/QuickSlang.astro';
import SongLayout from '../../layouts/SongLayout.astro';
import AmazonAlbumCta from "../../components/AmazonAlbumCta.astro";
---

<SongLayout
  title="Work 和訳・意味・スラング解説 | Gang Starr"
  description="Gang Starr「Work」の歌詞和訳とスラング徹底解説。DJ Premierの完璧なビートとGuruの努力哲学が結実した1998年ブーンバップの金字塔。Moment of Truth収録。"
  slug="work"
  noindex={true}
  highlights={[
    'DJ Premierによるサンプリングの粋——The Manhattans「Devil in the Dark」のソウルを核にした名ビート',
    'Guruが「努力・グラインド・ステータス向上」を説く普遍的ワークエシック・アンセム',
    '1998年『Moment of Truth』収録——Gang Starrキャリアの絶頂を刻む楽曲',
  ]}
  youtubeId="3DJOJjHF_FA"
  sampleYoutubeId=""
  sampleTitle=""
>

    <!-- この曲の意味 -->
    <section class="mb-6">
      <h2 class="text-base font-semibold mb-2">■この曲の意味（要約）</h2>
      <p class="text-sm text-[var(--c-muted)] leading-relaxed">Guruが「Work（働く・努力する）」という行為そのものを賛歌として歌い上げた一曲。ライバルへの警告、ストリートの現実、そして地道な積み重ねによるステータス向上——「I put in work」というラインが楽曲の核心を体現する。DJ Premierの多層的サンプリングとスクラッチが、Guruの哲学的フロウを最高の形で彩る。</p>
    </section>

    <!-- 概要 -->
    <section class="mb-6">
      <h2 class="text-base font-semibold mb-2">■概要</h2>
      <p class="text-sm text-[var(--c-muted)] leading-relaxed">1998年アルバム『Moment of Truth』収録。プロデュースはDJ Premier。The Manhattans「Devil in the Dark」のソウルヴォーカルを核に、ドラムとスクラッチを重ねて構築した。BPM約88のミッドテンポ・ブーンバップで、Guruが努力・忍耐・真正性をリリックで体現した。</p>
    </section>

    <!-- 導入 -->
    <section class="mb-10">
      <h2 class="text-base font-semibold mb-2">■導入（時代背景）</h2>
      <p class="text-sm text-[var(--c-muted)] leading-relaxed">1998年、ヒップホップは商業的成功の頂点にあった。東西抗争終結後、シーンはジグジーとバブリーなサウンドに向かいつつあった。その中でGang Starrは一切妥協せず、ブーンバップのリアリズムと知的リリシズムを追求した『Moment of Truth』をリリース。「Work」はその核心にある楽曲——華やかさではなく「積み重ね」こそが本物のステータスを生むという宣言だった。</p>
    </section>

    <!-- Table of Contents -->
    <nav class="mb-10 p-4 bg-[var(--c-surface)] border border-[var(--c-border)] rounded-lg">
      <p class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-3">目次</p>
      <ol class="space-y-1.5 text-sm text-[var(--c-muted)] list-none">
        <li><a href="#lyrics" class="hover:text-[var(--c-gold)] transition-colors">01 — 歌詞和訳と意味解説</a></li>
        <li><a href="#background" class="hover:text-[var(--c-gold)] transition-colors">02 — 文化的背景</a></li>
        <li><a href="#behind" class="hover:text-[var(--c-gold)] transition-colors">03 — 制作の裏側</a></li>
        <li><a href="#legacy" class="hover:text-[var(--c-gold)] transition-colors">04 — 評価とその後の影響</a></li>
      </ol>
    </nav>

    <div id="lyrics"></div>

    <!-- ===================== -->
    <!-- INTRO                 -->
    <!-- ===================== -->
    <AmazonAlbumCta asin="B000025MRQ" cover="/images/covers/work.jpg" title="Work / Moment of Truth" artist="Gang Starr" />

    <!-- まとめ -->
    <section class="mb-12">
      <h2 class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-5 border-b border-[var(--c-border)] pb-2">
        まとめ
      </h2>
      <ul class="space-y-2 text-sm text-[var(--c-muted)] list-disc list-inside leading-relaxed">
        <li>DJプレミアがThe Manhattans「Devil in the Dark」を軸に組み上げた神業ビート——BPM約88のミッドテンポ・ブーンバップの頂点。</li>
        <li>「I put in work, and watch my status escalate」——努力と忍耐によるステータス向上というGuruの哲学を最も直接的に体現したフレーズ。</li>
        <li>「Fully qualified pro in this business of rap」というアウトロのスクラッチが、楽曲全体を総括する美しい構造的締め。</li>
        <li>Guru（2010年逝去）の不撓不屈のWorkエシックとDJプレミアの不滅のビートが「Work」を時代を超えた努力のアンセムとして刻んだ。</li>
      </ul>
    </section>

</SongLayout>
