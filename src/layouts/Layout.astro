---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description: string;
  schema?: object;
}

const { title, description, schema } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://hiphop.vercel.app');
const pathname = Astro.url.pathname;
const isHome = pathname === '/';
const isSongPage = pathname.startsWith('/songs/');

type BreadcrumbItem = { label: string; href?: string };
let breadcrumbItems: BreadcrumbItem[] = [];
if (!isHome) {
  breadcrumbItems.push({ label: 'ホーム', href: '/' });
  if (isSongPage) {
    breadcrumbItems.push({ label: '曲一覧', href: '/' });
    breadcrumbItems.push({ label: title.split(' 和訳')[0].split(' |')[0] });
  } else {
    const pageLabels: Record<string, string> = {
      '/about': 'About',
      '/privacy': 'プライバシーポリシー',
      '/slang': 'スラング索引',
    };
    breadcrumbItems.push({ label: pageLabels[pathname] ?? title });
  }
}
const breadcrumbSchema = breadcrumbItems.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, Astro.site ?? 'https://hiphop.vercel.app').href } : {}),
  })),
} : null;

const songSlug = Astro.url.pathname.match(/^\/songs\/([^/]+)/)?.[1];
const ogImagePath = songSlug ? `/og/${songSlug}.png` : '/og/default.png';
const ogImageURL = new URL(ogImagePath, Astro.site ?? 'https://hiphop.vercel.app').href;

const defaultSchema = {
  '@context': 'https://schema.org',
  '@type': isHome ? 'WebSite' : 'Article',
  name: title,
  description,
  url: canonicalURL.href,
  inLanguage: 'ja',
  publisher: {
    '@type': 'Organization',
    name: 'WAX&amp;THINK',
    url: 'https://hiphop.vercel.app',
  },
};
const resolvedSchema = schema ?? defaultSchema;
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="WAX&amp;THINK" />
  <meta property="og:locale" content="ja_JP" />

  <!-- OGP Image -->
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript><link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" /></noscript>
  <!-- DNS prefetch for external resources -->
  <link rel="dns-prefetch" href="https://ws-fe.amazon-adsystem.com" />
  <link rel="dns-prefetch" href="https://www.youtube.com" />

  <!-- Favicon & PWA -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#0a0a0a" />

  <script type="application/ld+json" set:html={JSON.stringify(resolvedSchema)} />
  {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}

  <!-- RSS -->
  <link rel="alternate" type="application/rss+xml" title="WAX&amp;THINK RSS" href="/rss.xml" />

  <!-- AdSense -->
  <meta name="google-adsense-account" content="ca-pub-7526742711058970" />

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-EN2N33B7PB"></script>
  <script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-EN2N33B7PB');</script>

  <!-- Theme flash prevention -->
  <script is:inline>!function(){var t=localStorage.getItem('hh-theme')||'auto';document.documentElement.setAttribute('data-theme',t)}()</script>
</head>
<body class="bg-[var(--c-bg)] text-[var(--c-text)] min-h-screen">
  <ThemeToggle />
  {breadcrumbItems.length > 0 && (
    <nav aria-label="パンくずリスト" class="max-w-2xl mx-auto px-4 pt-5">
      <ol class="flex items-center flex-wrap gap-x-1.5 gap-y-1 text-xs text-[var(--c-dim)]">
        {breadcrumbItems.map((item, i) => (
          <li class="flex items-center gap-1.5">
            {i > 0 && <span class="text-[var(--c-very-dim)]" aria-hidden="true">/</span>}
            {item.href
              ? <a href={item.href} class="hover:text-[var(--c-gold)] transition-colors">{item.label}</a>
              : <span class="text-[var(--c-text)]">{item.label}</span>
            }
          </li>
        ))}
      </ol>
    </nav>
  )}
  <slot />
  <footer class="max-w-2xl mx-auto px-4 pb-8 pt-6 mt-4 border-t border-[var(--c-border)] flex flex-wrap gap-x-5 gap-y-1 text-[var(--c-very-dim)] text-xs">
    <a href="/" class="hover:text-[var(--c-gold)] transition-colors">WAX&amp;THINK</a>
    <a href="/about" class="hover:text-[var(--c-gold)] transition-colors">About</a>
    <a href="/slang" class="hover:text-[var(--c-gold)] transition-colors">スラング索引</a>
    <a href="/contact" class="hover:text-[var(--c-gold)] transition-colors">お問い合わせ</a>
    <a href="/privacy" class="hover:text-[var(--c-gold)] transition-colors">プライバシーポリシー</a>
  </footer>
</body>
</html>
