---
import Layout from './Layout.astro';
import ExplanationToggle from '../components/ExplanationToggle.astro';
import MercariCta from '../components/MercariCta.astro';
import { songs } from '../data/songs';
import { artists } from '../data/artists';
import { columns } from '../data/columns';

interface Props {
  title: string;
  description: string;
  slug: string;
  highlights?: [string, string, string];
  youtubeId?: string;
  sampleYoutubeId?: string;
  sampleTitle?: string;
  youtubeShortId?: string;
  noindex?: boolean;
  learningPage?: boolean;
  songDuration?: number;  // 実曲長（秒）。プレーヤーのタイムライン総尺。未指定なら最終ユニット+30秒
  youtubeStartSeconds?: number;  // PVの実音源開始位置（秒）。イントロ映像等でmp3と頭出しがズレる曲用。初回再生時にここへシーク
}

const { title, description, slug, highlights, youtubeId, sampleYoutubeId, sampleTitle, youtubeShortId, noindex = false, learningPage = false, songDuration, youtubeStartSeconds } = Astro.props;

const song = songs.find(s => s.slug === `/songs/${slug}`);
const artist = song ? artists.find(a => a.slug === song.artistSlug) : null;
// H1 is the human-readable article heading, decoupled from the SEO <title> prop
const h1 = song ? `${song.title} — ${song.artists} 和訳・スラング解説` : title;
// 更新日メカニズム: データに updatedDate があれば表示（遡及入力は不要・任意）
const updatedDate = (song as { updatedDate?: string } | undefined)?.updatedDate ?? null;
const releaseYear = song?.subtitle.match(/·\s*(\d{4})/)?.[1] ?? null;
// 関連記事: 同アーティスト → 同プロデューサー → 同じ元ネタ → 同時代×同地域 の4段で最大6本。
// songs.ts から build 時に自動計算されるため、曲が増えるほどリンクは勝手に増える（手書き禁止）。
const sampleArtistOf = (s: { sample: string | null }) =>
  s.sample?.match(/^([^"]+?)\s*"/)?.[1]?.trim() ?? null;
const related = song
  ? (() => {
      const others = songs.filter(s => s.slug !== song.slug && s.tier === 'core');
      const seen = new Set<string>();
      const pick = (pred: (s: typeof others[number]) => boolean, reason: string, limit: number) =>
        others
          .filter(s => !seen.has(s.slug) && pred(s))
          .slice(0, limit)
          .map(s => { seen.add(s.slug); return { ...s, reason }; });
      const mySampleArtist = sampleArtistOf(song);
      return [
        ...pick(s => s.artistSlug === song.artistSlug, '同アーティスト', 3),
        ...pick(s => !!song.producer && s.producer === song.producer, `${song.producer} プロデュース`, 2),
        ...pick(s => !!mySampleArtist && sampleArtistOf(s) === mySampleArtist, `同じ元ネタ（${mySampleArtist}）`, 2),
        ...pick(s => s.era === song.era && s.region === song.region, `${song.era}・${song.region}シーン`, 3),
      ].slice(0, 6);
    })()
  : [];
const relatedColumns = song
  ? columns.filter(c => c.relatedSongs.includes(song.slug))
  : [];

// 実曲の事前計算波形（agent/{slug}/assets/audio.mp3 → gen-waveform.mjs）。
// あればプレーヤーの棒グラフ高さに使い、無ければJS側の擬似乱数にフォールバック。
const waveformModules = import.meta.glob<{ default: number[] }>('../data/waveforms/*.json', { eager: true });
const waveformPeaks = waveformModules[`../data/waveforms/${slug}.json`]?.default ?? null;
---

<Layout title={title} description={description} ogType="article" publishedTime={song?.pubDate} modifiedTime={updatedDate ?? undefined} noindex={noindex}>
  <!-- Progress bar -->
  <div id="progress-bar" class="fixed top-0 left-0 h-0.5 bg-[var(--c-gold)] z-50 transition-none" style="width:0%"></div>

  <!-- Fixed player bar (learning pages only) -->
  {learningPage && (
    <div id="learning-player-bar" class="fixed top-11 left-0 right-0 z-40 flex flex-col items-center" style="display:none" data-duration={songDuration != null ? String(songDuration) : undefined} data-peaks={waveformPeaks ? JSON.stringify(waveformPeaks) : undefined} data-yt-start={youtubeStartSeconds != null ? String(youtubeStartSeconds) : undefined}>
      <!-- Main bar -->
      <!-- 再生ボタンを縦2段ぶんの高さに据え、その右に「波形→ラベル」を縦積み。
           ボタン(42px)が全体高を決めるので旧・単一行と同じ薄さのまま文字が波形の下に来る。 -->
      <div class="flex items-center gap-3 px-3 py-1.5 bg-[#0d0d0d]/95 backdrop-blur-md border-b border-[var(--c-border)] max-w-3xl mx-auto w-full">
        <!-- Play/pause（縦センター・2段ぶんを占める） -->
        <button id="player-playpause" aria-label="再生/停止" class="shrink-0 transition-transform duration-150 hover:scale-110" style="width:42px;height:42px;background:#FF4D00;border-radius:50%;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0">
          <svg id="player-icon-play" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="black" style="display:block;margin-left:2px"><polygon points="3,1 15,8 3,15"/></svg>
          <svg id="player-icon-pause" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="black" style="display:none"><rect x="1" y="1" width="4" height="12" rx="1"/><rect x="9" y="1" width="4" height="12" rx="1"/></svg>
        </button>
        <!-- 波形＋ラベルを縦積み（波形は薄め・指タッチで拡大できるので情報密度優先） -->
        <div class="flex-1 flex flex-col gap-0.5 min-w-0">
          <!-- 波形 -->
          <div id="player-seekwave" class="h-6 flex items-end justify-center gap-[1px] cursor-pointer overflow-hidden" style="min-width:0"></div>
          <!-- 時間・スクロール切替・速度（波形の直下。3要素をjustify-betweenで等間隔に。
               非表示要素(display:none)はflexで無視されるので各画面幅で見える3要素が均等になる） -->
          <div class="flex items-center justify-between gap-2">
            <!-- Time readout（デジタル時計風・経過/総尺を同サイズで） -->
            <div class="flex items-baseline gap-1 shrink-0 select-none">
              <span id="player-time" class="player-time-led font-mono font-bold tabular-nums leading-none">0:00</span>
              <span id="player-duration" class="player-time-total font-mono font-bold tabular-nums leading-none">/&nbsp;0:00</span>
            </div>
            <!-- スクロール追従の切替（固定＝ページ動かさない / 連動＝再生に合わせて自動スクロール） -->
            <div class="flex items-center gap-1.5 shrink-0">
              <span class="hidden min-[430px]:inline text-[9px] leading-none tracking-wide text-[var(--c-dim)] whitespace-nowrap">スクロール</span>
              <div id="player-sync-seg" role="group" aria-label="再生に合わせた自動スクロールの切替" class="flex rounded-md overflow-hidden" style="border:1.5px solid var(--c-border)">
                <button id="sync-fixed" type="button" aria-pressed="true" title="固定：再生中もページを動かさず自分のペースで読む" style="border:none;cursor:pointer;padding:3px 9px;font-size:11px;font-weight:700;letter-spacing:.04em;white-space:nowrap;transition:background .15s,color .15s">固定</button>
                <button id="sync-follow" type="button" aria-pressed="false" title="連動：再生位置に合わせて解説へ自動スクロール" style="border:none;border-left:1.5px solid var(--c-border);cursor:pointer;padding:3px 9px;font-size:11px;font-weight:700;letter-spacing:.04em;white-space:nowrap;transition:background .15s,color .15s">連動</button>
              </div>
            </div>
            <!-- 再生速度（速いラップの聞き取り用スロー） -->
            <!-- モバイル：省スペースの循環ボタン（タップで 1× → 0.75× → 0.5×） -->
            <button
              id="player-speed"
              type="button"
              aria-label="再生速度切替"
              title="再生速度：タップで 1× → 0.75× → 0.5×（速いラップの聞き取り用）"
              class="shrink-0 min-[560px]:hidden"
              style="border:1.5px solid var(--c-border);border-radius:6px;cursor:pointer;padding:3px 8px;font-size:11px;font-weight:700;letter-spacing:.02em;white-space:nowrap;background:transparent;color:var(--c-dim);font-variant-numeric:tabular-nums;transition:background .15s,color .15s,border-color .15s"
            >1×</button>
            <!-- 広い画面：全段セグメント＋「スピード」ラベル -->
            <div class="hidden min-[560px]:flex items-center gap-1.5 shrink-0">
              <span class="text-[9px] leading-none tracking-wide text-[var(--c-dim)] whitespace-nowrap">スピード</span>
              <div id="player-speed-seg" role="group" aria-label="再生速度の切替" class="flex rounded-md overflow-hidden" style="border:1.5px solid var(--c-border)">
                <button type="button" data-rate="1" title="等速" style="border:none;cursor:pointer;padding:3px 8px;font-size:11px;font-weight:700;white-space:nowrap;font-variant-numeric:tabular-nums;transition:background .15s,color .15s">1×</button>
                <button type="button" data-rate="0.75" title="0.75倍速（聞き取り用）" style="border:none;border-left:1.5px solid var(--c-border);cursor:pointer;padding:3px 8px;font-size:11px;font-weight:700;white-space:nowrap;font-variant-numeric:tabular-nums;transition:background .15s,color .15s">0.75×</button>
                <button type="button" data-rate="0.5" title="0.5倍速（じっくり聞き取り）" style="border:none;border-left:1.5px solid var(--c-border);cursor:pointer;padding:3px 8px;font-size:11px;font-weight:700;white-space:nowrap;font-variant-numeric:tabular-nums;transition:background .15s,color .15s">0.5×</button>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- Section jump strip (populated by JS) -->
      <div id="player-section-strip" class="flex h-5 w-full max-w-3xl cursor-pointer overflow-hidden" style="display:none"></div>
      <!-- Section color band (current section indicator) -->
      <div id="player-section-band" class="h-1 w-full max-w-3xl transition-colors duration-500" style="background:var(--c-section-intro)"></div>

      <!-- Follow chip: 受動再生で再生カードが画面外の時だけ出す「いま鳴ってるカードへ」誘導 -->
      <button
        id="player-follow"
        aria-label="再生中のカードへ移動"
        class="follow-chip"
        style="display:none;position:absolute;left:50%;top:100%;transform:translateX(-50%);margin-top:10px;align-items:center;gap:8px;max-width:min(86vw,360px);padding:7px 14px 7px 11px;border:none;border-radius:999px;background:#0d0d0d;color:#fff;cursor:pointer;box-shadow:0 0 0 1.5px var(--c-green),0 6px 24px rgba(0,0,0,0.45),0 0 22px var(--c-green-glow);font-size:12px;line-height:1;white-space:nowrap"
      >
        <span aria-hidden="true" class="follow-dot" style="width:8px;height:8px;border-radius:50%;background:var(--c-green);box-shadow:0 0 8px var(--c-green);flex-shrink:0"></span>
        <span id="player-follow-arrow" aria-hidden="true" style="font-weight:700;color:var(--c-green)">↓</span>
        <span class="text-[var(--c-dim)]" style="flex-shrink:0">再生中</span>
        <span id="player-follow-text" style="overflow:hidden;text-overflow:ellipsis;font-weight:700"></span>
      </button>
    </div>
  )}

  <!-- Drag scrubber rail (mobile only) -->
  <div
    id="scrub-rail"
    class="lg:hidden fixed right-1 top-[20%] z-40 h-[58vh] w-8 flex justify-center"
    style="display:none"
  >
    <!-- track -->
    <div class="absolute inset-y-0 left-1/2 -translate-x-1/2 w-[3px] rounded-full bg-[var(--c-border)]"></div>
    <!-- progress fill -->
    <div id="scrub-fill" class="absolute top-0 left-1/2 -translate-x-1/2 w-[3px] rounded-full bg-[var(--c-gold)]/50" style="height:0"></div>
    <!-- thumb -->
    <button
      id="scrub-thumb"
      aria-label="ドラッグでスクロール位置を移動"
      class="absolute left-1/2 -translate-x-1/2 w-8 h-11 rounded-full bg-[var(--c-surface)] border border-[var(--c-gold)]/70 shadow-md flex flex-col items-center justify-center gap-[3px] touch-none transition-transform duration-150"
      style="top:0"
    >
      <span class="block w-3.5 h-[2px] bg-[var(--c-gold)]/80 rounded-full"></span>
      <span class="block w-3.5 h-[2px] bg-[var(--c-gold)]/80 rounded-full"></span>
      <span class="block w-3.5 h-[2px] bg-[var(--c-gold)]/80 rounded-full"></span>
    </button>
    <!-- section label tooltip -->
    <div
      id="scrub-label"
      class="absolute right-10 px-2.5 py-1 rounded-md bg-[var(--c-surface)] border border-[var(--c-gold)]/60 text-[var(--c-gold)] text-xs font-bold whitespace-nowrap shadow-lg opacity-0 transition-opacity duration-150 pointer-events-none max-w-[58vw] truncate"
      style="top:0"
    ></div>
  </div>

  <!-- Seek magnifier loupe (long-press on the player waveform, mobile) -->
  <div
    id="seek-loupe"
    class="fixed z-[60] pointer-events-none"
    style="display:none;width:220px;left:0;top:0;transform:translateX(-50%) scale(.85);opacity:0;transition:opacity .12s ease,transform .12s ease;will-change:left,top,opacity,transform"
  >
    <div style="position:relative;background:#0d0d0dF2;border:1.5px solid var(--c-gold);border-radius:12px;box-shadow:0 10px 30px rgba(0,0,0,.55),0 0 0 4px rgba(0,0,0,.35);padding:8px 8px 6px;backdrop-filter:blur(6px)">
      <canvas id="seek-loupe-canvas" width="408" height="128" style="display:block;width:204px;height:64px"></canvas>
      <div id="seek-loupe-time" class="font-mono" style="text-align:center;margin-top:4px;font-size:12px;font-weight:700;color:var(--c-gold);letter-spacing:.05em">0:00</div>
      <!-- upward pointer (loupeは波形の直下に出るので上向き) -->
      <div style="position:absolute;left:50%;top:-7px;transform:translateX(-50%) rotate(45deg);width:12px;height:12px;background:#0d0d0d;border-left:1.5px solid var(--c-gold);border-top:1.5px solid var(--c-gold)"></div>
    </div>
  </div>

  <!-- Floating explanation toggle (always visible) -->
  <div id="exp-float" class={`fixed bottom-6 right-4 z-40 flex rounded-full overflow-hidden border border-[var(--c-border)] bg-[var(--c-surface)]/90 backdrop-blur-sm shadow-lg font-mono text-[10px]`}>
    <button data-e="tap" class="exp-btn exp-float-btn px-3 py-2 transition-colors">タップ</button>
    <button data-e="always" class="exp-btn exp-float-btn px-3 py-2 transition-colors border-l border-[var(--c-border)]">常時</button>
  </div>

  <div class={`max-w-5xl mx-auto px-4 py-8 lg:grid lg:grid-cols-[1fr_260px] lg:gap-12 lg:items-start${learningPage ? ' pt-16' : ''}`}>

    <!-- Main column -->
    <div>
      <!-- Header -->
      <header class="mb-8">
        <h1 class="text-2xl md:text-3xl font-bold leading-tight mb-4">{h1}</h1>
        {song?.pubDate && (
          <time datetime={song.pubDate} class="block text-[var(--c-very-dim)] text-xs mb-1">
            公開: {new Date(song.pubDate).toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        )}
        {updatedDate && (
          <time datetime={updatedDate} class="block text-[var(--c-very-dim)] text-xs mb-4">
            更新: {new Date(updatedDate).toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        )}
        {song && (
          <dl class="grid grid-cols-2 gap-x-4 gap-y-1 text-xs text-[var(--c-muted)] border border-[var(--c-border)] rounded-lg p-4 bg-[var(--c-surface)]">
            <dt class="text-[var(--c-very-dim)] uppercase tracking-widest">アーティスト</dt>
            <dd>
              {artist
                ? <a href={`/artists/${song.artistSlug}`} class="hover:text-[var(--c-gold)] transition-colors underline underline-offset-2">{song.artists}</a>
                : song.artists
              }
            </dd>
            {releaseYear && <>
              <dt class="text-[var(--c-very-dim)] uppercase tracking-widest">リリース年</dt>
              <dd>{releaseYear}</dd>
            </>}
            <dt class="text-[var(--c-very-dim)] uppercase tracking-widest">プロデューサー</dt>
            <dd>{song.producer === 'その他' ? song.subtitle.split(' Produced')[0].split(' Remix')[0] : song.producer}</dd>
            <dt class="text-[var(--c-very-dim)] uppercase tracking-widest">収録アルバム</dt>
            <dd>{song.album}</dd>
            <dt class="text-[var(--c-very-dim)] uppercase tracking-widest">エリア</dt>
            <dd>{song.region}</dd>
            <dt class="text-[var(--c-very-dim)] uppercase tracking-widest">BPM</dt>
            <dd>{song.bpm}</dd>
            {song.sample && <>
              <dt class="text-[var(--c-very-dim)] uppercase tracking-widest">サンプル元</dt>
              <dd class="col-span-1 truncate">{song.sample}</dd>
            </>}
          </dl>
        )}
      </header>

      <!-- Highlights (mobile only) -->
      {highlights && (
        <section class="mb-8 p-4 border border-[var(--c-gold)]/30 rounded-lg bg-[var(--c-surface)] lg:hidden">
          <p class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-3">この記事の見どころ</p>
          <ol class="space-y-2">
            {highlights.map((h, i) => (
              <li class="flex gap-3 text-sm">
                <span class="text-[var(--c-gold)] font-black tabular-nums shrink-0">{String(i + 1).padStart(2, '0')}</span>
                <span class="text-[var(--c-muted)]">{h}</span>
              </li>
            ))}
          </ol>
        </section>
      )}

      <!-- Album cover + purchase links -->
      {song?.asin ? (
        <div class="mb-6">
          <a href={`https://www.amazon.co.jp/dp/${song.asin}/?tag=wax1124-22`} target="_blank" rel="noopener" class="inline-block group">
            <img
              src={`/images/covers/${slug}.jpg`}
              alt={song.album}
              class="w-48 h-48 rounded-lg object-cover border border-[var(--c-border)] group-hover:border-[var(--c-gold)] transition-colors"
              onerror={`this.onerror=null;this.src='https://m.media-amazon.com/images/P/${song.asin}.01._SCLZZZZZZZ_.jpg'`}
            />
            <p class="text-[var(--c-very-dim)] text-xs mt-2">{song.album}</p>
            <p class="text-[var(--c-gold)] text-[10px] mt-0.5 uppercase tracking-widest"><span class="text-[var(--c-very-dim)] normal-case">[PR]</span> Amazon で購入 →</p>
          </a>
          <a
            href={`https://music.apple.com/jp/search?term=${encodeURIComponent(song.artists + ' ' + song.title)}`}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1.5 mt-2 text-[10px] uppercase tracking-widest text-[var(--c-very-dim)] hover:text-white transition-colors"
          >
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M23.994 6.124a9.23 9.23 0 0 0-.24-2.19c-.317-1.31-1.064-2.31-2.18-3.043a6.33 6.33 0 0 0-1.769-.75c-.55-.135-1.11-.2-1.675-.21-.024 0-.051-.013-.077-.013H5.947c-.026 0-.053.013-.077.013-.565.01-1.124.075-1.674.21a6.33 6.33 0 0 0-1.769.75C1.31 1.624.563 2.624.246 3.934a9.23 9.23 0 0 0-.24 2.19C.002 6.24 0 6.356 0 6.472v11.056c0 .116.002.232.006.348a9.23 9.23 0 0 0 .24 2.19c.317 1.31 1.064 2.31 2.18 3.043a6.33 6.33 0 0 0 1.769.75c.55.135 1.11.2 1.675.21.024 0 .051.013.077.013h12.106c.026 0 .053-.013.077-.013.565-.01 1.124-.075 1.674-.21a6.33 6.33 0 0 0 1.769-.75c1.116-.733 1.863-1.733 2.18-3.043a9.23 9.23 0 0 0 .24-2.19c.004-.116.006-.232.006-.348V6.472c0-.116-.002-.232-.006-.348zM15.9 7.2v1.5h-4.8V18h-1.8V8.7H4.5V7.2h11.4z"/></svg>
            Apple Music で聴く →
          </a>
        </div>
      ) : song ? (
        <div class="mb-6">
          <a href={`https://www.amazon.co.jp/s?k=${encodeURIComponent(song.artists + ' ' + song.album)}&i=music&tag=wax1124-22`} target="_blank" rel="noopener" class="inline-block group">
            <img
              src={`/images/covers/${slug}.jpg`}
              alt={song.album}
              class="w-48 h-48 rounded-lg object-cover border border-[var(--c-border)] group-hover:border-[var(--c-gold)] transition-colors"
              onerror="this.style.display='none'"
            />
            <p class="text-[var(--c-very-dim)] text-xs mt-2">{song.album}</p>
            <p class="text-[var(--c-gold)] text-[10px] mt-0.5 uppercase tracking-widest"><span class="text-[var(--c-very-dim)] normal-case">[PR]</span> Amazon で探す →</p>
          </a>
        </div>
      ) : null}

      {song && (
        <div class="-mt-4 mb-6">
          <MercariCta query={`${song.artists} ${song.album}`} label="中古レコード・CDをメルカリで探す" />
        </div>
      )}

      {youtubeId && (
        <div class="mb-8 aspect-video w-full rounded-lg overflow-hidden">
          <iframe
            id="song-yt-player"
            class="w-full h-full"
            src={`https://www.youtube.com/embed/${youtubeId}?enablejsapi=1&playsinline=1`}
            title={title}
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      )}

      {youtubeShortId && (
        <div class="mb-8">
          <p class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-2">和訳ショート動画</p>
          <div class="flex justify-center">
            <div class="w-[315px] aspect-[9/16] rounded-lg overflow-hidden">
              <iframe
                loading="lazy"
                class="w-full h-full"
                src={`https://www.youtube.com/embed/${youtubeShortId}`}
                title={`${title} 和訳 Shorts`}
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        </div>
      )}

      {sampleYoutubeId && (
        <div class="mb-8">
          <p class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-2">元ネタ</p>
          <div class="aspect-video w-full rounded-lg overflow-hidden">
            <iframe
              loading="lazy"
              class="w-full h-full"
              src={`https://www.youtube.com/embed/${sampleYoutubeId}`}
              title={sampleTitle ?? '元ネタ'}
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      )}

      <!-- Main content slot -->
      <ExplanationToggle />
      <slot />

      <!-- Artist link (mobile only) -->
      {artist && (
        <section class="mb-10 mt-4 lg:hidden">
          <h2 class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-4 border-b border-[var(--c-border)] pb-2">
            アーティストについて
          </h2>
          <a href={`/artists/${artist.slug}`} class="block p-4 bg-[var(--c-surface)] border border-[var(--c-border)] rounded-lg hover:border-[var(--c-gold)] transition-colors group">
            <div class="flex items-center justify-between">
              <div>
                <p class="font-semibold mb-1 group-hover:text-[var(--c-gold)] transition-colors">{artist.name}</p>
                <p class="text-[var(--c-dim)] text-xs">{artist.origin} · {artist.active}</p>
                <p class="text-[var(--c-muted)] text-sm mt-2 leading-relaxed line-clamp-2">{artist.summary}</p>
              </div>
              <span class="text-[var(--c-very-dim)] text-lg ml-4 shrink-0">→</span>
            </div>
          </a>
        </section>
      )}

      <!-- Related songs (mobile only) -->
      {related.length > 0 && (
        <section class="mb-10 lg:hidden">
          <h2 class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-4 border-b border-[var(--c-border)] pb-2">
            この曲とつながる記事
          </h2>
          <ul class="space-y-3">
            {related.map(s => (
              <li>
                <a href={s.slug} class="flex items-center justify-between p-4 bg-[var(--c-surface)] border border-[var(--c-border)] rounded-lg hover:border-[var(--c-gold)] transition-colors">
                  <div>
                    <p class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-0.5">{s.subtitle}</p>
                    <p class="font-semibold">{s.title} 和訳・意味解説</p>
                    <p class="text-[var(--c-dim)] text-xs mt-0.5">{s.artists}・{s.reason}</p>
                  </div>
                  <span class="text-[var(--c-very-dim)] text-lg">→</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- Share -->
      <div class="border-t border-[var(--c-border)] pt-6 flex items-center justify-between flex-wrap gap-4">
        <div class="flex items-center gap-4">
          <a href="/" class="text-xs text-[var(--c-very-dim)] hover:text-[var(--c-gold)] transition-colors uppercase tracking-widest">
            ← WAX&amp;THINK トップへ
          </a>
          <a href="/slang" class="text-xs text-[var(--c-very-dim)] hover:text-[var(--c-gold)] transition-colors uppercase tracking-widest">
            スラング索引 →
          </a>
        </div>
        <div class="flex items-center gap-2">
          <a
            href={`https://x.com/intent/tweet?text=${encodeURIComponent(`${title} | WAX&THINK`)}&url=${encodeURIComponent(`https://waxthink.com/songs/${slug}`)}`}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 text-xs text-[var(--c-very-dim)] hover:text-[var(--c-gold)] transition-colors border border-[var(--c-border)] hover:border-[var(--c-gold)] rounded px-3 py-1.5"
          >
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            X
          </a>
          <button
            id="share-btn"
            class="inline-flex items-center gap-2 text-xs text-[var(--c-very-dim)] hover:text-[var(--c-gold)] transition-colors border border-[var(--c-border)] hover:border-[var(--c-gold)] rounded px-3 py-1.5"
          >
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            <span id="share-label">共有</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Sidebar (desktop only) -->
    <aside class="hidden lg:block lg:sticky lg:top-8 self-start max-h-[calc(100vh-4rem)] overflow-y-auto">
      <div class="space-y-6">

        {highlights && (
          <section class="p-4 border border-[var(--c-gold)]/30 rounded-lg bg-[var(--c-surface)]">
            <p class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-3">この記事の見どころ</p>
            <ol class="space-y-2">
              {highlights.map((h, i) => (
                <li class="flex gap-3 text-sm">
                  <span class="text-[var(--c-gold)] font-black tabular-nums shrink-0">{String(i + 1).padStart(2, '0')}</span>
                  <span class="text-[var(--c-muted)]">{h}</span>
                </li>
              ))}
            </ol>
          </section>
        )}

        {artist && (
          <section>
            <h2 class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-3 border-b border-[var(--c-border)] pb-2">
              アーティストについて
            </h2>
            <a href={`/artists/${artist.slug}`} class="block p-4 bg-[var(--c-surface)] border border-[var(--c-border)] rounded-lg hover:border-[var(--c-gold)] transition-colors group">
              <p class="font-semibold mb-1 group-hover:text-[var(--c-gold)] transition-colors text-sm">{artist.name}</p>
              <p class="text-[var(--c-dim)] text-xs">{artist.origin} · {artist.active}</p>
              <p class="text-[var(--c-muted)] text-xs mt-2 leading-relaxed line-clamp-3">{artist.summary}</p>
              <p class="text-[var(--c-gold)] text-[10px] uppercase tracking-widest mt-2">アーティストページへ →</p>
            </a>
          </section>
        )}

        {related.length > 0 && (
          <section>
            <h2 class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-3 border-b border-[var(--c-border)] pb-2">
              この曲とつながる記事
            </h2>
            <ul class="space-y-2">
              {related.map(s => (
                <li>
                  <a href={s.slug} class="flex items-center justify-between p-3 bg-[var(--c-surface)] border border-[var(--c-border)] rounded-lg hover:border-[var(--c-gold)] transition-colors group">
                    <div>
                      <p class="font-semibold text-sm group-hover:text-[var(--c-gold)] transition-colors">{s.title}</p>
                      <p class="text-[var(--c-dim)] text-xs mt-0.5">{s.artists}・{s.reason}</p>
                    </div>
                    <span class="text-[var(--c-very-dim)] text-sm ml-2 shrink-0">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {relatedColumns.length > 0 && (
          <section>
            <h2 class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-3 border-b border-[var(--c-border)] pb-2">
              関連コラム
            </h2>
            <ul class="space-y-2">
              {relatedColumns.map(c => (
                <li>
                  <a href={c.slug} class="block p-3 bg-[var(--c-surface)] border border-[var(--c-gold)]/30 rounded-lg hover:border-[var(--c-gold)] transition-colors group">
                    <p class="text-[var(--c-gold)] text-[10px] uppercase tracking-widest mb-1">{c.tag}</p>
                    <p class="font-semibold text-sm group-hover:text-[var(--c-gold)] transition-colors leading-snug">{c.title}</p>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

      </div>
    </aside>

  </div>
</Layout>

<script>
  const bar = document.getElementById('progress-bar');
  if (bar) {
    window.addEventListener('scroll', () => {
      const h = document.documentElement;
      const pct = (h.scrollTop / (h.scrollHeight - h.clientHeight)) * 100;
      bar.style.width = pct + '%';
    }, { passive: true });
  }

  const rail = document.getElementById('scrub-rail');
  const thumb = document.getElementById('scrub-thumb');
  const fill = document.getElementById('scrub-fill');
  const railLabel = document.getElementById('scrub-label');
  if (rail && thumb && fill && railLabel) {
    const doc = document.documentElement;
    let thumbH = 0, travel = 0, dragging = false;

    const units = Array.from(document.querySelectorAll('.learning-unit')).map((el) => {
      const h = el.querySelector('h3');
      const name = h ? ((h.querySelector('span')?.textContent || h.textContent || '').trim()) : '';
      return { el, name };
    });

    const measure = () => {
      thumbH = thumb.offsetHeight;
      travel = rail.clientHeight - thumbH;
    };
    const scrollable = () => doc.scrollHeight - doc.clientHeight;

    const sectionNameAt = (scrollTop) => {
      if (!units.length) return '';
      const probe = scrollTop + doc.clientHeight * 0.3;
      let current = units[0].name;
      for (const u of units) {
        if (u.el.offsetTop <= probe) current = u.name; else break;
      }
      return current;
    };

    const place = (y) => {
      thumb.style.top = y + 'px';
      fill.style.height = (y + thumbH / 2) + 'px';
      railLabel.style.top = Math.max(0, Math.min(travel, y)) + 'px';
    };

    const syncFromScroll = () => {
      if (dragging) return;
      const max = scrollable();
      const y = (max > 0 ? doc.scrollTop / max : 0) * travel;
      place(y);
    };

    const setFromY = (rawY) => {
      const y = Math.max(0, Math.min(travel, rawY));
      place(y);
      const target = (travel > 0 ? y / travel : 0) * scrollable();
      window.scrollTo({ top: target });
      railLabel.textContent = sectionNameAt(target);
    };

    const pointerY = (e) => (e.touches && e.touches[0] ? e.touches[0].clientY : e.clientY);
    const onMove = (e) => {
      if (!dragging) return;
      e.preventDefault();
      setFromY(pointerY(e) - rail.getBoundingClientRect().top - thumbH / 2);
    };
    const onUp = () => {
      if (!dragging) return;
      dragging = false;
      railLabel.classList.add('opacity-0');
      thumb.classList.remove('scale-110');
      document.removeEventListener('mousemove', onMove);
      document.removeEventListener('mouseup', onUp);
      document.removeEventListener('touchmove', onMove);
      document.removeEventListener('touchend', onUp);
    };
    const onDown = (e) => {
      dragging = true;
      measure();
      railLabel.classList.remove('opacity-0');
      thumb.classList.add('scale-110');
      onMove(e);
      document.addEventListener('mousemove', onMove);
      document.addEventListener('mouseup', onUp);
      document.addEventListener('touchmove', onMove, { passive: false });
      document.addEventListener('touchend', onUp);
    };

    thumb.addEventListener('mousedown', onDown);
    thumb.addEventListener('touchstart', onDown, { passive: false });

    const showIfNeeded = () => {
      if (scrollable() > 200) {
        rail.style.display = 'flex';
        measure();
        syncFromScroll();
      } else {
        rail.style.display = 'none';
      }
    };

    window.addEventListener('scroll', syncFromScroll, { passive: true });
    window.addEventListener('resize', showIfNeeded);
    window.addEventListener('load', showIfNeeded);
    showIfNeeded();
  }

  const shareBtn = document.getElementById('share-btn');
  const shareLabel = document.getElementById('share-label');
  shareBtn?.addEventListener('click', async () => {
    const url = location.href;
    const title = document.title;
    if (navigator.share) {
      try {
        await navigator.share({ title, url });
      } catch {}
    } else {
      await navigator.clipboard.writeText(url);
      if (shareLabel) {
        shareLabel.textContent = 'コピー済み';
        setTimeout(() => { shareLabel.textContent = '共有'; }, 2000);
      }
    }
  });

  // ── Learning page player bar ──────────────────────────────────────────
  (function () {
    const bar = document.getElementById('learning-player-bar');
    if (!bar) return;

    // Section color palette (matches CSS vars)
    const SECTION_COLORS: Record<string, string> = {
      'verse 1': 'var(--c-section-verse1)',
      'verse 2': 'var(--c-section-verse2)',
      'hook':    'var(--c-section-hook)',
      'bridge':  'var(--c-section-bridge)',
      'intro':   'var(--c-section-intro)',
      'outro':   'var(--c-section-outro)',
    };

    // verse 3/4/5… は2色のオレンジを奇偶で交互に割り当て（番号無制限）
    function sectionColorKey(section: string): string {
      const m = section.match(/^verse\s*(\d+)/i);
      if (m) return parseInt(m[1], 10) % 2 === 1 ? 'verse 1' : 'verse 2';
      return section;
    }
    function sectionLabelOf(section: string): string {
      const m = section.match(/^verse\s*(\d+)/i);
      if (m) return 'Verse ' + m[1];
      return section.charAt(0).toUpperCase() + section.slice(1);
    }

    // Collect learning units + 非表示の時間軸マーカー（[data-player-marker]）。
    // マーカーは解説カードを持たず、セクション帯/シークの区切りだけを担う。
    const unitEls = [
      ...document.querySelectorAll<HTMLElement>('.learning-unit[data-t]'),
      ...document.querySelectorAll<HTMLElement>('[data-player-marker][data-t]'),
    ];
    const units = unitEls
      .map(el => ({
        el,
        t: parseFloat(el.dataset.t ?? '0'),
        mc: el.dataset.mc ?? '',
      }))
      .filter(u => !isNaN(u.t))
      .sort((a, b) => a.t - b.t);

    if (units.length === 0) return;

    // Show bar
    bar.style.display = 'flex';
    bar.style.flexDirection = 'column';

    const bandEl      = document.getElementById('player-section-band')!;
    const stripEl     = document.getElementById('player-section-strip')!;
    const durEl       = document.getElementById('player-duration');
    const seekwaveEl  = document.getElementById('player-seekwave')!;
    const timeEl      = document.getElementById('player-time')!;
    const playBtn     = document.getElementById('player-playpause')!;
    const iconPlay    = document.getElementById('player-icon-play')!;
    const iconPause   = document.getElementById('player-icon-pause')!;
    const followBtn   = document.getElementById('player-follow')!;
    const followArrow = document.getElementById('player-follow-arrow')!;
    const followText  = document.getElementById('player-follow-text')!;
    const segFixed    = document.getElementById('sync-fixed') as HTMLButtonElement | null;
    const segFollow   = document.getElementById('sync-follow') as HTMLButtonElement | null;

    let autoFollow = false;
    // セグメント表示を現在状態に同期（固定＝中立ハイライト / 連動＝緑で「追従中」を明示）
    function renderSyncSeg() {
      if (segFixed) {
        segFixed.style.background = !autoFollow ? 'rgba(255,255,255,.14)' : 'transparent';
        segFixed.style.color = !autoFollow ? '#fff' : 'var(--c-dim)';
        segFixed.setAttribute('aria-pressed', String(!autoFollow));
      }
      if (segFollow) {
        segFollow.style.background = autoFollow ? 'var(--c-green)' : 'transparent';
        segFollow.style.color = autoFollow ? '#0d0d0d' : 'var(--c-dim)';
        segFollow.setAttribute('aria-pressed', String(autoFollow));
      }
    }
    renderSyncSeg();
    segFixed?.addEventListener('click', () => {
      if (!autoFollow) return;
      autoFollow = false;
      renderSyncSeg();
    });
    segFollow?.addEventListener('click', () => {
      if (autoFollow) return;
      autoFollow = true;
      renderSyncSeg();
      if (currentPlayingEl) scrollToUnit(currentPlayingEl);
    });

    // 再生速度（速いラップの聞き取り用スロー）。実音源はgetCurrentTime基準なので同期は自動。
    // モバイル：循環ボタン(#player-speed) / 広い画面：全段セグメント(#player-speed-seg)。状態は共有。
    const speedBtn  = document.getElementById('player-speed') as HTMLButtonElement | null;
    const speedSeg  = document.getElementById('player-speed-seg');
    const segRateBtns = speedSeg ? Array.from(speedSeg.querySelectorAll<HTMLButtonElement>('button[data-rate]')) : [];
    const RATES = [1, 0.75, 0.5];
    let rateIdx = 0;
    function applyRate() {
      const r = RATES[rateIdx];
      const slowed = r !== 1;
      if (ytReady && ytPlayer?.setPlaybackRate) ytPlayer.setPlaybackRate(r);
      // 循環ボタン（モバイル）
      if (speedBtn) {
        speedBtn.textContent = r + '×';
        speedBtn.style.background = slowed ? 'var(--c-gold)' : 'transparent';
        speedBtn.style.color = slowed ? '#0d0d0d' : 'var(--c-dim)';
        speedBtn.style.borderColor = slowed ? 'var(--c-gold)' : 'var(--c-border)';
      }
      // セグメント（広い画面）
      for (const b of segRateBtns) {
        const active = parseFloat(b.dataset.rate ?? '') === r;
        b.style.background = active ? 'var(--c-gold)' : 'transparent';
        b.style.color = active ? '#0d0d0d' : 'var(--c-dim)';
        b.setAttribute('aria-pressed', String(active));
      }
    }
    speedBtn?.addEventListener('click', () => {
      rateIdx = (rateIdx + 1) % RATES.length;
      applyRate();
    });
    for (const b of segRateBtns) {
      b.addEventListener('click', () => {
        const idx = RATES.indexOf(parseFloat(b.dataset.rate ?? ''));
        if (idx < 0 || idx === rateIdx) return;
        rateIdx = idx;
        applyRate();
      });
    }

    // 下スクロール中はサイトヘッダーを退避し、プレーヤーバーを最上部へ詰める。
    // 上スクロール／最上部付近ではヘッダーを戻す（モバイルの占有面積を削減）。
    (function () {
      const header = document.querySelector<HTMLElement>('header');
      if (!header) return;
      header.style.transition = 'transform .25s ease';
      bar.style.transition = 'top .25s ease';
      let lastY = window.scrollY;
      const setHidden = (hide: boolean) => {
        header.style.transform = hide ? 'translateY(-100%)' : '';
        bar.style.top = hide ? '0px' : '';
      };
      window.addEventListener('scroll', () => {
        const y = window.scrollY;
        if (y < 80) setHidden(false);
        else if (y > lastY + 4) setHidden(true);
        else if (y < lastY - 4) setHidden(false);
        lastY = y;
      }, { passive: true });
    })();

    // 固定プレーヤーバーの高さぶんオフセットしてカードを画面内に収めるスクロール
    // （バーの下端基準。ヘッダー退避でバー位置が変わっても追従する）
    function barOffset() { return bar.getBoundingClientRect().bottom + 12; }
    function scrollToUnit(el: HTMLElement) {
      const y = el.getBoundingClientRect().top + window.scrollY - barOffset();
      window.scrollTo({ top: y, behavior: 'smooth' });
    }
    function isUnitInView(el: HTMLElement) {
      const r = el.getBoundingClientRect();
      return r.top < window.innerHeight * 0.85 && r.bottom > barOffset();
    }

    // いま鳴っている学習カード（マーカー区間ではnull）
    let currentPlayingEl: HTMLElement | null = null;
    // 受動再生中で再生カードが画面外の時だけ誘導チップを出す。読書中は邪魔しない。
    function updateFollowChip() {
      if (!playing || !currentPlayingEl || isUnitInView(currentPlayingEl)) {
        followBtn.style.display = 'none';
        return;
      }
      const r = currentPlayingEl.getBoundingClientRect();
      followArrow.textContent = r.top < barOffset() ? '↑' : '↓';
      const h = currentPlayingEl.querySelector('h3 span')?.textContent?.trim() ?? '';
      followText.textContent = h;
      followBtn.style.display = 'flex';
    }
    followBtn.addEventListener('click', () => {
      if (currentPlayingEl) scrollToUnit(currentPlayingEl);
      followBtn.style.display = 'none';
    });

    let playing = false;
    let elapsed = 0;
    let lastTick = 0;
    let rafId = 0;
    // 実曲長(data-duration)があればそれを総尺に。無ければ最終ユニット+30秒。
    const durAttr = parseFloat(bar.dataset.duration ?? '');
    const DURATION = !isNaN(durAttr) && durAttr > units[units.length - 1].t
      ? durAttr
      : units[units.length - 1].t + 30;
    // PVイントロ映像がmp3と頭出しがズレる曲用。初回再生時のみここへシークする。
    const ytStartAttr = parseFloat(bar.dataset.ytStart ?? '');
    const YT_START = !isNaN(ytStartAttr) && ytStartAttr > 0 ? ytStartAttr : null;
    let hasSeekedToStart = false;
    if (durEl) durEl.textContent = '/ ' + toMMSS(DURATION);

    // ── YouTube IFrame Player API（公式PVを実音源として再生・無料/キー不要）──
    // 既存のページ内PV埋め込み(#song-yt-player)をAPI制御。実 currentTime で
    // ハイライトを駆動する（タイムスタンプはPV基準なのでオフセット補正不要）。
    // APIが読めない/動画が無い場合は従来のサイレント時間軸にフォールバック。
    let ytPlayer: any = null;
    let ytReady = false;
    // 速度コントロールの初期表示（ここでytReady宣言後に呼ぶ＝TDZ回避。PV無しページでも初期化される）
    applyRate();
    let pendingPlay = false;  // 準備完了前に押された再生意図を保持
    let pendingSeek: number | null = null;  // 準備完了前に押された頭出し先（秒）
    const ytIframe = document.getElementById('song-yt-player');
    if (ytIframe && (window as any).YT === undefined) {
      const s = document.createElement('script');
      s.src = 'https://www.youtube.com/iframe_api';
      document.head.appendChild(s);
    }
    function initYT() {
      if (!ytIframe || !(window as any).YT?.Player) return;
      ytPlayer = new (window as any).YT.Player('song-yt-player', {
        events: {
          onReady: () => {
            ytReady = true;
            applyRate();
            if (pendingSeek != null) { ytPlayer.seekTo(pendingSeek, true); pendingSeek = null; }
            if (pendingPlay) { pendingPlay = false; ytPlayer.playVideo(); }
          },
          onStateChange: (e: any) => {
            const YTNS = (window as any).YT;
            if (e.data === YTNS.PlayerState.PLAYING) setPlaying(true);
            else if (e.data === YTNS.PlayerState.PAUSED || e.data === YTNS.PlayerState.ENDED) setPlaying(false);
          },
        },
      });
    }
    if (ytIframe) {
      if ((window as any).YT?.Player) initYT();
      else {
        const prev = (window as any).onYouTubeIframeAPIReady;
        (window as any).onYouTubeIframeAPIReady = () => { prev?.(); initYT(); };
      }
    }

    function toMMSS(s: number) {
      const m = Math.floor(s / 60);
      return `${m}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
    }

    function getSectionForMc(mc: string): string {
      const lc = mc.toLowerCase();
      const vm = lc.match(/verse\s*(\d+)/);
      if (vm) return 'verse ' + vm[1];
      if (lc.includes('verse') && lc.includes('raekwon')) return 'verse 1';
      if (lc.includes('verse') && lc.includes('inspectah')) return 'verse 2';
      if (lc.includes('hook')) return 'hook';
      if (lc.includes('bridge')) return 'bridge';
      if (lc.includes('outro')) return 'outro';
      return 'intro';
    }

    // Build section boundaries from units
    // Each boundary: { section, startT, firstUnit }
    type SectionBoundary = { section: string; startT: number; firstUnit: typeof units[0] };
    const sectionBoundaries: SectionBoundary[] = [];
    for (const u of units) {
      const sec = getSectionForMc(u.mc);
      const last = sectionBoundaries[sectionBoundaries.length - 1];
      if (!last || last.section !== sec) {
        sectionBoundaries.push({ section: sec, startT: u.t, firstUnit: u });
      }
    }

    // Compute section strip segments (proportional widths)
    if (sectionBoundaries.length > 0) {
      // Add intro segment if first unit doesn't start at 0
      const segments: Array<{ section: string; startT: number; endT: number; firstUnit: typeof units[0] | null }> = [];
      if (sectionBoundaries[0].startT > 0) {
        segments.push({ section: 'intro', startT: 0, endT: sectionBoundaries[0].startT, firstUnit: null });
      }
      for (let i = 0; i < sectionBoundaries.length; i++) {
        const startT = sectionBoundaries[i].startT;
        const endT = i + 1 < sectionBoundaries.length ? sectionBoundaries[i + 1].startT : DURATION;
        segments.push({ section: sectionBoundaries[i].section, startT, endT, firstUnit: sectionBoundaries[i].firstUnit });
      }

      for (const seg of segments) {
        const width = ((seg.endT - seg.startT) / DURATION * 100).toFixed(2) + '%';
        const color = SECTION_COLORS[sectionColorKey(seg.section)] ?? 'var(--c-section-intro)';
        const label = sectionLabelOf(seg.section);
        const btn = document.createElement('button');
        btn.style.cssText = `width:${width};background:${color};opacity:0.45;border:none;padding:0;height:100%;font-size:9px;color:#fff;overflow:hidden;white-space:nowrap;position:relative;transition:opacity 0.2s,box-shadow 0.2s`;
        btn.textContent = label;
        btn.title = label;
        btn.dataset.startT = String(seg.startT);
        btn.addEventListener('mouseenter', () => { btn.style.opacity = '0.9'; });
        btn.addEventListener('mouseleave', () => { btn.style.opacity = activeStripBtn === btn ? '1' : '0.45'; });
        btn.addEventListener('click', () => {
          // Jump to section start time
          elapsed = seg.startT;
          hasSeekedToStart = true;
          if (ytReady && ytPlayer?.seekTo) ytPlayer.seekTo(elapsed, true);
          updateSeekwave(elapsed);
          timeEl.textContent = toMMSS(elapsed);
          followBtn.style.display = 'none';
          // Scroll to first unit of this section（固定バーぶんオフセット）
          if (seg.firstUnit) scrollToUnit(seg.firstUnit.el);
          updateActiveStrip(elapsed);
        });
        stripEl.appendChild(btn);
      }
      stripEl.style.display = 'flex';
    }

    let activeStripBtn: HTMLElement | null = null;
    function updateActiveStrip(t: number) {
      const btns = Array.from(stripEl.querySelectorAll<HTMLElement>('button'));
      let newActive: HTMLElement | null = null;
      for (const btn of btns) {
        const startT = parseFloat(btn.dataset.startT ?? '0');
        if (startT <= t) newActive = btn;
        else break;
      }
      if (newActive !== activeStripBtn) {
        if (activeStripBtn) {
          activeStripBtn.style.opacity = '0.45';
          activeStripBtn.style.fontWeight = '400';
          activeStripBtn.style.boxShadow = 'none';
          activeStripBtn.style.zIndex = '0';
        }
        if (newActive) {
          newActive.style.opacity = '1';
          newActive.style.fontWeight = '800';
          // 内側リング＋外側グローで「点灯」感を出す
          newActive.style.boxShadow = 'inset 0 0 0 1.5px rgba(255,255,255,.6), 0 0 10px rgba(255,255,255,.25)';
          newActive.style.zIndex = '1';
        }
        activeStripBtn = newActive;
      }
    }

    function getActiveUnit(t: number) {
      let active = null;
      for (const u of units) {
        if (u.t <= t) active = u;
        else break;
      }
      return active;
    }

    // ── Seekwave ──────────────────────────────────────────────────────────
    const N_BARS = 80;
    const barHeights: number[] = [];
    // 実曲の事前計算波形（data-peaks）。無ければシード乱数でSerato風にフォールバック。
    let realPeaks: number[] | null = null;
    try {
      const raw = bar.dataset.peaks;
      if (raw) {
        const parsed = JSON.parse(raw);
        if (Array.isArray(parsed) && parsed.length === N_BARS) realPeaks = parsed;
      }
    } catch { /* ignore */ }
    let rngSeed = 42;
    function rng() {
      rngSeed = (rngSeed * 1664525 + 1013904223) & 0xffffffff;
      return (rngSeed >>> 0) / 0xffffffff;
    }
    for (let i = 0; i < N_BARS; i++) {
      if (realPeaks) {
        barHeights.push(Math.max(0.12, Math.min(1.0, realPeaks[i])));
      } else {
        const wave = Math.sin(i * 0.35) * 0.25 + 0.55;
        barHeights.push(Math.max(0.15, Math.min(1.0, wave + rng() * 0.4 - 0.1)));
      }
    }

    // セクション単位の配色（明るいパレット。CSS変数 --c-section-* を解決）
    const rootStyle = getComputedStyle(document.documentElement);
    const SECTION_VAR_MAP: Record<string, string> = {
      'verse 1': '--c-section-verse1',
      'verse 2': '--c-section-verse2',
      'hook':    '--c-section-hook',
      'bridge':  '--c-section-bridge',
      'intro':   '--c-section-intro',
      'outro':   '--c-section-outro',
    };
    function getResolvedSectionColor(section: string): string {
      return rootStyle.getPropertyValue(SECTION_VAR_MAP[sectionColorKey(section)] ?? '--c-section-intro').trim() || '#94a3b8';
    }
    function getBarSection(barIdx: number): string {
      const t = (barIdx / N_BARS) * DURATION;
      let sec = 'intro';
      for (const b of sectionBoundaries) {
        if (b.startT <= t) sec = b.section;
        else break;
      }
      return sec;
    }
    const barBaseColors: string[] = [];
    for (let i = 0; i < N_BARS; i++) barBaseColors.push(getResolvedSectionColor(getBarSection(i)));

    const seekBars: HTMLElement[] = [];
    for (let i = 0; i < N_BARS; i++) {
      const div = document.createElement('div');
      const h = Math.round(barHeights[i] * 24);
      div.style.cssText = `flex:1 1 0;min-width:1px;height:${h}px;border-radius:1px;background:${barBaseColors[i]};opacity:0.4;transition:opacity 0.1s,box-shadow 0.1s`;
      seekwaveEl.appendChild(div);
      seekBars.push(div);
    }

    function updateSeekwave(t: number) {
      const currentBar = Math.floor((t / DURATION) * N_BARS);
      for (let i = 0; i < N_BARS; i++) {
        const el = seekBars[i];
        if (i === currentBar) {
          el.style.background = '#ffffff';
          el.style.boxShadow = '0 0 9px #ffffff, 0 0 3px #ffffff';
          el.style.opacity = '1';
        } else if (i < currentBar) {
          el.style.background = barBaseColors[i];
          el.style.boxShadow = `0 0 6px ${barBaseColors[i]}`;
          el.style.opacity = '1';
        } else {
          el.style.background = barBaseColors[i];
          el.style.boxShadow = 'none';
          el.style.opacity = '0.4';
        }
      }
    }

    function handleSeek(clientX: number) {
      const rect = seekwaveEl.getBoundingClientRect();
      const pct = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
      elapsed = pct * DURATION;
      hasSeekedToStart = true;
      if (ytReady && ytPlayer?.seekTo) ytPlayer.seekTo(elapsed, true);
      render(elapsed, true);
    }

    seekwaveEl.addEventListener('click', (e: MouseEvent) => handleSeek(e.clientX));

    // ── Long-press magnifier loupe（モバイルの精密シーク）───────────────────
    // 細い波形バーはピンポイント位置に合わせづらいので、長押しで拡大ルーペを出し、
    // 指の移動量を拡大率で割って1秒単位で微調整できるようにする（iOSの虫眼鏡風）。
    const loupeEl     = document.getElementById('seek-loupe');
    const loupeCanvas = document.getElementById('seek-loupe-canvas') as HTMLCanvasElement | null;
    const loupeTime   = document.getElementById('seek-loupe-time');
    const lctx = loupeCanvas?.getContext('2d') ?? null;
    const LOUPE_PX_PER_SEC = 16;   // 拡大密度（=移動感度。16px動かすと1秒ぶん動く）
    const LP_W = 204, LP_H = 64, LP_DPR = 2;

    seekwaveEl.style.touchAction = 'none';
    (seekwaveEl.style as any).webkitUserSelect = 'none';
    (seekwaveEl.style as any).webkitTouchCallout = 'none';
    seekwaveEl.style.userSelect = 'none';

    function drawLoupe(t: number) {
      if (!lctx) return;
      lctx.setTransform(LP_DPR, 0, 0, LP_DPR, 0, 0);
      lctx.clearRect(0, 0, LP_W, LP_H);
      const cx = LP_W / 2;
      const barSec = DURATION / N_BARS;
      const bw = Math.max(1.5, barSec * LOUPE_PX_PER_SEC - 1);
      for (let i = 0; i < N_BARS; i++) {
        const barT = (i + 0.5) * barSec;
        const x = cx + (barT - t) * LOUPE_PX_PER_SEC;
        if (x < -bw || x > LP_W + bw) continue;
        const h = Math.max(3, barHeights[i] * (LP_H - 16));
        lctx.globalAlpha = barT <= t ? 0.95 : 0.4;
        lctx.fillStyle = barBaseColors[i];
        lctx.fillRect(x - bw / 2, (LP_H - h) / 2, bw, h);
      }
      // 中央プレイヘッド（白いクロスヘア）
      lctx.globalAlpha = 1;
      lctx.fillStyle = '#ffffff';
      lctx.shadowColor = '#ffffff';
      lctx.shadowBlur = 6;
      lctx.fillRect(cx - 1, 4, 2, LP_H - 8);
      lctx.shadowBlur = 0;
      if (loupeTime) loupeTime.textContent = toMMSS(t);
    }

    function positionLoupe(clientX: number) {
      if (!loupeEl) return;
      const rect = seekwaveEl.getBoundingClientRect();
      const x = Math.max(rect.left, Math.min(rect.right, clientX));
      const half = LP_W / 2 + 6;
      const left = Math.max(half, Math.min(window.innerWidth - half, x));
      loupeEl.style.left = left + 'px';
      loupeEl.style.top = (rect.bottom + 14) + 'px';  // 指の下＝波形の直下に出す
    }

    // 精密モード中はスクロールを起こさず視覚と音源だけ追従（多数の微移動でページが暴れないように）
    function previewSeek(t: number) {
      elapsed = Math.max(0, Math.min(t, DURATION));
      hasSeekedToStart = true;
      if (ytReady && ytPlayer?.seekTo) ytPlayer.seekTo(elapsed, true);
      updateSeekwave(elapsed);
      timeEl.textContent = toMMSS(elapsed);
    }

    let lpTimer: number | null = null;
    let lpActive = false, lpMoved = false, lpAnchorX = 0, lpAnchorT = 0;

    function enterLoupe(clientX: number) {
      lpActive = true;
      lpAnchorX = clientX;
      lpAnchorT = elapsed;
      if (loupeEl) {
        loupeEl.style.display = 'block';
        positionLoupe(clientX);
        drawLoupe(elapsed);
        requestAnimationFrame(() => {
          loupeEl.style.opacity = '1';
          loupeEl.style.transform = 'translateX(-50%) scale(1)';
        });
      }
      if ((navigator as any).vibrate) { try { (navigator as any).vibrate(12); } catch { /* noop */ } }
    }

    function exitLoupe() {
      if (lpTimer != null) { clearTimeout(lpTimer); lpTimer = null; }
      const wasActive = lpActive;
      if (wasActive && loupeEl) {
        loupeEl.style.opacity = '0';
        loupeEl.style.transform = 'translateX(-50%) scale(.85)';
        setTimeout(() => { if (!lpActive && loupeEl) loupeEl.style.display = 'none'; }, 130);
      }
      lpActive = false;
      lpMoved = false;
      if (wasActive) render(elapsed, true);  // 着地点へ最終スクロール
    }

    seekwaveEl.addEventListener('touchstart', (e: TouchEvent) => {
      const tch = e.touches[0];
      if (!tch) return;
      e.preventDefault();
      lpMoved = false;
      handleSeek(tch.clientX);  // 即時のcoarseシーク（従来のタップ挙動）
      if (lpTimer != null) clearTimeout(lpTimer);
      const sx = tch.clientX;
      lpTimer = window.setTimeout(() => {
        lpTimer = null;
        if (!lpMoved) enterLoupe(sx);
      }, 300);
    }, { passive: false });

    seekwaveEl.addEventListener('touchmove', (e: TouchEvent) => {
      const tch = e.touches[0];
      if (!tch) return;
      e.preventDefault();
      if (lpActive) {
        const nt = lpAnchorT + (tch.clientX - lpAnchorX) / LOUPE_PX_PER_SEC;
        previewSeek(nt);
        positionLoupe(tch.clientX);
        drawLoupe(elapsed);
      } else {
        lpMoved = true;
        if (lpTimer != null) { clearTimeout(lpTimer); lpTimer = null; }
        handleSeek(tch.clientX);  // 長押し前の移動は通常ドラッグ（coarse）
      }
    }, { passive: false });

    const onSeekEnd = (e: TouchEvent) => { if (lpActive) e.preventDefault(); exitLoupe(); };
    seekwaveEl.addEventListener('touchend', onSeekEnd, { passive: false });
    seekwaveEl.addEventListener('touchcancel', onSeekEnd, { passive: false });

    // 各ユニットの▶ボタン: 上部プレーヤーを該当秒へジャンプ＋再生。
    // YTプレーヤーがある場合はYouTube遷移を抑止して内部シーク。無ければ素のリンク動作にフォールバック。
    document.addEventListener('click', (e: MouseEvent) => {
      const link = (e.target as HTMLElement)?.closest('[data-seek]') as HTMLElement | null;
      if (!link || !ytIframe) return;  // 動画なし＝従来どおりリンクで開く
      const sec = parseFloat(link.getAttribute('data-seek') ?? '');
      if (isNaN(sec)) return;
      e.preventDefault();
      elapsed = Math.min(sec, DURATION);
      hasSeekedToStart = true;
      if (ytReady && ytPlayer?.seekTo) {
        ytPlayer.seekTo(sec, true);
        ytPlayer.playVideo();
      } else {
        // API準備前: 頭出し先と再生意図をキュー
        pendingSeek = sec;
        pendingPlay = true;
        iconPlay.style.display = 'none';
        iconPause.style.display = 'block';
      }
      render(elapsed, true);
    });

    // 現在時刻 t に対する見た目（時間表示・波形・ハイライト・帯）を更新
    // userSeek=true（バー/帯を能動的にタップ）なら該当カードへ即スクロール。
    // 受動再生（loop）では autoFollow ON=ユニット切替時に自動スクロール、OFF=誘導チップのみ。
    let lastScrolledUnit: HTMLElement | null = null;
    function render(t: number, userSeek = false) {
      timeEl.textContent = toMMSS(t);
      updateSeekwave(t);
      const active = getActiveUnit(t);
      document.querySelectorAll<HTMLElement>('.learning-unit').forEach(el => el.classList.remove('playing'));
      currentPlayingEl = null;
      if (active) {
        active.el.classList.add('playing');
        if (active.el.classList.contains('learning-unit')) currentPlayingEl = active.el;
        const section = getSectionForMc(active.mc);
        bandEl.style.background = SECTION_COLORS[sectionColorKey(section)] ?? 'var(--c-section-intro)';
      } else {
        // Intro等・まだユニットが始まっていない区間は帯をintro色に
        bandEl.style.background = SECTION_COLORS['intro'] ?? 'var(--c-section-intro)';
      }
      // 帯のライトアップはactiveユニット有無に関係なく毎回更新（Introも点灯させる）
      updateActiveStrip(t);
      if (userSeek) {
        followBtn.style.display = 'none';
        lastScrolledUnit = currentPlayingEl;
        if (currentPlayingEl) scrollToUnit(currentPlayingEl);
      } else if (autoFollow && currentPlayingEl && currentPlayingEl !== lastScrolledUnit) {
        lastScrolledUnit = currentPlayingEl;
        followBtn.style.display = 'none';
        scrollToUnit(currentPlayingEl);
      } else {
        updateFollowChip();
      }
    }

    function loop(ts: number) {
      if (!playing) return;
      if (ytReady && ytPlayer?.getCurrentTime) {
        // 実音源の再生位置を正とする（ハイライト同期）
        elapsed = Math.min(ytPlayer.getCurrentTime(), DURATION);
      } else {
        // フォールバック: サイレントに時間を進める
        const dt = lastTick ? (ts - lastTick) / 1000 : 0;
        elapsed = Math.min(elapsed + dt, DURATION);
      }
      lastTick = ts;
      render(elapsed);
      if (!ytReady && elapsed >= DURATION) { setPlaying(false); return; }
      rafId = requestAnimationFrame(loop);
    }

    // 再生状態の単一の出入口。YT再生時は onStateChange からも呼ばれる。
    function setPlaying(p: boolean) {
      if (p === playing) return;
      playing = p;
      iconPlay.style.display = p ? 'none' : 'block';
      iconPause.style.display = p ? 'block' : 'none';
      if (p) { lastTick = 0; rafId = requestAnimationFrame(loop); }
      else { cancelAnimationFrame(rafId); updateFollowChip(); }
    }

    playBtn.addEventListener('click', () => {
      if (ytIframe) {
        // PVがある＝実音源で再生。状態は onStateChange→setPlaying で反映。
        if (ytReady && ytPlayer) {
          if (playing) ytPlayer.pauseVideo();
          else {
            // 初回再生のみ: PVイントロ映像(ヘリの音等)を飛ばして実曲の始まりへシーク
            if (YT_START != null && !hasSeekedToStart) {
              hasSeekedToStart = true;
              const ct = ytPlayer.getCurrentTime ? ytPlayer.getCurrentTime() : 0;
              if (ct < YT_START) ytPlayer.seekTo(YT_START, true);
            }
            ytPlayer.playVideo();
          }
        } else {
          // API準備前: 再生意図をキューしてアイコンだけ先に切り替える
          if (YT_START != null && !hasSeekedToStart) {
            hasSeekedToStart = true;
            pendingSeek = YT_START;
          }
          pendingPlay = !pendingPlay;
          iconPlay.style.display = pendingPlay ? 'none' : 'block';
          iconPause.style.display = pendingPlay ? 'block' : 'none';
        }
      } else {
        // 動画なしのページのみ従来のサイレント時間軸
        setPlaying(!playing);
      }
    });

    // Add bottom padding so content isn't hidden behind bar
    document.body.style.paddingBottom = '72px';
  })();
</script>
