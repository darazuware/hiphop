---
import Layout from './Layout.astro';
import ExplanationToggle from '../components/ExplanationToggle.astro';
import { songs } from '../data/songs';
import { artists } from '../data/artists';
import { columns } from '../data/columns';

interface Props {
  title: string;
  description: string;
  slug: string;
  highlights?: [string, string, string];
  youtubeId?: string;
  sampleYoutubeId?: string;
  sampleTitle?: string;
  youtubeShortId?: string;
  noindex?: boolean;
  learningPage?: boolean;
}

const { title, description, slug, highlights, youtubeId, sampleYoutubeId, sampleTitle, youtubeShortId, noindex = false, learningPage = false } = Astro.props;

const song = songs.find(s => s.slug === `/songs/${slug}`);
const artist = song ? artists.find(a => a.slug === song.artistSlug) : null;
// H1 is the human-readable article heading, decoupled from the SEO <title> prop
const h1 = song ? `${song.title} — ${song.artists} 和訳・スラング解説` : title;
// 更新日メカニズム: データに updatedDate があれば表示（遡及入力は不要・任意）
const updatedDate = (song as { updatedDate?: string } | undefined)?.updatedDate ?? null;
const releaseYear = song?.subtitle.match(/·\s*(\d{4})/)?.[1] ?? null;
const related = song
  ? songs.filter(s => s.artistSlug === song.artistSlug && s.slug !== song.slug && s.tier === 'core').slice(0, 3)
  : [];
const relatedColumns = song
  ? columns.filter(c => c.relatedSongs.includes(song.slug))
  : [];
---

<Layout title={title} description={description} ogType="article" publishedTime={song?.pubDate} modifiedTime={updatedDate ?? undefined} noindex={noindex}>
  <!-- Progress bar -->
  <div id="progress-bar" class="fixed top-0 left-0 h-0.5 bg-[var(--c-gold)] z-50 transition-none" style="width:0%"></div>

  <!-- Fixed player bar (learning pages only) -->
  {learningPage && (
    <div id="learning-player-bar" class="fixed top-0 left-0 right-0 z-50 flex flex-col" style="display:none">
      <!-- Main bar -->
      <div class="flex items-center gap-3 px-4 py-2 bg-[#0d0d0d]/95 backdrop-blur-md border-b border-[var(--c-border)]">
        <!-- Play/pause -->
        <button id="player-playpause" aria-label="再生/停止" class="shrink-0 text-[var(--c-orange)] hover:text-[var(--c-gold)] transition-colors text-lg leading-none">▶</button>
        <!-- Section label -->
        <span id="player-section-label" class="text-[10px] uppercase tracking-widest text-[var(--c-dim)] shrink-0 min-w-[52px]">—</span>
        <!-- Seekwave -->
        <div id="player-seekwave" class="flex-1 h-5 flex items-end gap-[1px] cursor-pointer overflow-hidden" style="min-width:0"></div>
        <!-- Time -->
        <span id="player-time" class="text-[10px] font-mono text-[var(--c-dim)] shrink-0">0:00</span>
      </div>
      <!-- Section jump strip (populated by JS) -->
      <div id="player-section-strip" class="flex h-5 w-full cursor-pointer overflow-hidden" style="display:none"></div>
      <!-- Section color band (current section indicator) -->
      <div id="player-section-band" class="h-1 w-full transition-colors duration-500" style="background:var(--c-section-intro)"></div>
    </div>
  )}

  <!-- Scroll to top (mobile only) -->
  <button
    id="back-to-top"
    aria-label="ページ先頭へ"
    class={`lg:hidden fixed bottom-20 right-4 z-40 w-12 h-12 rounded-full bg-[var(--c-surface)] border border-[var(--c-gold)]/60 text-[var(--c-gold)] text-lg flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300 shadow-md`}
  >↑</button>

  <!-- Scroll to bottom (mobile only) -->
  <button
    id="to-bottom"
    aria-label="ページ末尾へ"
    class={`lg:hidden fixed bottom-36 right-4 z-40 w-12 h-12 rounded-full bg-[var(--c-surface)] border border-[var(--c-gold)]/60 text-[var(--c-gold)] text-lg flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300 shadow-md`}
  >↓</button>

  <!-- Floating explanation toggle (always visible) -->
  <div id="exp-float" class={`fixed bottom-6 right-4 z-40 flex rounded-full overflow-hidden border border-[var(--c-border)] bg-[var(--c-surface)]/90 backdrop-blur-sm shadow-lg font-mono text-[10px]`}>
    <button data-e="tap" class="exp-btn exp-float-btn px-3 py-2 transition-colors">タップ</button>
    <button data-e="always" class="exp-btn exp-float-btn px-3 py-2 transition-colors border-l border-[var(--c-border)]">常時</button>
  </div>

  <div class={`max-w-5xl mx-auto px-4 py-8 lg:grid lg:grid-cols-[1fr_260px] lg:gap-12 lg:items-start${learningPage ? ' pt-16' : ''}`}>

    <!-- Main column -->
    <div>
      <!-- Header -->
      <header class="mb-8">
        <h1 class="text-2xl md:text-3xl font-bold leading-tight mb-4">{h1}</h1>
        {song?.pubDate && (
          <time datetime={song.pubDate} class="block text-[var(--c-very-dim)] text-xs mb-1">
            公開: {new Date(song.pubDate).toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        )}
        {updatedDate && (
          <time datetime={updatedDate} class="block text-[var(--c-very-dim)] text-xs mb-4">
            更新: {new Date(updatedDate).toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        )}
        {song && (
          <dl class="grid grid-cols-2 gap-x-4 gap-y-1 text-xs text-[var(--c-muted)] border border-[var(--c-border)] rounded-lg p-4 bg-[var(--c-surface)]">
            <dt class="text-[var(--c-very-dim)] uppercase tracking-widest">アーティスト</dt>
            <dd>
              {artist
                ? <a href={`/artists/${song.artistSlug}`} class="hover:text-[var(--c-gold)] transition-colors underline underline-offset-2">{song.artists}</a>
                : song.artists
              }
            </dd>
            {releaseYear && <>
              <dt class="text-[var(--c-very-dim)] uppercase tracking-widest">リリース年</dt>
              <dd>{releaseYear}</dd>
            </>}
            <dt class="text-[var(--c-very-dim)] uppercase tracking-widest">プロデューサー</dt>
            <dd>{song.producer === 'その他' ? song.subtitle.split(' Produced')[0].split(' Remix')[0] : song.producer}</dd>
            <dt class="text-[var(--c-very-dim)] uppercase tracking-widest">収録アルバム</dt>
            <dd>{song.album}</dd>
            <dt class="text-[var(--c-very-dim)] uppercase tracking-widest">エリア</dt>
            <dd>{song.region}</dd>
            <dt class="text-[var(--c-very-dim)] uppercase tracking-widest">BPM</dt>
            <dd>{song.bpm}</dd>
            {song.sample && <>
              <dt class="text-[var(--c-very-dim)] uppercase tracking-widest">サンプル元</dt>
              <dd class="col-span-1 truncate">{song.sample}</dd>
            </>}
          </dl>
        )}
      </header>

      <!-- Highlights (mobile only) -->
      {highlights && (
        <section class="mb-8 p-4 border border-[var(--c-gold)]/30 rounded-lg bg-[var(--c-surface)] lg:hidden">
          <p class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-3">この記事の見どころ</p>
          <ol class="space-y-2">
            {highlights.map((h, i) => (
              <li class="flex gap-3 text-sm">
                <span class="text-[var(--c-gold)] font-black tabular-nums shrink-0">{String(i + 1).padStart(2, '0')}</span>
                <span class="text-[var(--c-muted)]">{h}</span>
              </li>
            ))}
          </ol>
        </section>
      )}

      <!-- Album cover + purchase links -->
      {song?.asin ? (
        <div class="mb-6">
          <a href={`https://www.amazon.co.jp/dp/${song.asin}/?tag=wax1124-22`} target="_blank" rel="noopener" class="inline-block group">
            <img
              src={`/images/covers/${slug}.jpg`}
              alt={song.album}
              class="w-48 h-48 rounded-lg object-cover border border-[var(--c-border)] group-hover:border-[var(--c-gold)] transition-colors"
              onerror={`this.onerror=null;this.src='https://m.media-amazon.com/images/P/${song.asin}.01._SCLZZZZZZZ_.jpg'`}
            />
            <p class="text-[var(--c-very-dim)] text-xs mt-2">{song.album}</p>
            <p class="text-[var(--c-gold)] text-[10px] mt-0.5 uppercase tracking-widest"><span class="text-[var(--c-very-dim)] normal-case">[PR]</span> Amazon で購入 →</p>
          </a>
          <a
            href={`https://music.apple.com/jp/search?term=${encodeURIComponent(song.artists + ' ' + song.title)}`}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1.5 mt-2 text-[10px] uppercase tracking-widest text-[var(--c-very-dim)] hover:text-white transition-colors"
          >
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M23.994 6.124a9.23 9.23 0 0 0-.24-2.19c-.317-1.31-1.064-2.31-2.18-3.043a6.33 6.33 0 0 0-1.769-.75c-.55-.135-1.11-.2-1.675-.21-.024 0-.051-.013-.077-.013H5.947c-.026 0-.053.013-.077.013-.565.01-1.124.075-1.674.21a6.33 6.33 0 0 0-1.769.75C1.31 1.624.563 2.624.246 3.934a9.23 9.23 0 0 0-.24 2.19C.002 6.24 0 6.356 0 6.472v11.056c0 .116.002.232.006.348a9.23 9.23 0 0 0 .24 2.19c.317 1.31 1.064 2.31 2.18 3.043a6.33 6.33 0 0 0 1.769.75c.55.135 1.11.2 1.675.21.024 0 .051.013.077.013h12.106c.026 0 .053-.013.077-.013.565-.01 1.124-.075 1.674-.21a6.33 6.33 0 0 0 1.769-.75c1.116-.733 1.863-1.733 2.18-3.043a9.23 9.23 0 0 0 .24-2.19c.004-.116.006-.232.006-.348V6.472c0-.116-.002-.232-.006-.348zM15.9 7.2v1.5h-4.8V18h-1.8V8.7H4.5V7.2h11.4z"/></svg>
            Apple Music で聴く →
          </a>
        </div>
      ) : song ? (
        <div class="mb-6">
          <a href={`https://www.amazon.co.jp/s?k=${encodeURIComponent(song.artists + ' ' + song.album)}&i=music&tag=wax1124-22`} target="_blank" rel="noopener" class="inline-block group">
            <img
              src={`/images/covers/${slug}.jpg`}
              alt={song.album}
              class="w-48 h-48 rounded-lg object-cover border border-[var(--c-border)] group-hover:border-[var(--c-gold)] transition-colors"
              onerror="this.style.display='none'"
            />
            <p class="text-[var(--c-very-dim)] text-xs mt-2">{song.album}</p>
            <p class="text-[var(--c-gold)] text-[10px] mt-0.5 uppercase tracking-widest"><span class="text-[var(--c-very-dim)] normal-case">[PR]</span> Amazon で探す →</p>
          </a>
        </div>
      ) : null}

      {youtubeId && (
        <div class="mb-8 aspect-video w-full rounded-lg overflow-hidden">
          <iframe
            loading="lazy"
            class="w-full h-full"
            src={`https://www.youtube.com/embed/${youtubeId}`}
            title={title}
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      )}

      {youtubeShortId && (
        <div class="mb-8">
          <p class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-2">和訳ショート動画</p>
          <div class="flex justify-center">
            <div class="w-[315px] aspect-[9/16] rounded-lg overflow-hidden">
              <iframe
                loading="lazy"
                class="w-full h-full"
                src={`https://www.youtube.com/embed/${youtubeShortId}`}
                title={`${title} 和訳 Shorts`}
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        </div>
      )}

      {sampleYoutubeId && (
        <div class="mb-8">
          <p class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-2">元ネタ</p>
          <div class="aspect-video w-full rounded-lg overflow-hidden">
            <iframe
              loading="lazy"
              class="w-full h-full"
              src={`https://www.youtube.com/embed/${sampleYoutubeId}`}
              title={sampleTitle ?? '元ネタ'}
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      )}

      <!-- Main content slot -->
      <ExplanationToggle />
      <slot />

      <!-- Artist link (mobile only) -->
      {artist && (
        <section class="mb-10 mt-4 lg:hidden">
          <h2 class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-4 border-b border-[var(--c-border)] pb-2">
            アーティストについて
          </h2>
          <a href={`/artists/${artist.slug}`} class="block p-4 bg-[var(--c-surface)] border border-[var(--c-border)] rounded-lg hover:border-[var(--c-gold)] transition-colors group">
            <div class="flex items-center justify-between">
              <div>
                <p class="font-semibold mb-1 group-hover:text-[var(--c-gold)] transition-colors">{artist.name}</p>
                <p class="text-[var(--c-dim)] text-xs">{artist.origin} · {artist.active}</p>
                <p class="text-[var(--c-muted)] text-sm mt-2 leading-relaxed line-clamp-2">{artist.summary}</p>
              </div>
              <span class="text-[var(--c-very-dim)] text-lg ml-4 shrink-0">→</span>
            </div>
          </a>
        </section>
      )}

      <!-- Related songs (mobile only) -->
      {related.length > 0 && (
        <section class="mb-10 lg:hidden">
          <h2 class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-4 border-b border-[var(--c-border)] pb-2">
            同アーティストの記事
          </h2>
          <ul class="space-y-3">
            {related.map(s => (
              <li>
                <a href={s.slug} class="flex items-center justify-between p-4 bg-[var(--c-surface)] border border-[var(--c-border)] rounded-lg hover:border-[var(--c-gold)] transition-colors">
                  <div>
                    <p class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-0.5">{s.subtitle}</p>
                    <p class="font-semibold">{s.title} 和訳・意味解説</p>
                    <p class="text-[var(--c-dim)] text-xs mt-0.5">{s.artists}</p>
                  </div>
                  <span class="text-[var(--c-very-dim)] text-lg">→</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- Share -->
      <div class="border-t border-[var(--c-border)] pt-6 flex items-center justify-between flex-wrap gap-4">
        <div class="flex items-center gap-4">
          <a href="/" class="text-xs text-[var(--c-very-dim)] hover:text-[var(--c-gold)] transition-colors uppercase tracking-widest">
            ← WAX&amp;THINK トップへ
          </a>
          <a href="/slang" class="text-xs text-[var(--c-very-dim)] hover:text-[var(--c-gold)] transition-colors uppercase tracking-widest">
            スラング索引 →
          </a>
        </div>
        <div class="flex items-center gap-2">
          <a
            href={`https://x.com/intent/tweet?text=${encodeURIComponent(`${title} | WAX&THINK`)}&url=${encodeURIComponent(`https://waxthink.com/songs/${slug}`)}`}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 text-xs text-[var(--c-very-dim)] hover:text-[var(--c-gold)] transition-colors border border-[var(--c-border)] hover:border-[var(--c-gold)] rounded px-3 py-1.5"
          >
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            X
          </a>
          <button
            id="share-btn"
            class="inline-flex items-center gap-2 text-xs text-[var(--c-very-dim)] hover:text-[var(--c-gold)] transition-colors border border-[var(--c-border)] hover:border-[var(--c-gold)] rounded px-3 py-1.5"
          >
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            <span id="share-label">共有</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Sidebar (desktop only) -->
    <aside class="hidden lg:block">
      <div class="sticky top-8 space-y-6">

        {highlights && (
          <section class="p-4 border border-[var(--c-gold)]/30 rounded-lg bg-[var(--c-surface)]">
            <p class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-3">この記事の見どころ</p>
            <ol class="space-y-2">
              {highlights.map((h, i) => (
                <li class="flex gap-3 text-sm">
                  <span class="text-[var(--c-gold)] font-black tabular-nums shrink-0">{String(i + 1).padStart(2, '0')}</span>
                  <span class="text-[var(--c-muted)]">{h}</span>
                </li>
              ))}
            </ol>
          </section>
        )}

        {artist && (
          <section>
            <h2 class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-3 border-b border-[var(--c-border)] pb-2">
              アーティストについて
            </h2>
            <a href={`/artists/${artist.slug}`} class="block p-4 bg-[var(--c-surface)] border border-[var(--c-border)] rounded-lg hover:border-[var(--c-gold)] transition-colors group">
              <p class="font-semibold mb-1 group-hover:text-[var(--c-gold)] transition-colors text-sm">{artist.name}</p>
              <p class="text-[var(--c-dim)] text-xs">{artist.origin} · {artist.active}</p>
              <p class="text-[var(--c-muted)] text-xs mt-2 leading-relaxed line-clamp-3">{artist.summary}</p>
              <p class="text-[var(--c-gold)] text-[10px] uppercase tracking-widest mt-2">アーティストページへ →</p>
            </a>
          </section>
        )}

        {related.length > 0 && (
          <section>
            <h2 class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-3 border-b border-[var(--c-border)] pb-2">
              同アーティストの記事
            </h2>
            <ul class="space-y-2">
              {related.map(s => (
                <li>
                  <a href={s.slug} class="flex items-center justify-between p-3 bg-[var(--c-surface)] border border-[var(--c-border)] rounded-lg hover:border-[var(--c-gold)] transition-colors group">
                    <div>
                      <p class="font-semibold text-sm group-hover:text-[var(--c-gold)] transition-colors">{s.title}</p>
                      <p class="text-[var(--c-dim)] text-xs mt-0.5">{s.artists}</p>
                    </div>
                    <span class="text-[var(--c-very-dim)] text-sm ml-2 shrink-0">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {relatedColumns.length > 0 && (
          <section>
            <h2 class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-3 border-b border-[var(--c-border)] pb-2">
              関連コラム
            </h2>
            <ul class="space-y-2">
              {relatedColumns.map(c => (
                <li>
                  <a href={c.slug} class="block p-3 bg-[var(--c-surface)] border border-[var(--c-gold)]/30 rounded-lg hover:border-[var(--c-gold)] transition-colors group">
                    <p class="text-[var(--c-gold)] text-[10px] uppercase tracking-widest mb-1">{c.tag}</p>
                    <p class="font-semibold text-sm group-hover:text-[var(--c-gold)] transition-colors leading-snug">{c.title}</p>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

      </div>
    </aside>

  </div>
</Layout>

<script>
  const bar = document.getElementById('progress-bar');
  if (bar) {
    window.addEventListener('scroll', () => {
      const h = document.documentElement;
      const pct = (h.scrollTop / (h.scrollHeight - h.clientHeight)) * 100;
      bar.style.width = pct + '%';
    }, { passive: true });
  }

  const topBtn = document.getElementById('back-to-top');
  if (topBtn) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 300) {
        topBtn.classList.remove('opacity-0', 'pointer-events-none');
      } else {
        topBtn.classList.add('opacity-0', 'pointer-events-none');
      }
    }, { passive: true });
    topBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  const bottomBtn = document.getElementById('to-bottom');
  if (bottomBtn) {
    const updateBottom = () => {
      const h = document.documentElement;
      const nearBottom = h.scrollTop + h.clientHeight >= h.scrollHeight - 300;
      if (nearBottom) {
        bottomBtn.classList.add('opacity-0', 'pointer-events-none');
      } else {
        bottomBtn.classList.remove('opacity-0', 'pointer-events-none');
      }
    };
    window.addEventListener('scroll', updateBottom, { passive: true });
    updateBottom();
    bottomBtn.addEventListener('click', () => {
      window.scrollTo({ top: document.documentElement.scrollHeight, behavior: 'smooth' });
    });
  }

  const shareBtn = document.getElementById('share-btn');
  const shareLabel = document.getElementById('share-label');
  shareBtn?.addEventListener('click', async () => {
    const url = location.href;
    const title = document.title;
    if (navigator.share) {
      try {
        await navigator.share({ title, url });
      } catch {}
    } else {
      await navigator.clipboard.writeText(url);
      if (shareLabel) {
        shareLabel.textContent = 'コピー済み';
        setTimeout(() => { shareLabel.textContent = '共有'; }, 2000);
      }
    }
  });

  // ── Learning page player bar ──────────────────────────────────────────
  (function () {
    const bar = document.getElementById('learning-player-bar');
    if (!bar) return;

    // Section color palette (matches CSS vars)
    const SECTION_COLORS: Record<string, string> = {
      'verse 1': 'var(--c-section-verse1)',
      'verse 2': 'var(--c-section-verse2)',
      'hook':    'var(--c-section-hook)',
      'bridge':  'var(--c-section-bridge)',
      'intro':   'var(--c-section-intro)',
      'outro':   'var(--c-section-outro)',
    };

    // Collect learning units with data-t
    const units = Array.from(document.querySelectorAll<HTMLElement>('.learning-unit[data-t]'))
      .map(el => ({
        el,
        t: parseFloat(el.dataset.t ?? '0'),
        mc: el.dataset.mc ?? '',
      }))
      .filter(u => !isNaN(u.t))
      .sort((a, b) => a.t - b.t);

    if (units.length === 0) return;

    // Show bar
    bar.style.display = 'flex';
    bar.style.flexDirection = 'column';

    const bandEl      = document.getElementById('player-section-band')!;
    const stripEl     = document.getElementById('player-section-strip')!;
    const labelEl     = document.getElementById('player-section-label')!;
    const seekwaveEl  = document.getElementById('player-seekwave')!;
    const timeEl      = document.getElementById('player-time')!;
    const playBtn     = document.getElementById('player-playpause')!;

    let playing = false;
    let elapsed = 0;
    let lastTick = 0;
    let rafId = 0;
    const DURATION = units[units.length - 1].t + 30;

    function toMMSS(s: number) {
      const m = Math.floor(s / 60);
      return `${m}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
    }

    function getSectionForMc(mc: string): string {
      const lc = mc.toLowerCase();
      if (lc.includes('verse 1') || (lc.includes('verse') && lc.includes('raekwon'))) return 'verse 1';
      if (lc.includes('verse 2') || (lc.includes('verse') && lc.includes('inspectah'))) return 'verse 2';
      if (lc.includes('hook')) return 'hook';
      if (lc.includes('bridge')) return 'bridge';
      return 'intro';
    }

    // Build section boundaries from units
    // Each boundary: { section, startT, firstUnit }
    type SectionBoundary = { section: string; startT: number; firstUnit: typeof units[0] };
    const sectionBoundaries: SectionBoundary[] = [];
    for (const u of units) {
      const sec = getSectionForMc(u.mc);
      const last = sectionBoundaries[sectionBoundaries.length - 1];
      if (!last || last.section !== sec) {
        sectionBoundaries.push({ section: sec, startT: u.t, firstUnit: u });
      }
    }

    // Compute section strip segments (proportional widths)
    if (sectionBoundaries.length > 0) {
      // Add intro segment if first unit doesn't start at 0
      const segments: Array<{ section: string; startT: number; endT: number; firstUnit: typeof units[0] | null }> = [];
      if (sectionBoundaries[0].startT > 0) {
        segments.push({ section: 'intro', startT: 0, endT: sectionBoundaries[0].startT, firstUnit: null });
      }
      for (let i = 0; i < sectionBoundaries.length; i++) {
        const startT = sectionBoundaries[i].startT;
        const endT = i + 1 < sectionBoundaries.length ? sectionBoundaries[i + 1].startT : DURATION;
        segments.push({ section: sectionBoundaries[i].section, startT, endT, firstUnit: sectionBoundaries[i].firstUnit });
      }

      const SECTION_LABELS: Record<string, string> = {
        'intro': 'Intro', 'verse 1': 'Verse 1', 'verse 2': 'Verse 2',
        'hook': 'Hook', 'bridge': 'Bridge', 'outro': 'Outro',
      };

      for (const seg of segments) {
        const width = ((seg.endT - seg.startT) / DURATION * 100).toFixed(2) + '%';
        const color = SECTION_COLORS[seg.section] ?? 'var(--c-section-intro)';
        const btn = document.createElement('button');
        btn.style.cssText = `width:${width};background:${color};opacity:0.55;border:none;padding:0;height:100%;font-size:9px;color:#fff;overflow:hidden;white-space:nowrap;transition:opacity 0.2s`;
        btn.textContent = SECTION_LABELS[seg.section] ?? seg.section;
        btn.title = SECTION_LABELS[seg.section] ?? seg.section;
        btn.dataset.startT = String(seg.startT);
        btn.addEventListener('mouseenter', () => { btn.style.opacity = '0.9'; });
        btn.addEventListener('mouseleave', () => { btn.style.opacity = activeStripBtn === btn ? '1' : '0.55'; });
        btn.addEventListener('click', () => {
          // Jump to section start time
          elapsed = seg.startT;
          timeEl.textContent = toMMSS(elapsed);
          progressEl.style.width = ((elapsed / DURATION) * 100).toFixed(2) + '%';
          // Scroll to first unit of this section
          if (seg.firstUnit) {
            seg.firstUnit.el.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
          updateActiveStrip(elapsed);
        });
        stripEl.appendChild(btn);
      }
      stripEl.style.display = 'flex';
    }

    let activeStripBtn: HTMLElement | null = null;
    function updateActiveStrip(t: number) {
      const btns = Array.from(stripEl.querySelectorAll<HTMLElement>('button'));
      let newActive: HTMLElement | null = null;
      for (const btn of btns) {
        const startT = parseFloat(btn.dataset.startT ?? '0');
        if (startT <= t) newActive = btn;
        else break;
      }
      if (newActive !== activeStripBtn) {
        if (activeStripBtn) activeStripBtn.style.opacity = '0.55';
        if (newActive) newActive.style.opacity = '1';
        activeStripBtn = newActive;
      }
    }

    function getActiveUnit(t: number) {
      let active = null;
      for (const u of units) {
        if (u.t <= t) active = u;
        else break;
      }
      return active;
    }

    // ── Seekwave ──────────────────────────────────────────────────────────
    const N_BARS = 80;
    const barHeights: number[] = [];
    // Pseudo-random waveform heights (seeded for consistency)
    let rngSeed = 42;
    function rng() {
      rngSeed = (rngSeed * 1664525 + 1013904223) & 0xffffffff;
      return (rngSeed >>> 0) / 0xffffffff;
    }
    for (let i = 0; i < N_BARS; i++) {
      const wave = Math.sin(i * 0.35) * 0.25 + 0.55;
      barHeights.push(Math.max(0.15, Math.min(1.0, wave + rng() * 0.4 - 0.1)));
    }

    const seekBars: HTMLElement[] = [];
    for (let i = 0; i < N_BARS; i++) {
      const div = document.createElement('div');
      const h = Math.round(barHeights[i] * 20);
      div.style.cssText = `width:2px;height:${h}px;border-radius:1px;flex-shrink:0;background:#1e1e1e`;
      seekwaveEl.appendChild(div);
      seekBars.push(div);
    }

    // Resolve CSS section color vars to actual color strings
    const rootStyle = getComputedStyle(document.documentElement);
    const SECTION_VAR_MAP: Record<string, string> = {
      'verse 1': '--c-section-verse1',
      'verse 2': '--c-section-verse2',
      'hook':    '--c-section-hook',
      'bridge':  '--c-section-bridge',
      'intro':   '--c-section-intro',
      'outro':   '--c-section-outro',
    };
    function getResolvedSectionColor(section: string): string {
      return rootStyle.getPropertyValue(SECTION_VAR_MAP[section] ?? '--c-section-intro').trim() || '#2a2a2a';
    }

    // Precompute which section each bar belongs to
    function getBarSection(barIdx: number): string {
      const t = (barIdx / N_BARS) * DURATION;
      let sec = 'intro';
      for (const b of sectionBoundaries) {
        if (b.startT <= t) sec = b.section;
        else break;
      }
      return sec;
    }

    const barSectionColors: string[] = seekBars.map((_, i) => getResolvedSectionColor(getBarSection(i)));

    function updateSeekwave(t: number) {
      const currentBar = Math.floor((t / DURATION) * N_BARS);
      for (let i = 0; i < N_BARS; i++) {
        if (i === currentBar) {
          seekBars[i].style.background = '#FF4D00';
        } else if (i < currentBar) {
          seekBars[i].style.background = barSectionColors[i];
        } else {
          seekBars[i].style.background = '#1e1e1e';
        }
      }
    }

    function handleSeek(clientX: number) {
      const rect = seekwaveEl.getBoundingClientRect();
      const pct = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
      elapsed = pct * DURATION;
      timeEl.textContent = toMMSS(elapsed);
      updateSeekwave(elapsed);
      updateActiveStrip(elapsed);
    }

    seekwaveEl.addEventListener('click', (e: MouseEvent) => handleSeek(e.clientX));
    seekwaveEl.addEventListener('touchstart', (e: TouchEvent) => {
      e.preventDefault();
      if (e.touches[0]) handleSeek(e.touches[0].clientX);
    }, { passive: false });

    function tick(ts: number) {
      if (!playing) return;
      const dt = lastTick ? (ts - lastTick) / 1000 : 0;
      lastTick = ts;
      elapsed = Math.min(elapsed + dt, DURATION);

      // Update time
      timeEl.textContent = toMMSS(elapsed);

      // Update seekwave
      updateSeekwave(elapsed);

      // Update active card + section
      const active = getActiveUnit(elapsed);
      document.querySelectorAll<HTMLElement>('.learning-unit').forEach(el => el.classList.remove('playing'));
      if (active) {
        active.el.classList.add('playing');
        const section = getSectionForMc(active.mc);
        bandEl.style.background = SECTION_COLORS[section] ?? 'var(--c-section-intro)';
        labelEl.textContent = section.toUpperCase();
        updateActiveStrip(elapsed);
        // Scroll card into view softly
        active.el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      if (elapsed < DURATION) {
        rafId = requestAnimationFrame(tick);
      } else {
        playing = false;
        playBtn.textContent = '▶';
      }
    }

    playBtn.addEventListener('click', () => {
      playing = !playing;
      playBtn.textContent = playing ? '⏸' : '▶';
      if (playing) {
        lastTick = 0;
        rafId = requestAnimationFrame(tick);
      } else {
        cancelAnimationFrame(rafId);
      }
    });

    // Add bottom padding so content isn't hidden behind bar
    document.body.style.paddingBottom = '72px';
  })();
</script>
