---
/**
 * 学習解説主体ページの中核ユニット。
 * 「学ぶ表現」を見出しに立て、MC担当＋PVタイムスタンプ・最小引用＋和訳・独自解説を束ねる。
 * 英語原文(eng)は解説の用例断片のみ（1〜2行厳守）。解説(slot)がコンテンツの主役。
 *
 * スロット:
 *   default     … 独自解説（主役）
 *   eng / jpn   … 用例断片の最小引用と和訳
 *   usage       … 語法（どう使うか）の日本語解説（任意・本文扱いで[C]独自性に加算）
 *
 * embed prop … 公式埋め込み（YouTube/Instagram/X）のURL。空なら何も描画しない。
 *              画像のダウンロード再ホストはせず、公式埋め込みのみ。
 */
import SocialEmbed from "./SocialEmbed.astro";

interface Props {
  heading: string;        // 学ぶ表現（見出し）
  mc?: string;            // MC担当（誰のVerse/Hookか）
  t?: number | null;      // PVタイムスタンプ（秒）。nullなら非表示
  youtubeId?: string;     // 動画ID（t=秒リンク用）
  tApprox?: boolean;      // 秒数が推定値の場合true（「≈」表示）
  label?: string;         // バッジ（例: ★ トリプルミーニング）
  eng?: string;           // 用例断片（最小引用）
  jpn?: string;           // 和訳
  embed?: string;         // 公式埋め込みURL（任意・空なら非表示）
  embedCaption?: string;  // 埋め込みのキャプション（任意）
}
const { heading, mc, t = null, youtubeId, tApprox = false, label, eng, jpn, embed, embedCaption } = Astro.props;
const mmss = t != null ? `${Math.floor(t / 60)}:${String(Math.floor(t % 60)).padStart(2, "0")}` : null;
const ytUrl = t != null && youtubeId ? `https://www.youtube.com/watch?v=${youtubeId}&t=${Math.floor(t)}s` : null;
const hasUsage = Astro.slots.has("usage");
const isKey = label?.includes('最重要');
// Split heading into expression (big) and explanation (normal) at "—"
const dashIdx = heading.indexOf('—');
const headingMain = dashIdx >= 0 ? heading.slice(0, dashIdx).trim() : heading;
const headingSub = dashIdx >= 0 ? '— ' + heading.slice(dashIdx + 1).trim() : '';
// Ghost text: first meaningful word of heading for background display
const ghostWord = heading.split(/[—\s]/)[0].slice(0, 6).toUpperCase();
---

<style>
  .learning-unit.playing {
    box-shadow:
      0 0 0 2px var(--c-green),
      0 0 30px 10px var(--c-green-glow),
      0 0 60px 20px rgba(0, 255, 100, 0.3),
      0 0 100px 40px rgba(0, 255, 100, 0.15);
  }
</style>

<section
  class={`learning-unit relative mb-8 overflow-hidden border-2 border-[var(--c-card-border)] bg-[var(--c-card-bg)] px-5 pt-4 pb-5 transition-all duration-300${isKey ? ' key' : ''}`}
  style="border-radius:0"
  data-t={t != null ? t : undefined}
  data-mc={mc ?? ''}
>
  <!-- Ghost typography background -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute right-[-0.1em] top-[-0.1em] select-none font-black leading-none text-[var(--c-orange)] opacity-[0.04] z-0"
    style="font-size:clamp(4rem,18vw,9rem);letter-spacing:-0.04em;line-height:1"
  >{ghostWord}</div>

  <!-- Key badge (top-right corner) -->
  {isKey && (
    <div class="absolute top-0 right-0 z-20 flex items-center gap-1 bg-[#FF4D00] px-2 py-0.5 text-black text-[10px] font-bold uppercase tracking-widest leading-none" style="border-radius:0 0 0 4px">
      ★ 聴きどころ
    </div>
  )}

  <!-- Content above ghost -->
  <div class="relative z-10">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-2">
      <h3 class="text-[var(--c-text)]">
        <span class="block text-[clamp(1.8rem,5vw,2.4rem)] font-black uppercase tracking-tight" style="font-family:'Impact','Anton',system-ui,sans-serif;line-height:1.1">{headingMain}</span>
        {headingSub && <span class="block text-lg font-semibold mt-1">{headingSub}</span>}
      </h3>
      {label && !isKey && (
        <span class="text-[var(--c-orange)] text-xs font-bold uppercase tracking-widest opacity-90">{label}</span>
      )}
    </div>

    {(mc || mmss) && (
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mb-3 text-xs text-[var(--c-dim)]">
        {mc && (
          <span class="inline-flex items-center gap-1">
            <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <rect x="3" y="1" width="4" height="6" rx="2"/>
              <path d="M1.5 6.5C1.5 8 3 9 5 9s3.5-1 3.5-2.5"/>
              <line x1="5" y1="9" x2="5" y2="10"/>
            </svg>
            <span class="text-[var(--c-muted)]">{mc}</span>
          </span>
        )}
        {mmss && (
          ytUrl ? (
            <a
              href={ytUrl}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 font-mono text-black bg-[#FF4D00] hover:bg-[var(--c-green)] transition-colors px-3 py-1.5 text-sm font-black tracking-wide"
              style="border-radius:3px"
            >
              <svg width="12" height="12" viewBox="0 0 8 8" fill="currentColor" aria-hidden="true"><polygon points="1,0 8,4 1,8"/></svg>
              {tApprox ? "≈" : ""}{mmss}
            </a>
          ) : (
            <span class="inline-flex items-center gap-1 font-mono text-[var(--c-dim)] border border-[var(--c-border)] px-2 py-0.5 text-[11px]" style="border-radius:2px">
              <svg width="8" height="8" viewBox="0 0 8 8" fill="currentColor" aria-hidden="true"><polygon points="1,0 8,4 1,8"/></svg>
              {tApprox ? "≈" : ""}{mmss}
            </span>
          )
        )}
      </div>
    )}

    {(eng || jpn) && (
      <blockquote class="my-3 pl-4" style="border-left:3px solid var(--c-orange)">
        {eng && (
          <p
            class="text-[var(--c-text)] text-base leading-relaxed"
            style="background:rgba(0,232,75,0.06);padding:0.25rem 0.5rem;margin-left:-0.5rem"
          >
            <slot name="eng">{eng}</slot>
          </p>
        )}
        {jpn && <p class="text-[var(--c-muted)] text-sm leading-relaxed italic mt-1 ml-0"><slot name="jpn">{jpn}</slot></p>}
      </blockquote>
    )}

    <div class="text-[var(--c-muted)] text-sm leading-relaxed space-y-3">
      <slot />
    </div>

    {hasUsage && (
      <details class="mt-4 group">
        <summary class="cursor-pointer list-none flex items-center gap-2 text-[var(--c-orange)] text-[11px] font-bold uppercase tracking-widest select-none hover:text-[var(--c-green)] transition-colors">
          <span class="border border-[var(--c-orange)] px-2 py-0.5 group-open:border-[var(--c-green)] group-open:text-[var(--c-green)] transition-colors" style="border-radius:0">
            語法 — どう使うか ▼
          </span>
        </summary>
        <div class="mt-3 border border-[var(--c-border)] bg-[var(--c-surface)] px-4 py-3" style="border-left:2px solid var(--c-orange);border-radius:0">
          <div class="text-[var(--c-muted)] text-sm leading-relaxed space-y-2">
            <slot name="usage" />
          </div>
        </div>
      </details>
    )}

    {embed && <SocialEmbed url={embed} caption={embedCaption} />}
  </div>
</section>
