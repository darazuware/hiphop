---
// メルカリアフィリエイトCTA（共通コンポーネント）。
// タグ(afid)は本コンポーネントで集中管理し、ページに生のmercari URLを直書きしない。
// 通常は検索案内。ユーザー指定の出品がある場合はhref/coverで商品写真付き直リンクを表示する。
// 3本柱（アルバム名・曲名・アーティスト名）で検索角度を変え、ヒット率を最大化する。
interface Item {
  href?: string; // ユーザー指定の発行済み出品URL（afid保持）
  cover?: string; // 当該出品ページで確認した商品写真
  query: string; // 検索キーワード
  label: string; // ボタン表示名（実名を出して埋没させない）
}
interface Props {
  items: Item[];
  heading?: string;
  position?: string;
}
const { items, heading = "メルカリで探す", position = "article-commerce" } = Astro.props as Props;
const AFID = "3150124771";
const hrefFor = (q: string) => `https://jp.mercari.com/search?keyword=${encodeURIComponent(q)}&afid=${AFID}`;
---

<section class="mb-8 p-4 bg-[var(--c-surface)] border border-[var(--c-gold)]/30 rounded-lg">
  <p class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-3">
    <span class="text-[var(--c-very-dim)] normal-case">[PR]</span> {heading}
  </p>
  <div class="flex flex-wrap gap-2">
    {items.map((item, index) => (
      <a
        href={item.href ?? hrefFor(item.query)}
        target="_blank"
        rel="noopener sponsored nofollow"
        data-affiliate-merchant="mercari"
        data-affiliate-item={item.query}
        data-affiliate-position={item.href ? `${position}-${index + 1}` : position}
        class:list={["inline-flex items-center gap-1.5 border border-[var(--c-gold)]/60 text-[var(--c-gold)] text-sm font-semibold px-4 py-2.5 rounded-lg hover:bg-[var(--c-gold)] hover:text-black transition-colors", item.cover && "w-full min-w-0"]}
      >
        {item.cover && <img src={item.cover} alt={item.query} width="72" height="72" loading="lazy" class="w-[72px] h-[72px] object-contain shrink-0" />}
        {item.cover ? <span class="min-w-0 break-words">{item.label} →</span> : `${item.label} →`}
      </a>
    ))}
  </div>
</section>
