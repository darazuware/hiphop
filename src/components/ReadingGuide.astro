---
import '@fontsource/inter/800-italic.css';
---
<nav class="reading-guide" aria-label="現在の読書位置">
  <div><span id="reading-kind">記事本体</span><strong id="reading-location">目次</strong></div>
  <a href="#article-toc">目次 ↑</a>
</nav>
<style is:global>
  [data-guided-reading] .reading-guide { position:sticky; top:148px; z-index:25; display:flex; align-items:center; justify-content:space-between; gap:.75rem; padding:.65rem .8rem; margin-bottom:1.5rem; border:1px solid var(--c-border); border-left:4px solid var(--c-gold); border-radius:.4rem; background:var(--c-bg); font-size:.75rem; }
  [data-guided-reading] .reading-guide div { min-width:0; }
  [data-guided-reading] #reading-kind { display:block; color:var(--c-gold); font-size:.65rem; }
  [data-guided-reading] #reading-location { display:block; overflow-wrap:anywhere; line-height:1.5; }
  [data-guided-reading] .reading-guide a { flex-shrink:0; padding:.4rem; color:var(--c-gold); }
  [data-guided-reading] .learning-unit h3 > span:first-child { font-family:'Inter','Hiragino Sans','Yu Gothic',sans-serif !important; font-weight:800; font-style:italic; text-transform:none; overflow-wrap:anywhere; }
  [data-guided-reading] .reader-block { margin:1rem 0; padding:.75rem; border:1px solid var(--c-border); border-left:4px solid var(--c-gold); border-radius:.5rem; background:var(--c-surface); }
  [data-guided-reading] .reader-block[data-reading-kind="PR"] { border-left-color:var(--c-dim); border-style:dashed; }
  [data-guided-reading] .reader-block[data-reading-kind="関連記事"] { border-left-color:var(--c-orange); }
  [data-guided-reading] .reader-block-label { margin:0 0 .75rem; color:var(--c-dim); font-size:.7rem; font-weight:700; letter-spacing:.04em; }
  [data-guided-reading] .reader-block > .release-reference { margin:0; padding:0; border:0; background:transparent; }
  [data-guided-reading] #song-reading-body > section { border-top:3px solid var(--c-gold); padding-top:1.25rem; }
  [data-guided-reading] .reader-section-label { display:block; color:var(--c-dim); font-size:.7rem; margin-bottom:.6rem; }
  [data-guided-reading] [id^="point-"] { scroll-margin-top:240px; }
  [data-guided-reading] a:focus-visible { outline:2px solid var(--c-gold); outline-offset:3px; }
  [data-guided-reading] .commerce-pair { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:1rem; }
  [data-guided-reading] .commerce-pair > div { min-width:0; }
  [data-guided-reading] .commerce-pair .release-reference { margin:0; padding:0; border:0; background:transparent; grid-template-columns:64px minmax(0,1fr); gap:.5rem; }
  [data-guided-reading] .commerce-pair .release-reference img { width:64px; height:64px; }
  [data-guided-reading] .commerce-pair .release-reference .release-links { margin-top:.4rem; }
  [data-guided-reading] .commerce-mercari > section { margin:0; padding:0 0 0 .75rem; border:0; border-left:1px solid var(--c-border); border-radius:0; background:transparent; }
  [data-guided-reading] .commerce-mercari > section > p { margin-bottom:.5rem; letter-spacing:0; line-height:1.5; }
  [data-guided-reading] .commerce-mercari a { padding:.5rem; font-size:.8rem; }
  @media(max-width:520px) {
    [data-guided-reading] .commerce-pair { gap:.5rem; }
    [data-guided-reading] .commerce-pair .release-reference { grid-template-columns:44px minmax(0,1fr); gap:.4rem; font-size:.75rem; }
    [data-guided-reading] .commerce-pair .release-reference img { width:44px; height:44px; }
    [data-guided-reading] .commerce-pair .release-artist, [data-guided-reading] .commerce-pair .release-record { font-size:.65rem; }
    [data-guided-reading] .commerce-mercari > section { padding-left:.5rem; }
    [data-guided-reading] .commerce-mercari a { font-size:.75rem; }
  }
</style>
<script>
  const root = document.querySelector<HTMLElement>('[data-guided-reading]');
  if (root) {
    const bar = root.querySelector<HTMLElement>('.reading-guide')!;
    const kind = root.querySelector<HTMLElement>('#reading-kind')!;
    const location = root.querySelector<HTMLElement>('#reading-location')!;
    const units = [...root.querySelectorAll<HTMLElement>('[id^="point-"]')].filter(el => el.querySelector('.learning-unit'));
    const major = [...root.querySelectorAll<HTMLElement>('[data-reading-section]')];
    const inserts = [...root.querySelectorAll<HTMLElement>('.reader-block')];
    const visible = (el: HTMLElement) => el.getClientRects().length > 0;
    const update = () => {
      const line = bar.getBoundingClientRect().bottom + 40;
      const containsLine = (el: HTMLElement) => { const r = el.getBoundingClientRect(); return visible(el) && r.top <= line && r.bottom > line; };
      const section = major.filter(el => visible(el) && el.getBoundingClientRect().top <= line).at(-1);
      const unit = units.find(containsLine);
      const insert = inserts.find(containsLine);
      kind.textContent = insert?.dataset.readingKind ?? section?.dataset.readingKind ?? '記事本体';
      location.textContent = insert?.dataset.readingSection ?? (unit ? `学ぶ表現 ${units.indexOf(unit) + 1} / ${units.length} · ${root.querySelector(`a[href="#${unit.id}"]`)?.textContent?.replace(/^\d+\.\s*/, '') ?? ''}` : section?.dataset.readingSection ?? '目次');
      root.querySelectorAll<HTMLAnchorElement>('#article-toc a').forEach(a => {
        if (section && a.hash === `#${section.id}`) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      });
    };
    let queued = false;
    const schedule = () => { if (queued) return; queued = true; requestAnimationFrame(() => { queued = false; update(); }); };
    addEventListener('scroll', schedule, { passive:true });
    addEventListener('resize', schedule);
    root.addEventListener('toggle', schedule, true);
    new ResizeObserver(schedule).observe(root);
    update();
  }
</script>
