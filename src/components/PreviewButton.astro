---
import previews from "../data/previews.json";

interface Props {
  slug: string;
  title?: string;
  size?: "sm" | "md";
  class?: string;
}

const { slug, title = "", size = "md", class: className = "" } = Astro.props;
const key = slug.split("/").pop()!;
const entry = (previews as Record<string, { id: number } | null>)[key];
const dim = size === "sm" ? "w-7 h-7" : "w-9 h-9";
const icon = size === "sm" ? 12 : 14;
---

{entry && (
  <button
    type="button"
    class={`preview-btn ${dim} ${className}`}
    data-preview-id={entry.id}
    aria-label={`${title || key} を30秒試聴`}
    title="30秒試聴"
  >
    <svg class="pv-play" width={icon} height={icon} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.14v13.72c0 .8.87 1.3 1.56.88l10.5-6.86a1.03 1.03 0 0 0 0-1.76L9.56 4.26A1.03 1.03 0 0 0 8 5.14z"/></svg>
    <svg class="pv-pause" width={icon} height={icon} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"/></svg>
  </button>
)}
