---
import { findSlangEntry, cleanSlangTerm } from '../data/slang';

interface Props {
  word?: string;
  term?: string;
  desc?: string;
  meaning?: string;
  href?: string;
}
const { word, term, desc, meaning, href } = Astro.props;
const label = word ?? term ?? "";
const body = desc ?? meaning ?? "";

// 中央スラング辞書に登録がある語（または明示href）のみ詳細リンクを出す
const hasEntry = !!findSlangEntry(label);
const hasDetail = !!href || hasEntry;
const resolvedHref = href ?? (hasEntry ? `/slang?q=${encodeURIComponent(cleanSlangTerm(label))}` : "");
const triggerClass = hasDetail
  ? "qs-trigger border-b border-[var(--c-gold)] text-[var(--c-text)] cursor-pointer bg-transparent p-0 font-[inherit] text-[inherit]"
  : "qs-trigger border-b border-dotted border-[var(--c-gold)]/40 text-[var(--c-text)] cursor-pointer bg-transparent p-0 font-[inherit] text-[inherit]";
---

<span class="qs relative inline-block" data-href={resolvedHref}>
  <button
    type="button"
    class={triggerClass}
    aria-expanded="false"
  >{label}</button>
  <span
    class="qs-tip absolute bottom-full mb-2 px-3 py-2 bg-[var(--c-surface)] border border-[var(--c-gold)]/60 text-[var(--c-text)] text-xs rounded w-52 leading-snug pointer-events-none opacity-0 transition-opacity duration-150 z-20"
    role="tooltip"
  >
    {body}
    {hasDetail && (
      <span class="qs-hint block mt-1.5 text-[var(--c-gold)] text-[10px] uppercase tracking-widest">もう一度タップで詳細 →</span>
    )}
  </span>
</span>

<script>
  function positionTip(qs: HTMLElement) {
    const tip = qs.querySelector<HTMLElement>('.qs-tip')!;
    tip.style.left = '';
    tip.style.right = '';
    tip.style.transform = '';

    const triggerRect = qs.getBoundingClientRect();
    const tipWidth = tip.offsetWidth;
    const center = triggerRect.left + triggerRect.width / 2;
    const viewportWidth = window.innerWidth;
    const margin = 8;

    if (center - tipWidth / 2 < margin) {
      tip.style.left = '0';
    } else if (center + tipWidth / 2 > viewportWidth - margin) {
      tip.style.right = '0';
    } else {
      tip.style.left = '50%';
      tip.style.transform = 'translateX(-50%)';
    }
  }

  function initQuickSlang() {
    document.querySelectorAll<HTMLElement>('.qs').forEach(qs => {
      if (qs.dataset.qsInit) return;
      qs.dataset.qsInit = '1';

      const trigger = qs.querySelector<HTMLButtonElement>('.qs-trigger')!;
      const tip = qs.querySelector<HTMLElement>('.qs-tip')!;
      const href = qs.dataset.href;

      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = tip.classList.contains('opacity-100');
        if (isOpen && href) {
          window.location.href = href;
          return;
        }
        closeAll();
        if (!isOpen) {
          positionTip(qs);
          tip.classList.replace('opacity-0', 'opacity-100');
          tip.classList.remove('pointer-events-none');
          trigger.setAttribute('aria-expanded', 'true');
        }
      });
    });
  }

  function closeAll() {
    document.querySelectorAll<HTMLElement>('.qs-tip').forEach(tip => {
      tip.classList.replace('opacity-100', 'opacity-0');
      tip.classList.add('pointer-events-none');
    });
    document.querySelectorAll<HTMLButtonElement>('.qs-trigger').forEach(t => {
      t.setAttribute('aria-expanded', 'false');
    });
  }

  document.addEventListener('click', closeAll);

  initQuickSlang();
  document.addEventListener('astro:page-load', initQuickSlang);
</script>
