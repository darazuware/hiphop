---
import Layout from '../../layouts/Layout.astro';
import { shorts } from '../../data/shorts';

export function getStaticPaths() {
  return shorts.map(s => ({ params: { slug: s.slug }, props: { short: s } }));
}

const { short } = Astro.props;
---

<Layout
  title={`${short.title} — ${short.artist} | WAX&THINK`}
  description={`${short.artist}「${short.title}」(${short.year}) の歌詞和訳ショート動画。`}
>
  <div class="min-h-[calc(100vh-44px)] bg-black flex flex-col items-center justify-center px-4 py-6 relative">

    <!-- Back -->
    <a
      href="/shorts"
      class="absolute top-4 left-4 flex items-center gap-1.5 text-[var(--c-muted)] hover:text-[var(--c-gold)] text-sm transition-colors"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
      一覧
    </a>

    <!-- Video container: 9:16, max height = viewport -->
    <div class="relative w-full" style="max-width:min(100%, calc((100vh - 180px) * 9/16)); aspect-ratio:9/16;">
      <video
        id="main-video"
        src={`/shorts/${short.file}.mp4`}
        loop
        playsinline
        preload="auto"
        class="w-full h-full object-cover rounded-xl"
      />
      <!-- Play overlay (hidden after first play) -->
      <div id="play-overlay" class="absolute inset-0 flex items-center justify-center rounded-xl cursor-pointer">
        <div class="w-20 h-20 rounded-full bg-black/50 border-2 border-white/40 flex items-center justify-center">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="white"><polygon points="5 3 19 12 5 21 5 3"/></svg>
        </div>
      </div>
    </div>

    <!-- Metadata -->
    <div class="w-full mt-5" style="max-width:min(100%, calc((100vh - 180px) * 9/16));">
      <p class="text-[var(--c-gold)] text-[10px] uppercase tracking-widest font-mono mb-1">{short.artist}</p>
      <h1 class="text-white text-xl font-black tracking-tight mb-1">{short.title}</h1>
      <p class="text-[var(--c-very-dim)] text-xs font-mono">{short.year}&nbsp;·&nbsp;{short.producer}</p>

      <a
        href={short.songSlug}
        class="mt-4 inline-flex items-center gap-2 border border-[var(--c-gold)]/60 text-[var(--c-gold)] text-sm px-4 py-2 rounded-lg hover:bg-[var(--c-gold)] hover:text-black transition-colors"
      >
        歌詞・解説記事を読む
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

  </div>
</Layout>

<script>
  const video = document.getElementById('main-video') as HTMLVideoElement;
  const overlay = document.getElementById('play-overlay') as HTMLElement;

  overlay?.addEventListener('click', () => {
    video.play().then(() => {
      overlay.style.display = 'none';
    }).catch(() => {});
  });

  video?.addEventListener('click', () => {
    if (video.paused) { video.play().catch(() => {}); }
    else { video.pause(); }
  });
</script>
