---
import Layout from '../layouts/Layout.astro';
import { songs } from '../data/songs';

const producers = [...new Set(songs.map(s => s.producer))].sort((a, b) => a.localeCompare(b, 'ja'));
---

<Layout title="WAX&INK — ヒップホップ歌詞和訳・スラング解説" description="ヒップホップの名曲を歌詞和訳とスラング解説で深掘り。C.R.E.A.M.・Nasなど名曲のスラングと文化背景を日本語で徹底解説。">
  <div class="max-w-2xl mx-auto px-4 py-12">

    <header class="mb-12">
      <h1 class="site-title font-black uppercase leading-none tracking-tighter mb-4 select-none">
        WAX<span class="text-[var(--c-gold)]">&amp;</span>INK
      </h1>
      <p class="text-[var(--c-very-dim)] text-xs uppercase tracking-widest mb-4">Hip-Hop Lyrics — 歌詞和訳・スラング解説</p>
      <p class="text-[var(--c-muted)] text-sm leading-relaxed mb-5 max-w-md">
        ヒップホップの名曲を、歌詞の一語一語・スラング・サンプリング・文化背景まで徹底解説。
      </p>
      <a href="/slang" class="inline-block text-xs text-[var(--c-gold)] border border-[var(--c-gold)] rounded px-3 py-1 hover:bg-[var(--c-gold)] hover:text-[var(--c-bg)] transition-colors">
        スラング索引 ({songs.length}曲 · 100+ 用語) →
      </a>
    </header>

    <!-- Search -->
    <div class="mb-6">
      <div class="relative">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[var(--c-very-dim)] pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
        </svg>
        <input
          id="search-input"
          type="search"
          placeholder="曲名・アーティスト・スラング・サンプルを検索..."
          autocomplete="off"
          class="w-full bg-[var(--c-surface)] border border-[var(--c-border)] rounded-lg pl-10 pr-4 py-2.5 text-sm text-[var(--c-fg)] placeholder-[var(--c-very-dim)] focus:outline-none focus:border-[var(--c-gold)] transition-colors"
        />
        <button id="search-clear" class="absolute right-3 top-1/2 -translate-y-1/2 hidden text-[var(--c-very-dim)] hover:text-[var(--c-muted)] transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Filters -->
    <div class="mb-8 space-y-3">
      <div class="flex flex-wrap gap-2 items-center">
        <span class="text-[var(--c-very-dim)] text-xs uppercase tracking-widest w-16 shrink-0">Era</span>
        <button data-filter="era" data-value="" class="filter-btn active text-xs px-3 py-1 rounded border border-[var(--c-border)] text-[var(--c-muted)] hover:border-[var(--c-gold)] transition-colors">All</button>
        <button data-filter="era" data-value="90s前半" class="filter-btn text-xs px-3 py-1 rounded border border-[var(--c-border)] text-[var(--c-muted)] hover:border-[var(--c-gold)] transition-colors">90s前半</button>
        <button data-filter="era" data-value="90s後半" class="filter-btn text-xs px-3 py-1 rounded border border-[var(--c-border)] text-[var(--c-muted)] hover:border-[var(--c-gold)] transition-colors">90s後半</button>
        <button data-filter="era" data-value="00s以降" class="filter-btn text-xs px-3 py-1 rounded border border-[var(--c-border)] text-[var(--c-muted)] hover:border-[var(--c-gold)] transition-colors">00s以降</button>
      </div>
      <div class="flex flex-wrap gap-2 items-center">
        <span class="text-[var(--c-very-dim)] text-xs uppercase tracking-widest w-16 shrink-0">Area</span>
        <button data-filter="region" data-value="" class="filter-btn active text-xs px-3 py-1 rounded border border-[var(--c-border)] text-[var(--c-muted)] hover:border-[var(--c-gold)] transition-colors">All</button>
        <button data-filter="region" data-value="NY" class="filter-btn text-xs px-3 py-1 rounded border border-[var(--c-border)] text-[var(--c-muted)] hover:border-[var(--c-gold)] transition-colors">New York</button>
        <button data-filter="region" data-value="Philly" class="filter-btn text-xs px-3 py-1 rounded border border-[var(--c-border)] text-[var(--c-muted)] hover:border-[var(--c-gold)] transition-colors">Philly</button>
        <button data-filter="region" data-value="LA" class="filter-btn text-xs px-3 py-1 rounded border border-[var(--c-border)] text-[var(--c-muted)] hover:border-[var(--c-gold)] transition-colors">LA / West</button>
      </div>
      <div class="flex flex-wrap gap-2 items-center">
        <span class="text-[var(--c-very-dim)] text-xs uppercase tracking-widest w-16 shrink-0">Prod.</span>
        <select id="producer-select" class="text-xs px-3 py-1 rounded border border-[var(--c-border)] bg-[var(--c-surface)] text-[var(--c-muted)] focus:outline-none focus:border-[var(--c-gold)] transition-colors cursor-pointer">
          <option value="">All</option>
          {producers.map(p => <option value={p}>{p}</option>)}
        </select>
      </div>
    </div>

    <section>
      <div class="flex items-center justify-between mb-5 border-b border-[var(--c-border)] pb-2">
        <h2 class="text-[var(--c-gold)] text-xs uppercase tracking-widest">Songs</h2>
        <div class="flex items-center gap-3">
          <select id="sort-select" class="text-xs px-2 py-1 rounded border border-[var(--c-border)] bg-[var(--c-surface)] text-[var(--c-very-dim)] focus:outline-none focus:border-[var(--c-gold)] transition-colors cursor-pointer">
            <option value="default">Default</option>
            <option value="az">A–Z</option>
            <option value="bpm">BPM ↑</option>
            <option value="era">Era</option>
          </select>
          <span id="count" class="text-[var(--c-very-dim)] text-xs">{songs.length} tracks</span>
        </div>
      </div>

      <ul id="song-list" class="grid grid-cols-2 md:grid-cols-3 gap-3">
        {songs.map((song, i) => (
          <li
            data-era={song.era}
            data-region={song.region}
            data-producer={song.producer}
            data-bpm={song.bpm}
            data-search={[song.title, song.artists, song.subtitle, song.tag, song.era, song.region, song.producer, song.sample ?? ''].join(' ').toLowerCase()}
          >
            <a href={song.slug} class="song-card group relative flex flex-col justify-end overflow-hidden rounded-xl aspect-[3/4]">
              <img src={song.asin ? `https://ws-fe.amazon-adsystem.com/widgets/q?_encoding=UTF8&ASIN=${song.asin}&Format=_SL500_&ID=AsinImage&MarketPlace=JP&ServiceVersion=20070822&WS=1&tag=hiphop_black-22` : `/images/covers/${song.slug.split('/').pop()}.jpg`} alt={song.album} class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" loading="lazy" onerror="this.style.display='none'" />
              <div class="absolute inset-0 card-overlay transition-opacity duration-300" />
              <div class="relative z-10 p-4">
                {song.tag && (
                  <span
                    class="sticker inline-block text-[10px] font-black uppercase tracking-wide px-2 py-0.5 mb-3"
                    style={`--rot: ${[-3,-1.5,2,-2.5,0.5,-1,1.5,3,-0.5,2.5][i % 10]}deg; --bg: ${['#FFE135','#FFE135','#FFE135','#FF3B30','#FFE135','#F5F5F0','#FFE135','#FFE135','#FF3B30','#FFE135'][i % 10]};`}
                  >
                    {song.tag}
                  </span>
                )}
                <p class="font-bold text-base leading-snug text-white mb-1 drop-shadow">{song.title}</p>
                <p class="text-white/60 text-xs leading-snug truncate">{song.artists}</p>
                <p class="text-white/35 text-[10px] mt-1 uppercase tracking-widest">{song.subtitle}</p>
              </div>
              <span class="absolute top-3 right-3 text-white/20 text-xs tabular-nums select-none font-mono">
                {String(i + 1).padStart(2, '0')}
              </span>
            </a>
          </li>
        ))}
      </ul>

      <p id="no-results" class="hidden text-center text-[var(--c-dim)] text-sm py-12">該当する曲がありません</p>
    </section>

  </div>
</Layout>

<script>
  const filters: Record<string, string> = { era: '', region: '', producer: '' };
  let searchQuery = '';

  function applyFilters() {
    const items = document.querySelectorAll<HTMLElement>('#song-list > li');
    const terms = searchQuery.trim().toLowerCase().split(/\s+/).filter(Boolean);
    let visible = 0;
    items.forEach(item => {
      const filterMatch = Object.entries(filters).every(([key, val]) =>
        !val || item.dataset[key] === val
      );
      const searchData = item.dataset.search ?? '';
      const searchMatch = terms.length === 0 || terms.every(t => searchData.includes(t));
      const match = filterMatch && searchMatch;
      item.style.display = match ? '' : 'none';
      if (match) visible++;
    });
    const count = document.getElementById('count');
    if (count) count.textContent = `${visible} tracks`;
    const noResults = document.getElementById('no-results');
    if (noResults) noResults.classList.toggle('hidden', visible > 0);
  }

  document.querySelectorAll<HTMLButtonElement>('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const filterType = btn.dataset.filter as string;
      const value = btn.dataset.value as string;
      filters[filterType] = value;
      document.querySelectorAll<HTMLButtonElement>(`.filter-btn[data-filter="${filterType}"]`)
        .forEach(b => b.classList.remove('active', 'border-[var(--c-gold)]', 'text-[var(--c-gold)]'));
      btn.classList.add('active', 'border-[var(--c-gold)]', 'text-[var(--c-gold)]');
      applyFilters();
    });
  });

  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const searchClear = document.getElementById('search-clear') as HTMLButtonElement | null;

  searchInput?.addEventListener('input', () => {
    searchQuery = searchInput.value;
    searchClear?.classList.toggle('hidden', searchQuery.length === 0);
    applyFilters();
  });

  searchClear?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    searchQuery = '';
    searchClear.classList.add('hidden');
    applyFilters();
    searchInput?.focus();
  });

  const producerSelect = document.getElementById('producer-select') as HTMLSelectElement | null;
  producerSelect?.addEventListener('change', () => {
    filters.producer = producerSelect.value;
    applyFilters();
  });

  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement | null;
  const songList = document.getElementById('song-list');
  sortSelect?.addEventListener('change', () => {
    if (!songList) return;
    const items = [...songList.querySelectorAll<HTMLElement>('li')];
    const eraOrder: Record<string, number> = { '90s前半': 0, '90s後半': 1, '00s以降': 2 };
    items.sort((a, b) => {
      const v = sortSelect.value;
      if (v === 'az') {
        const ta = a.querySelector<HTMLElement>('p.font-bold')?.textContent ?? '';
        const tb = b.querySelector<HTMLElement>('p.font-bold')?.textContent ?? '';
        return ta.localeCompare(tb);
      }
      if (v === 'era') {
        return (eraOrder[a.dataset.era ?? ''] ?? 99) - (eraOrder[b.dataset.era ?? ''] ?? 99);
      }
      if (v === 'bpm') {
        const ba = parseFloat(a.dataset.bpm ?? '0');
        const bb = parseFloat(b.dataset.bpm ?? '0');
        return ba - bb;
      }
      return parseInt(a.dataset.index ?? '0') - parseInt(b.dataset.index ?? '0');
    });
    items.forEach(item => songList.appendChild(item));
    applyFilters();
  });

  [...(songList?.querySelectorAll<HTMLElement>('li') ?? [])].forEach((item, i) => {
    item.dataset.index = String(i);
  });
</script>

<style>
  .sticker {
    background: var(--bg);
    color: #111;
    transform: rotate(var(--rot));
    box-shadow: 1px 2px 4px rgba(0,0,0,0.4);
    border-radius: 2px;
    display: inline-block;
    position: relative;
  }
  .sticker::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.15) 0%, transparent 50%);
    border-radius: 2px;
    pointer-events: none;
  }

  .site-title {
    font-size: clamp(3.5rem, 18vw, 7rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
  }

  .filter-btn.active {
    border-color: var(--c-gold);
    color: var(--c-gold);
  }

  .card-overlay {
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.88) 0%,
      rgba(0, 0, 0, 0.55) 45%,
      rgba(0, 0, 0, 0.25) 100%
    );
  }

  .song-card:hover .card-overlay {
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.75) 0%,
      rgba(0, 0, 0, 0.40) 45%,
      rgba(0, 0, 0, 0.15) 100%
    );
  }

  .no-image-bg {
    background: linear-gradient(135deg, #1a1a1a 0%, #111 50%, #0d0d0d 100%);
  }

  .no-image-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      45deg,
      transparent,
      transparent 24px,
      rgba(255,255,255,0.015) 24px,
      rgba(255,255,255,0.015) 25px
    );
  }
</style>
