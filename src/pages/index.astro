---
import Layout from '../layouts/Layout.astro';
import { songs, ranking } from '../data/songs';
import { artists } from '../data/artists';

const totalSongs = songs.length;
const totalArtists = artists.length;

const featuredSlugs = [
  '/songs/cream',
  '/songs/ny-state-of-mind',
  '/songs/shook-ones-pt-ii',
  '/songs/electric-relaxation',
  '/songs/fight-the-power',
  '/songs/ebonics',
];
const featuredSongs = featuredSlugs
  .map(slug => songs.find(s => s.slug === slug))
  .filter((s): s is (typeof songs)[number] => s !== undefined);

const seriesList = [
  {
    title: 'マフィオソ・ラップ',
    desc: 'ギャングとマフィアの美学が交差するサブジャンル',
    color: '#8B0000',
    slugs: ['/songs/twinz-deep-cover-98', '/songs/phone-tap', '/songs/criminology', '/songs/fast-life', '/songs/road-to-the-riches', '/songs/incarcerated-scarfaces'],
  },
  {
    title: 'ウェストコースト G-Funk',
    desc: 'サンセットに溶けるG-FunkとLAストリートの詩',
    color: '#1a4a1a',
    slugs: ['/songs/california-love', '/songs/nuthin-but-a-g-thang', '/songs/it-was-a-good-day', '/songs/gin-and-juice', '/songs/regulate'],
  },
  {
    title: 'NY 黄金時代',
    desc: '90年代ブームバップが刻んだ不滅の名曲群',
    color: '#1a2a4a',
    slugs: ['/songs/cream', '/songs/ny-state-of-mind', '/songs/juicy', '/songs/shook-ones-pt-ii', '/songs/protect-ya-neck'],
  },
  {
    title: 'DJ Premier 特集',
    desc: 'ヒップホップ史上最高のプロデューサーの仕事',
    color: '#2a1a4a',
    slugs: ['/songs/mass-appeal', '/songs/mathematics', '/songs/ny-state-of-mind', '/songs/supa-star', '/songs/the-1st-time'],
  },
];

const resolvedSeries = seriesList.map(s => ({
  ...s,
  songs: s.slugs
    .map(slug => songs.find(song => song.slug === slug))
    .filter((s): s is (typeof songs)[number] => s !== undefined),
}));

const producers = [...new Set(songs.map(s => s.producer))].sort((a, b) => a.localeCompare(b, 'ja'));
const eras = ['90s前半', '90s後半', '00s以降'] as const;
const regions = [
  { value: 'NY', label: 'New York' },
  { value: 'Philly', label: 'Philly' },
  { value: 'LA', label: 'LA / West' },
];

const tickerArtists = [
  'Wu-Tang Clan', 'Nas', 'The Notorious B.I.G.', '2Pac', 'Jay-Z',
  'Kendrick Lamar', 'Public Enemy', 'A Tribe Called Quest', 'Ice Cube',
  'Eminem', 'Gang Starr', 'Mobb Deep', 'Outkast', 'De La Soul',
  'Raekwon', 'Eric B. & Rakim', 'Big L', 'KRS-One', 'Mos Def',
  'Common', 'Talib Kweli', 'Cypress Hill', 'Dr. Dre', 'Snoop Dogg',
];
---

<Layout title="WAX&amp;THINK — ヒップホップ歌詞和訳・スラング解説" description="ヒップホップの名曲を歌詞和訳とスラング解説で深掘り。C.R.E.A.M.・Nasなど名曲のスラングと文化背景を日本語で徹底解説。">

  <!-- ① HERO -->
  <section class="border-b border-[var(--c-border)] relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-14 md:pt-20 pb-0 lg:grid lg:grid-cols-[1fr_auto] lg:gap-16 lg:items-end">
      <div class="max-w-2xl pb-14 md:pb-20">
        <p class="text-[var(--c-gold)] text-[10px] uppercase tracking-[0.35em] font-mono mb-5">
          Hip-Hop Lyrics &amp; Slang — Japanese Deep Dive
        </p>
        <h1 class="text-[var(--c-text)] font-black leading-[0.95] tracking-tighter mb-6 hero-headline">
          ラップを聴くな。<br/><span class="text-[var(--c-gold)]">読め。</span>
        </h1>
        <p class="text-[var(--c-muted)] text-sm md:text-base leading-loose mb-3">
          歌詞の一語一語に眠る<strong class="text-[var(--c-text)]">スラング・文化・歴史</strong>を徹底解剖。
        </p>
        <p class="text-[var(--c-very-dim)] text-xs md:text-sm leading-loose mb-8 font-mono">
          {totalSongs}曲 · 150+用語 · {totalArtists}アーティスト収録
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/slang" class="inline-flex items-center gap-2 bg-[var(--c-gold)] text-[#111] font-bold text-sm px-6 py-2.5 rounded-lg hover:bg-[var(--c-gold-light)] transition-colors">
            スラング索引を見る
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="#all-songs" class="inline-flex items-center border border-[var(--c-border)] text-[var(--c-muted)] text-sm px-6 py-2.5 rounded-lg hover:border-[var(--c-gold)] hover:text-[var(--c-gold)] transition-colors">
            全{totalSongs}曲を見る
          </a>
        </div>
      </div>

      <!-- Album mosaic (desktop) -->
      <div class="hidden lg:flex flex-col gap-2 w-[280px] shrink-0 self-end pb-0">
        <div class="grid grid-cols-3 gap-2">
          {featuredSlugs.slice(0, 6).map((slug, i) => {
            const song = songs.find(s => s.slug === slug);
            if (!song) return null;
            const key = slug.split('/').pop()!;
            return (
              <a href={slug} title={song.title} class={`overflow-hidden group block ${i === 0 ? 'col-span-2 row-span-2' : ''}`} style={i === 0 ? 'aspect-ratio: 1/1' : 'aspect-ratio: 1/1'}>
                <img
                  src={`/images/covers/${key}.jpg`}
                  alt={song.title}
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                  loading={i < 2 ? 'eager' : 'lazy'}
                />
              </a>
            );
          })}
        </div>
      </div>
    </div>

    <!-- Artist ticker -->
    <div class="border-t border-[var(--c-border)] overflow-hidden py-2.5 mt-0">
      <div class="ticker-track flex gap-6 whitespace-nowrap text-[var(--c-very-dim)] text-[10px] uppercase tracking-[0.2em] font-mono select-none">
        {[...tickerArtists, ...tickerArtists].map((name, i) => (
          <span class="shrink-0">{name}<span class="ml-6 text-[var(--c-border)]">·</span></span>
        ))}
      </div>
    </div>
  </section>

  <!-- ② STATS -->
  <section class="border-b border-[var(--c-border)] bg-[var(--c-surface)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 divide-[var(--c-border)]">
        {[
          { value: String(totalSongs), unit: '曲', label: '解説曲数', sub: '随時更新中' },
          { value: String(totalArtists), unit: '組', label: 'アーティスト', sub: '90s–現在' },
          { value: '150+', unit: '語', label: 'スラング収録', sub: '随時追加' },
          { value: '1988', unit: '–', label: '時代をカバー', sub: '2026まで' },
        ].map((stat, i) => (
          <div class={`py-6 px-4 text-center border-[var(--c-border)] ${i % 2 === 0 ? 'border-r' : ''} ${i < 2 ? 'border-b md:border-b-0' : ''} ${i < 3 ? 'md:border-r' : ''}`}>
            <p class="text-4xl md:text-5xl font-black text-[var(--c-gold)] tabular-nums leading-none">
              {stat.value}<span class="text-xl font-bold ml-0.5">{stat.unit}</span>
            </p>
            <p class="text-[var(--c-muted)] text-xs mt-1.5 font-medium">{stat.label}</p>
            <p class="text-[var(--c-very-dim)] text-[10px] mt-0.5 font-mono">{stat.sub}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ③ FEATURED PICKS -->
  <section class="border-b border-[var(--c-border)] py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="flex items-end justify-between mb-8">
        <div>
          <p class="text-[var(--c-gold)] text-[10px] uppercase tracking-[0.3em] font-mono mb-1.5">Featured Picks</p>
          <h2 class="text-[var(--c-text)] text-xl font-bold">特選解説</h2>
          <p class="text-[var(--c-very-dim)] text-xs mt-1">このサイトが特に力を入れた解説</p>
        </div>
        <a href="#all-songs" class="text-[var(--c-gold)] text-xs font-mono hover:underline underline-offset-4 hidden sm:block">全{totalSongs}曲を見る →</a>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
        {featuredSongs.map((song, i) => {
          const key = song.slug.split('/').pop()!;
          return (
            <a href={song.slug} class="song-card group relative flex flex-col justify-end overflow-hidden rounded-xl aspect-[3/4]">
              <img
                src={`/images/covers/${key}.jpg`}
                alt={song.album}
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                loading={i < 3 ? 'eager' : 'lazy'}
                onerror="this.classList.add('no-image-bg');this.style.display='none'"
              />
              <div class="absolute inset-0 card-overlay transition-opacity duration-300" />
              <div class="relative z-10 p-4">
                {song.tag && (
                  <span class="inline-block text-[10px] font-black uppercase tracking-wide px-2 py-0.5 mb-2 bg-[var(--c-gold)] text-[#111] rounded-sm">
                    {song.tag}
                  </span>
                )}
                <p class="font-bold text-sm md:text-base text-white leading-snug mb-1 drop-shadow">{song.title}</p>
                <p class="text-white/60 text-xs truncate">{song.artists}</p>
                <p class="text-white/35 text-[10px] mt-1 uppercase tracking-widest">{song.subtitle.split(' · ').pop()}</p>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ④ ACCESS RANKING -->
  <section class="border-b border-[var(--c-border)] py-12 md:py-16 bg-[var(--c-surface)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="mb-8">
        <p class="text-[var(--c-gold)] text-[10px] uppercase tracking-[0.3em] font-mono mb-1.5">Access Ranking</p>
        <h2 class="text-[var(--c-text)] text-xl font-bold">アクセスランキング</h2>
      </div>
      <ol class="space-y-3">
        {ranking.map((r, i) => {
          const song = songs.find(s => s.slug === r.slug);
          if (!song) return null;
          const key = r.slug.split('/').pop()!;
          return (
            <li>
              <a href={r.slug} class="group flex items-center gap-4 md:gap-6 p-4 rounded-xl border border-[var(--c-border)] hover:border-[var(--c-gold)]/50 transition-colors bg-[var(--c-bg)]">
                <span class="ranking-num font-black tabular-nums text-[var(--c-border)] shrink-0 leading-none">{String(i + 1).padStart(2, '0')}</span>
                <img
                  src={`/images/covers/${key}.jpg`}
                  alt={song.album}
                  class="w-14 h-14 md:w-18 md:h-18 rounded-lg object-cover shrink-0"
                  loading="eager"
                  onerror="this.style.display='none'"
                />
                <div class="flex-1 min-w-0">
                  <p class="text-[var(--c-text)] font-bold text-base md:text-lg group-hover:text-[var(--c-gold)] transition-colors truncate">{r.title}</p>
                  <p class="text-[var(--c-muted)] text-sm mt-0.5 truncate">{r.artists}</p>
                  <p class="text-[var(--c-very-dim)] text-xs mt-1 uppercase tracking-widest truncate">{song.subtitle}</p>
                </div>
                {song.tag && (
                  <span class="hidden sm:inline text-[var(--c-gold)] text-[10px] font-mono border border-[var(--c-border)] px-2 py-0.5 rounded shrink-0">{song.tag}</span>
                )}
                <svg class="w-4 h-4 text-[var(--c-very-dim)] group-hover:text-[var(--c-gold)] transition-colors shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 18l6-6-6-6"/></svg>
              </a>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <!-- ⑤ SERIES -->
  <section class="border-b border-[var(--c-border)] py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="mb-8">
        <p class="text-[var(--c-gold)] text-[10px] uppercase tracking-[0.3em] font-mono mb-1.5">Series</p>
        <h2 class="text-[var(--c-text)] text-xl font-bold">特集シリーズ</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {resolvedSeries.map(series => (
          <div class="series-card border border-[var(--c-border)] rounded-xl p-5 hover:border-[var(--c-gold)]/40 transition-colors relative overflow-hidden">
            <div class="relative z-10">
              <div class="flex items-start justify-between mb-4">
                <div>
                  <h3 class="text-[var(--c-text)] font-bold text-sm">{series.title}</h3>
                  <p class="text-[var(--c-very-dim)] text-xs mt-1 leading-relaxed">{series.desc}</p>
                </div>
                <span class="text-[var(--c-gold)] text-xs font-mono shrink-0 ml-4 mt-0.5 border border-[var(--c-border)] px-2 py-0.5 rounded">{series.songs.length}曲</span>
              </div>
              <div class="flex gap-1.5">
                {series.songs.map(song => {
                  const key = song.slug.split('/').pop()!;
                  return (
                    <a
                      href={song.slug}
                      title={`${song.title} — ${song.artists}`}
                      class="w-11 h-11 rounded overflow-hidden shrink-0 border border-[var(--c-border)] hover:border-[var(--c-gold)] hover:scale-110 transition-all duration-200"
                    >
                      <img src={`/images/covers/${key}.jpg`} alt={song.title} class="w-full h-full object-cover" loading="lazy" />
                    </a>
                  );
                })}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ⑥ ALL SONGS GRID -->
  <div id="all-songs" class="max-w-7xl mx-auto px-4 sm:px-6 py-8 lg:grid lg:grid-cols-[200px_1fr] lg:gap-8 lg:items-start">

    <!-- Filter sidebar (desktop) -->
    <aside class="hidden lg:block sticky top-8 space-y-6">
      <div>
        <p class="text-[var(--c-very-dim)] text-[10px] uppercase tracking-widest mb-2">Search</p>
        <input
          id="search-input-desktop"
          type="search"
          placeholder="検索..."
          autocomplete="off"
          class="w-full bg-[var(--c-surface)] border border-[var(--c-border)] rounded-lg pl-3 pr-3 py-1.5 text-xs text-[var(--c-fg)] placeholder-[var(--c-very-dim)] focus:outline-none focus:border-[var(--c-gold)] transition-colors"
        />
      </div>

      <div>
        <p class="text-[var(--c-very-dim)] text-[10px] uppercase tracking-widest mb-2">Era</p>
        <div class="space-y-1">
          <button data-filter="era" data-value="" class="filter-btn active block w-full text-left text-xs px-2 py-1 rounded border border-[var(--c-border)] text-[var(--c-muted)] hover:border-[var(--c-gold)] transition-colors">All</button>
          {eras.map(e => (
            <button data-filter="era" data-value={e} class="filter-btn block w-full text-left text-xs px-2 py-1 rounded border border-[var(--c-border)] text-[var(--c-muted)] hover:border-[var(--c-gold)] transition-colors">{e}</button>
          ))}
        </div>
      </div>

      <div>
        <p class="text-[var(--c-very-dim)] text-[10px] uppercase tracking-widest mb-2">Area</p>
        <div class="space-y-1">
          <button data-filter="region" data-value="" class="filter-btn active block w-full text-left text-xs px-2 py-1 rounded border border-[var(--c-border)] text-[var(--c-muted)] hover:border-[var(--c-gold)] transition-colors">All</button>
          {regions.map(r => (
            <button data-filter="region" data-value={r.value} class="filter-btn block w-full text-left text-xs px-2 py-1 rounded border border-[var(--c-border)] text-[var(--c-muted)] hover:border-[var(--c-gold)] transition-colors">{r.label}</button>
          ))}
        </div>
      </div>

      <div>
        <p class="text-[var(--c-very-dim)] text-[10px] uppercase tracking-widest mb-2">Producer</p>
        <select id="producer-select" class="w-full text-xs px-2 py-1 rounded border border-[var(--c-border)] bg-[var(--c-surface)] text-[var(--c-muted)] focus:outline-none focus:border-[var(--c-gold)] transition-colors cursor-pointer">
          <option value="">All</option>
          {producers.map(p => <option value={p}>{p}</option>)}
        </select>
      </div>

      <div>
        <p class="text-[var(--c-very-dim)] text-[10px] uppercase tracking-widest mb-2">Sort</p>
        <select id="sort-select" class="w-full text-xs px-2 py-1 rounded border border-[var(--c-border)] bg-[var(--c-surface)] text-[var(--c-very-dim)] focus:outline-none focus:border-[var(--c-gold)] transition-colors cursor-pointer">
          <option value="default">Default</option>
          <option value="az">A–Z (Song)</option>
          <option value="az-artist">A–Z (Artist)</option>
          <option value="bpm">BPM ↑</option>
          <option value="era">Era</option>
        </select>
      </div>
    </aside>

    <!-- Main content -->
    <div>
      <div class="lg:hidden mb-6">
        <div class="relative mb-4">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[var(--c-very-dim)] pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
          </svg>
          <input
            id="search-input"
            type="search"
            placeholder="曲名・アーティスト・スラング・サンプルを検索..."
            autocomplete="off"
            class="w-full bg-[var(--c-surface)] border border-[var(--c-border)] rounded-lg pl-10 pr-4 py-2.5 text-sm text-[var(--c-fg)] placeholder-[var(--c-very-dim)] focus:outline-none focus:border-[var(--c-gold)] transition-colors"
          />
          <button id="search-clear" class="absolute right-3 top-1/2 -translate-y-1/2 hidden text-[var(--c-very-dim)] hover:text-[var(--c-muted)] transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>
        <div class="space-y-3">
          <div class="flex flex-wrap gap-2 items-center">
            <span class="text-[var(--c-very-dim)] text-xs uppercase tracking-widest w-16 shrink-0">Era</span>
            <button data-filter="era" data-value="" class="filter-btn active text-xs px-3 py-1 rounded border border-[var(--c-border)] text-[var(--c-muted)] hover:border-[var(--c-gold)] transition-colors">All</button>
            {eras.map(e => (
              <button data-filter="era" data-value={e} class="filter-btn text-xs px-3 py-1 rounded border border-[var(--c-border)] text-[var(--c-muted)] hover:border-[var(--c-gold)] transition-colors">{e}</button>
            ))}
          </div>
          <div class="flex flex-wrap gap-2 items-center">
            <span class="text-[var(--c-very-dim)] text-xs uppercase tracking-widest w-16 shrink-0">Area</span>
            <button data-filter="region" data-value="" class="filter-btn active text-xs px-3 py-1 rounded border border-[var(--c-border)] text-[var(--c-muted)] hover:border-[var(--c-gold)] transition-colors">All</button>
            {regions.map(r => (
              <button data-filter="region" data-value={r.value} class="filter-btn text-xs px-3 py-1 rounded border border-[var(--c-border)] text-[var(--c-muted)] hover:border-[var(--c-gold)] transition-colors">{r.label}</button>
            ))}
          </div>
          <div class="flex flex-wrap gap-2 items-center">
            <span class="text-[var(--c-very-dim)] text-xs uppercase tracking-widest w-16 shrink-0">Prod.</span>
            <select id="producer-select-mobile" class="text-xs px-3 py-1 rounded border border-[var(--c-border)] bg-[var(--c-surface)] text-[var(--c-muted)] focus:outline-none focus:border-[var(--c-gold)] transition-colors cursor-pointer">
              <option value="">All</option>
              {producers.map(p => <option value={p}>{p}</option>)}
            </select>
          </div>
        </div>
      </div>

      <section>
        <div class="flex items-center justify-between mb-5 border-b border-[var(--c-border)] pb-2">
          <h2 class="text-[var(--c-gold)] text-xs uppercase tracking-widest">All Songs</h2>
          <div class="flex items-center gap-3">
            <select id="sort-select-mobile" class="lg:hidden text-xs px-2 py-1 rounded border border-[var(--c-border)] bg-[var(--c-surface)] text-[var(--c-very-dim)] focus:outline-none focus:border-[var(--c-gold)] transition-colors cursor-pointer">
              <option value="default">Default</option>
              <option value="az">A–Z (Song)</option>
              <option value="az-artist">A–Z (Artist)</option>
              <option value="bpm">BPM ↑</option>
              <option value="era">Era</option>
            </select>
            <span id="count" class="text-[var(--c-very-dim)] text-xs">{songs.length} tracks</span>
          </div>
        </div>

        <ul id="song-list" class="grid grid-cols-2 md:grid-cols-3 gap-3">
          {songs.map((song, i) => (
            <li
              data-era={song.era}
              data-region={song.region}
              data-producer={song.producer}
              data-bpm={song.bpm}
              data-artist={song.artists}
              data-search={[song.title, song.artists, song.subtitle, song.tag, song.era, song.region, song.producer, song.sample ?? ''].join(' ').toLowerCase()}
            >
              <a href={song.slug} class="song-card group relative flex flex-col justify-end overflow-hidden rounded-xl aspect-[3/4]">
                <img
                  src={`/images/covers/${song.slug.split('/').pop()}.jpg`}
                  alt={song.album}
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                  loading={i < 6 ? 'eager' : 'lazy'}
                  fetchpriority={i < 2 ? 'high' : 'auto'}
                  onerror="this.classList.add('no-image-bg');this.style.display='none'"
                />
                <div class="absolute inset-0 card-overlay transition-opacity duration-300" />
                <div class="relative z-10 p-4">
                  {song.tag && (
                    <span
                      class="sticker inline-block text-[10px] font-black uppercase tracking-wide px-2 py-0.5 mb-3"
                      style={`--rot: ${[-3,-1.5,2,-2.5,0.5,-1,1.5,3,-0.5,2.5][i % 10]}deg; --bg: ${['#FFE135','#FFE135','#FFE135','#FF3B30','#FFE135','#F5F5F0','#FFE135','#FFE135','#FF3B30','#FFE135'][i % 10]};`}
                    >
                      {song.tag}
                    </span>
                  )}
                  <p class="font-bold text-base leading-snug text-white mb-1 drop-shadow">{song.title}</p>
                  <p class="text-white/60 text-xs leading-snug truncate">{song.artists}</p>
                  <p class="text-white/35 text-[10px] mt-1 uppercase tracking-widest">{song.subtitle}</p>
                </div>
                <span class="absolute top-3 right-3 text-white/20 text-xs tabular-nums select-none font-mono">
                  {String(i + 1).padStart(2, '0')}
                </span>
              </a>
            </li>
          ))}
        </ul>

        <p id="no-results" class="hidden text-center text-[var(--c-dim)] text-sm py-12">該当する曲がありません</p>
      </section>
    </div>
  </div>

</Layout>

<script>
  const filters: Record<string, string> = { era: '', region: '', producer: '' };
  let searchQuery = '';
  const songList = document.getElementById('song-list');

  function applyFilters() {
    const items = document.querySelectorAll<HTMLElement>('#song-list > li');
    const terms = searchQuery.trim().toLowerCase().split(/\s+/).filter(Boolean);
    let visible = 0;
    items.forEach(item => {
      const filterMatch = Object.entries(filters).every(([key, val]) =>
        !val || item.dataset[key] === val
      );
      const searchData = item.dataset.search ?? '';
      const searchMatch = terms.length === 0 || terms.every(t => searchData.includes(t));
      const match = filterMatch && searchMatch;
      item.style.display = match ? '' : 'none';
      if (match) visible++;
    });
    const count = document.getElementById('count');
    if (count) count.textContent = `${visible} tracks`;
    const noResults = document.getElementById('no-results');
    if (noResults) noResults.classList.toggle('hidden', visible > 0);
  }

  document.querySelectorAll<HTMLButtonElement>('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const filterType = btn.dataset.filter as string;
      const value = btn.dataset.value as string;
      filters[filterType] = value;
      document.querySelectorAll<HTMLButtonElement>(`.filter-btn[data-filter="${filterType}"]`)
        .forEach(b => b.classList.remove('active', 'border-[var(--c-gold)]', 'text-[var(--c-gold)]'));
      document.querySelectorAll<HTMLButtonElement>(`.filter-btn[data-filter="${filterType}"][data-value="${value}"]`)
        .forEach(b => b.classList.add('active', 'border-[var(--c-gold)]', 'text-[var(--c-gold)]'));
      applyFilters();
    });
  });

  function setupSearch(id: string) {
    const input = document.getElementById(id) as HTMLInputElement | null;
    input?.addEventListener('input', () => {
      searchQuery = input.value;
      const other = document.getElementById(id === 'search-input' ? 'search-input-desktop' : 'search-input') as HTMLInputElement | null;
      if (other) other.value = input.value;
      const clear = document.getElementById('search-clear');
      clear?.classList.toggle('hidden', searchQuery.length === 0);
      applyFilters();
    });
  }
  setupSearch('search-input');
  setupSearch('search-input-desktop');

  const searchClear = document.getElementById('search-clear') as HTMLButtonElement | null;
  searchClear?.addEventListener('click', () => {
    const si = document.getElementById('search-input') as HTMLInputElement | null;
    const sd = document.getElementById('search-input-desktop') as HTMLInputElement | null;
    if (si) si.value = '';
    if (sd) sd.value = '';
    searchQuery = '';
    searchClear.classList.add('hidden');
    applyFilters();
    si?.focus();
  });

  function setupProducerSelect(id: string) {
    const sel = document.getElementById(id) as HTMLSelectElement | null;
    sel?.addEventListener('change', () => {
      filters.producer = sel.value;
      const other = document.getElementById(id === 'producer-select' ? 'producer-select-mobile' : 'producer-select') as HTMLSelectElement | null;
      if (other) other.value = sel.value;
      applyFilters();
    });
  }
  setupProducerSelect('producer-select');
  setupProducerSelect('producer-select-mobile');

  const eraOrder: Record<string, number> = { '90s前半': 0, '90s後半': 1, '00s以降': 2 };

  function doSort(value: string) {
    if (!songList) return;
    const items = [...songList.querySelectorAll<HTMLElement>('li')];
    items.sort((a, b) => {
      if (value === 'az') {
        const ta = a.querySelector<HTMLElement>('p.font-bold')?.textContent ?? '';
        const tb = b.querySelector<HTMLElement>('p.font-bold')?.textContent ?? '';
        return ta.localeCompare(tb);
      }
      if (value === 'az-artist') {
        const ta = a.dataset.artist ?? '';
        const tb = b.dataset.artist ?? '';
        return ta.localeCompare(tb);
      }
      if (value === 'era') return (eraOrder[a.dataset.era ?? ''] ?? 99) - (eraOrder[b.dataset.era ?? ''] ?? 99);
      if (value === 'bpm') return parseFloat(a.dataset.bpm ?? '0') - parseFloat(b.dataset.bpm ?? '0');
      return parseInt(a.dataset.index ?? '0') - parseInt(b.dataset.index ?? '0');
    });
    items.forEach(item => songList.appendChild(item));
    applyFilters();
  }

  function setupSortSelect(id: string) {
    const sel = document.getElementById(id) as HTMLSelectElement | null;
    sel?.addEventListener('change', () => {
      const other = document.getElementById(id === 'sort-select' ? 'sort-select-mobile' : 'sort-select') as HTMLSelectElement | null;
      if (other) other.value = sel.value;
      doSort(sel.value);
    });
  }
  setupSortSelect('sort-select');
  setupSortSelect('sort-select-mobile');

  [...(songList?.querySelectorAll<HTMLElement>('li') ?? [])].forEach((item, i) => {
    item.dataset.index = String(i);
  });
</script>

