---
import Layout from '../layouts/Layout.astro';
import { shorts } from '../data/shorts';
---

<Layout
  title="ショート動画一覧 | WAX&amp;THINK"
  description="ヒップホップ名曲の歌詞和訳ショート動画。Nas・Wu-Tang Clanなどの名曲を英語歌詞＋日本語訳の縦型動画で。"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">

    <div class="mb-10">
      <p class="text-[var(--c-gold)] text-[10px] uppercase tracking-[0.35em] font-mono mb-3">Shorts</p>
      <h1 class="text-3xl font-black text-[var(--c-text)] tracking-tight mb-2">ショート動画</h1>
      <p class="text-[var(--c-muted)] text-sm">歌詞和訳 × 縦型ビデオ &mdash; {shorts.length}本</p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4">
      {shorts.map(s => (
        <a
          href={`/shorts/${s.slug}`}
          class="short-card group relative block rounded-xl overflow-hidden bg-[var(--c-surface)] border border-[var(--c-border)] hover:border-[var(--c-gold)] transition-colors duration-200"
          style="aspect-ratio:9/16"
        >
          <video
            src={`/shorts/${s.file}.mp4`}
            poster={`/images/shorts/${s.slug}.jpg`}
            muted
            playsinline
            preload="none"
            class="w-full h-full object-cover pointer-events-none"
          />
        </a>
      ))}
    </div>

  </div>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>('.short-card').forEach(card => {
    const video = card.querySelector('video') as HTMLVideoElement;
    if (!video) return;
    card.addEventListener('mouseenter', () => video.play().catch(() => {}));
    card.addEventListener('mouseleave', () => { video.pause(); video.currentTime = 0; });
  });
</script>
