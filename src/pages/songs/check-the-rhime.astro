---
import LyricsBlock from '../../components/LyricsBlock.astro';
import QuickSlang from '../../components/QuickSlang.astro';
import SongLayout from '../../layouts/SongLayout.astro';
import AmazonAlbumCta from "../../components/AmazonAlbumCta.astro";
---

<SongLayout
  title="Check the Rhime 和訳・意味・スラング解説 | A Tribe Called Quest"
  description="A Tribe Called Quest「Check the Rhime」の歌詞和訳とスラング徹底解説。Q-TipとPhife Dawgがコール＆レスポンスで魅せる1991年のヒップホップ黄金時代の教科書。"
  slug="check-the-rhime"
  youtubeId="1QWEPdgS3As"
  highlights={[
    '「You on point, Phife? All the time, Tip」——ヒップホップ史上最も有名なコール＆レスポンスの誕生',
    'Minnie RipertonほかファンクとソウルのレコードをSP-1200とAkai S950で緻密に重ねたQ-Tipの15歳からのビジョン',
    '「Industry rule number four-thousand-and-eighty」——レコード会社への警告が独立精神のアンセムに',
  ]}
>

    <!-- この曲の意味 -->
    <section class="mb-6">
      <h2 class="text-base font-semibold mb-2">■この曲の意味（要約）</h2>
      <p class="text-sm text-[var(--c-muted)] leading-relaxed">Q-TipとPhife Dawgがクイーンズのリンデン通り時代を回顧しながらバトンを渡し合う、コール＆レスポンスの完全体。技術自慢、仲間への敬意、そしてレコード業界への警告をユーモアと品格で包んだ、ATCQの自己紹介にして思想宣言。</p>
    </section>

    <!-- 概要 -->
    <section class="mb-6">
      <h2 class="text-base font-semibold mb-2">■概要</h2>
      <p class="text-sm text-[var(--c-muted)] leading-relaxed">1991年アルバム『The Low End Theory』収録。Minnie Riperton「Baby, This Love I Have」（1975）のメロウなベース＆ギター、Average White Band「Love Your Life」（1976）のホーンリフ、Grover Washington Jr.「Hydra」（1975）のスネア、Lafayette Afro Rock Band「Hihache」（1973）のパーカッションを精緻にレイヤーした複数サンプリング構造。制作はQ-TipとAli Shaheed Muhammadが担当。</p>
    </section>

    <!-- 導入 -->
    <section class="mb-10">
      <h2 class="text-base font-semibold mb-2">■導入（時代背景）</h2>
      <p class="text-sm text-[var(--c-muted)] leading-relaxed">1991年、ギャングスタラップが西海岸で席巻するなか、クイーンズ発のATCQは暴力も拝金主義もないジャズ・サンプリングとウィットで真逆のロードを歩んだ。「Check the Rhime」はその姿勢の結晶——コール＆レスポンスという最も原始的なヒップホップ形式を、最も洗練されたサンプリング技術で包んだ問答の傑作。</p>
    </section>

    <!-- Table of Contents -->
    <nav class="mb-10 p-4 bg-[var(--c-surface)] border border-[var(--c-border)] rounded-lg">
      <p class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-3">目次</p>
      <ol class="space-y-1.5 text-sm text-[var(--c-muted)] list-none">
        <li><a href="#lyrics" class="hover:text-[var(--c-gold)] transition-colors">01 — 歌詞和訳と意味解説</a></li>
        <li><a href="#background" class="hover:text-[var(--c-gold)] transition-colors">02 — 文化的背景</a></li>
        <li><a href="#behind" class="hover:text-[var(--c-gold)] transition-colors">03 — 制作の裏側</a></li>
        <li><a href="#legacy" class="hover:text-[var(--c-gold)] transition-colors">04 — 評価とその後の影響</a></li>
      </ol>
    </nav>

    <div id="lyrics"></div>

    <!-- ===================== -->
    <!-- INTRO                 -->
    <!-- ===================== -->
    <AmazonAlbumCta query="A Tribe Called Quest Check the Rhime" cover="/images/covers/check-the-rhime.jpg" title="Check the Rhime / The Low End Theory" artist="A Tribe Called Quest" />

    <!-- まとめ -->
    <section class="mb-12">
      <h2 class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-5 border-b border-[var(--c-border)] pb-2">
        まとめ
      </h2>
      <ul class="space-y-2 text-sm text-[var(--c-muted)] list-disc list-inside leading-relaxed">
        <li>Minnie Ripertonほか5枚のレコードを精緻に重ねたサンプリング・コラージュ——SP-1200とAkai S950の制約を超えた15歳のQ-Tipのビジョン。</li>
        <li>Q-Tip（The Abstract）とPhife Dawg（The Five Footer）がコール＆レスポンスを前後半で逆転させる「対称美」——デュオ表現の完全体。</li>
        <li>「Industry rule #4080」「Rap is not pop」——2行でレコード業界批判とヒップホップ純粋主義の歴史的宣言。</li>
        <li>Native Tonguesコレクティブの哲学の結晶——暴力なし、ジャンクなし、ただ本物のライムとリスペクトだけがある1991年のマニフェスト。</li>
      </ul>
    </section>

</SongLayout>
