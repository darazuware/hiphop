    <h3 class="text-xs text-[var(--c-very-dim)] uppercase tracking-widest mb-3 mt-4">Verse 3 — Buckshot</h3>

    <LyricsBlock>
      <Fragment slot="eng">
        Let's take another trip, see what we can find<br />
        A whole lotta n***as, runnin' outta time
      </Fragment>
      <Fragment slot="jpn">
        もう一度旅に出よう、何が見つかるか<br />
        大勢の奴らが、時間切れになっていく
      </Fragment>
    </LyricsBlock>

    <LyricsBlock hasExplanation={true}>
