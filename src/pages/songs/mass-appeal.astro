        {[
          ['Hard to Earn', '全米ビルボード5位（1994）', 'Gang Starr最高チャート——商業妥協なしで到達したピーク'],
          ['Mass Appeal シングル', 'MTV Raps・BET放映', '商業主義批判の曲がMTVで流れるという逆説がインパクトを増幅'],
          ['DJ Premier', '「プリモサウンド」の確立', 'この時期のPremierビートはNas・Biggie・Jay-Zのキャリアにも直接影響'],
          ['コンシャスラップの系譜', 'Kendrick・J. Cole世代の源流', '「リアルであること」の価値観はこの曲を通じて次世代ラッパーに伝わった'],
          ['Guru逝去（2010）', '心臓発作のため49歳で死去', '「Mass Appeal」はGuruの信念の遺言として永遠に残る'],
        ].map(([metric, record, significance]) => (
          <div class="grid grid-cols-3">
            <div class="p-3 border-b border-[var(--c-border)] text-[var(--c-dim)]">{metric}</div>
