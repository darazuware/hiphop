---
import LyricsBlock from '../../components/LyricsBlock.astro';
import QuickSlang from '../../components/QuickSlang.astro';
import SongLayout from '../../layouts/SongLayout.astro';
import AmazonAlbumCta from "../../components/AmazonAlbumCta.astro";
---

<SongLayout
  title="Ambitionz Az a Ridah 和訳・意味・スラング解説 | 2Pac"
  description="2Pac「Ambitionz Az a Ridah」の歌詞和訳とスラング徹底解説。出所当日にCan-Amスタジオへ直行し45分で録音した伝説的トラック。ダズ・ディリンジャー製G-FunkビートにのせてDeath Row時代の野望と怒りを叩きつけた一曲。"
  slug="ambitionz-az-a-ridah"
  highlights={[
    '出所当日（1995年10月13日）にスタジオへ直行、3ヴァースをわずか数時間で録音——「トイレから戻ったら完成していた」とダズが証言',
    'サンプル元はJoeski Love「Pee-Wee\'s Dance」（1986年）——マイケル・バッファーの「Let\'s get ready to rumble!」がイントロに鳴り響く闘技場感',
    'Death Row移籍・刑務所・射撃事件——2Pacの人生の全転換点がこの1曲に凝縮された復活宣言',
  ]}
  youtubeId="6r4abhWnW-Y"
>

    <!-- この曲の意味 -->
    <section class="mb-6">
      <h2 class="text-base font-semibold mb-2">■この曲の意味（要約）</h2>
      <p class="text-sm text-[var(--c-muted)] leading-relaxed">1995年、性的暴行罪で収監されていた2Pacが出所した日の夜に録音した復活宣言。刑務所・射撃事件・敵対者への憎悪・Death Row移籍という人生の激動をすべて飲み込み、「俺はRidah（忠義の戦士）だ」という一点に集約した楽曲。Wild-Westな闘争心とギャング的連帯が全編を貫く。</p>
    </section>

    <!-- 概要 -->
    <section class="mb-6">
      <h2 class="text-base font-semibold mb-2">■概要</h2>
      <p class="text-sm text-[var(--c-muted)] leading-relaxed">1996年アルバム『All Eyez on Me』（Death Row Records）の冒頭トラック。プロデューサーはDaz Dillinger（Dat N***a Daz）。Joeski Love「Pee-Wee's Dance」（1986年）の重低音ピアノループをサンプリングし、イントロにはリングアナウンサーのマイケル・バッファーの声を使用。BPM 87の催眠的なミッドテンポが2Pacの攻撃的フロウを最大限に引き立てる。</p>
    </section>

    <!-- 導入 -->
    <section class="mb-10">
      <h2 class="text-base font-semibold mb-2">■導入（時代背景）</h2>
      <p class="text-sm text-[var(--c-muted)] leading-relaxed">1995年10月13日——2Pacはシュグ・ナイトが支払った140万ドルの保釈金で刑務所から出た。契約書はトイレットペーパーに書かれ、その日の夜にはタルザナのCan-Amスタジオへ直行。ステーキとシャンパンで出所を祝った直後、ブースに入り「Ambitionz Az a Ridah」を録音した。ダズ・ディリンジャーは「トイレに行って戻ったら3ヴァースすべて完成していた」と証言している。</p>
    </section>

    <!-- Table of Contents -->
    <nav class="mb-10 p-4 bg-[var(--c-surface)] border border-[var(--c-border)] rounded-lg">
      <p class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-3">目次</p>
      <ol class="space-y-1.5 text-sm text-[var(--c-muted)] list-none">
        <li><a href="#lyrics" class="hover:text-[var(--c-gold)] transition-colors">01 — 歌詞和訳と意味解説</a></li>
        <li><a href="#background" class="hover:text-[var(--c-gold)] transition-colors">02 — 文化的背景</a></li>
        <li><a href="#behind" class="hover:text-[var(--c-gold)] transition-colors">03 — 制作の裏側</a></li>
        <li><a href="#legacy" class="hover:text-[var(--c-gold)] transition-colors">04 — 評価とその後の影響</a></li>
      </ol>
    </nav>

    <div id="lyrics"></div>

    <!-- ===================== -->
    <!-- INTRO                 -->
    <!-- ===================== -->
    <AmazonAlbumCta query="2Pac Ambitionz Az A Ridah" cover="/images/covers/ambitionz-az-a-ridah.jpg" title="Ambitionz Az a Ridah / All Eyez on Me" artist="2Pac" />

    <!-- まとめ -->
    <section class="mb-12">
      <h2 class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-5 border-b border-[var(--c-border)] pb-2">
        まとめ
      </h2>
      <ul class="space-y-2 text-sm text-[var(--c-muted)] list-disc list-inside leading-relaxed">
        <li>1995年10月13日、保釈当日にCan-Amスタジオへ直行——9ヶ月の獄中で書き溜めたリリックが一夜にして解放された歴史的録音。</li>
        <li>Daz DillingerのJoeski Love「Pee-Wee's Dance」サンプリングとマイケル・バッファーのアナウンス——西海岸G-Funkと闘技場の融合が異常な威圧感を生む。</li>
        <li>「Reincarnated（転生）」「Hard to kill（殺しにくい）」——5発の銃弾を生き延びた2Pacが自己神話化を開始した瞬間であり、Death Row時代の野望の宣言。</li>
        <li>East Coast-West Coastビーフの伏線（「b****-ass n***as on my team」）が埋め込まれた一曲で、1996年の悲劇への序章でもある。</li>
      </ul>
    </section>

</SongLayout>
