      <!-- ⑬ Leave it up to me while I be livin' proof（証人としての反転） -->
      <LearningUnit
        heading="Leave it up to me while I be livin' proof — 語り手が「生き証人」へと反転する一行"
        label="★ 最重要パンチライン"
        mc="Inspectah Deck（Verse 2）"
