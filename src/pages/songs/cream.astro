---
import LearningUnit from '../../components/LearningUnit.astro';
import DiveCards from '../../components/DiveCards.astro';
import QuickSlang from '../../components/QuickSlang.astro';
import SongLayout from '../../layouts/SongLayout.astro';

// 学習ユニットのPVタイムスタンプ。agent/src/extract-unit-timestamps.mjs で album音源を
// whisper単語アライメントして取得（whisperSec）し、運営者の実測値があれば manualSec が
// 上書きする二層構造（manualSec優先）。一律オフセット補正は廃止。
// crime-side / lo-goose は運営者がPVで実測した値（manualSec=23 / 33）。
import tsData from '../../../agent/cream/assets/units-timestamps.json';
const YT = "PBwAxmrE194";
const TS = Object.fromEntries(tsData.map((u) => [u.id, { t: u.t, approx: u.approx }]));
---

<SongLayout
  title="C.R.E.A.M. 和訳・意味・スラング解説 | Wu-Tang Clan"
  description="Wu-Tang ClanのC.R.E.A.M.を英語学習＋ヒップホップ理解の教材として精読。'Lo goose・G off・keys・Old EarthなどのスラングとAAVE、RZAのサンプリングを表現単位で解説。各表現はPVの該当箇所へ頭出しリンク付き。"
  slug="cream"
  learningPage={true}
  songDuration={252}
  highlights={[
    'C.R.E.A.M.は拝金主義ではなく貧困の構造的暴力への告発',
    'スラング・韻・言葉遊びを「学ぶ表現」単位で解説（PV頭出しリンク付き）',
    'RZAのサンプリング哲学とLoFi Hip-Hopの源流',
  ]}
  youtubeId="PBwAxmrE194"
  sampleYoutubeId="gp9uZjPaB4w"
  sampleTitle="The Charmels - As Long As I've Got You"
>

    <!-- ===================== -->
    <!-- 導入                  -->
    <!-- ===================== -->
    <section class="mb-6">
      <h2 class="text-base font-semibold mb-2">■この曲で何を学べるか</h2>
      <p class="text-sm text-[var(--c-muted)] leading-relaxed">
        Cash Rules Everything Around Me（金が周りのすべてを支配する）——クラック・エピデミックが蔓延したインナーシティで、金のために生き、金のために死ぬほかない若者たちの絶望を描いた楽曲。「俺はこんなに金持ってんだぜ〜」というFLEX的な拝金主義の讃歌ではなく、貧困の構造的暴力を歌ったクラシック中のクラシックだ。この記事は英語学習とヒップホップ理解の教材として読んでもらえればと思います。色々いるウータン（Wu-Tang Clan）のメンバーの中でも、ここでラップするのは <strong class="text-[var(--c-text)]">RaekwonとInspectah Deck</strong>、そしてHOOK担当が <strong class="text-[var(--c-text)]">Method Man（メソッドマン）</strong>という少数精鋭の構成。リリックには、辞書に載らないストリートスラング、AAVE（アフリカ系アメリカ人英語）の文法、二重・三重の意味を仕込んだ言葉遊び、そして韻の構築が凝縮されています。それぞれを「学ぶ表現」単位で取り出し、用例の断片・和訳・語法と文化背景を解説していきたいと思います。
      </p>
    </section>

    <section class="mb-6">
      <h2 class="text-base font-semibold mb-2">■なぜC.R.E.A.M.が教材として優れるか</h2>
      <p class="text-sm text-[var(--c-muted)] leading-relaxed">
        1994年リリース。RZAがThe Charmelsの哀愁ピアノをサンプリングし、HOOKをMethod Man、ヴァースをRaekwonとInspectah Deckが担当。Wu-Tang Clanで最大のヒットとなり4×プラチナに認定されました。それだけじゃなく、なんと「C.R.E.A.M.」という単語は後に「現金」を意味するスラングとして英語の辞書に収録されたようです（本場だけあって、HIPHOPの影響力すごすぎ）。教科書英語からは決して学べない<strong class="text-[var(--c-text)]">生きたストリート言語の凝縮度</strong>と、たった数語に複数の意味を畳み込む<strong class="text-[var(--c-text)]">言葉の経済性</strong>——この2点で、本作はリアルな英語表現の教材として群を抜いています。当時、業界的にはウェッサイ（西海岸）のG-Funk全盛の時代でしたが、スタテンアイランド（＝Shaolin＝少林）から放たれた東海岸の反撃、という文脈も併せて知っておくと面白いと思います。
      </p>
    </section>

    <!-- Table of Contents -->
    <nav class="mb-10 p-4 bg-[var(--c-surface)] border border-[var(--c-border)] rounded-lg">
      <p class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-3">目次</p>
      <ol class="space-y-1.5 text-sm text-[var(--c-muted)] list-none">
        <li><a href="#story" class="hover:text-[var(--c-gold)] transition-colors">01 — ストーリーの流れ（まず曲全体をつかむ）</a></li>
        <li><a href="#units" class="hover:text-[var(--c-gold)] transition-colors">02 — 学ぶ表現（スラング・韻・言葉遊び・AAVE）</a></li>
        <li><a href="#background" class="hover:text-[var(--c-gold)] transition-colors">03 — 文化的背景</a></li>
        <li><a href="#legacy" class="hover:text-[var(--c-gold)] transition-colors">04 — 評価とその後の影響</a></li>
      </ol>
    </nav>

    <!-- ===================== -->
    <!-- ストーリー要約（散文・まず全体像）  -->
    <!-- ===================== -->
    <section id="story" class="mb-12">
      <h2 class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-5 border-b border-[var(--c-border)] pb-2">
        ストーリーの流れ — まず曲全体をつかむ
      </h2>
      <p class="text-xs text-[var(--c-dim)] mb-5">
        個々のスラングに入る前に、まず曲が何を語っているかをざっと散文でつかんでおきましょう。全体の物語が頭に入っていると、次章「学ぶ表現」で一語一語を掘るときに、その言葉が物語のどこに位置するのかが立体的に見えてくる。
      </p>
      <div class="space-y-4 text-sm text-[var(--c-muted)] leading-relaxed">
        <p>
          曲は、ストリートのドラッグ売買の生々しい客引き（「2個で5ドル」という路上相場）から幕を開ける。RaekwonとMethod Manの語りで、これから語られる世界の温度を先に提示する——そういう導入だ。
        </p>
        <p>
          <strong class="text-[var(--c-text)]">Verse 1（Raekwon）</strong>。犯罪多発地域で育った少年が、金歯とポロのダウンを身にまとい、麻薬の稼ぎだけが「のし上がる唯一の方法」だった過去を語っていく。トラップハウスへの強盗、コカインの密輸、毎週4万ドル——それだけ稼いでも人生は一向に良くならず、同じセーターを着続ける無限ループとして描かれるのが切ない。そして終盤、密輸の「keys」が音楽の「keys」へとスッと転じて、Wu-Tangでの合法的な成功へと物語が折り返す。
        </p>
        <p>
          <strong class="text-[var(--c-text)]">Hook（Method Man）</strong>の「Cash rules everything around me」は、両脇を絶望のヴァースに挟まれることで、拝金の讃歌ではなく「金がなければ死ぬ」という現実への悲鳴として響いてくる。同じ一行でも、どこに置かれるかで意味が変わるわけです。
        </p>
        <p>
          <strong class="text-[var(--c-text)]">Verse 2（Inspectah Deck）</strong>は、15歳での投獄、世界そのものが独房だという比喩、母（Old Earth）の教え、そして強盗・悪徳警官・流れ弾が渦巻く街区へと展開する。生き証人として若者に説こうとするが、彼らはかつての自分と同じで聞く耳を持たない——サイクルは終わらないまま、フックがもう一度繰り返されてフェードアウトしていく。映画のような悲劇構造で曲は閉じる。初めて通しで聴いたとき、この畳み方に静かにやられました。
        </p>
        <p class="text-xs text-[var(--c-dim)]">
          ※本ページは批評・教育目的で、解説に必要な範囲の断片のみを引用しています。全歌詞の対訳は掲載していません。
        </p>
      </div>
    </section>

    <!-- ===================== -->
    <!-- Deep-Dive Teaser (BEFORE units) -->
    <!-- ===================== -->
    <div class="relctn mb-12">
      <p class="relctn-eyebrow">関連コラム — 読み込む前に</p>
      <p class="relctn-lead">下は<strong>別ページのコラム</strong>。先に時代背景を入れておくと、解説の入りが段違いになる。</p>
      <div class="relctn-grid">
        <a href="/columns/crack-epidemic-hiphop" class="pit">
          <span class="pit-tape" aria-hidden="true"></span>
          <span class="pit-kicker">COLUMN ／ 文化・歴史</span>
          <span class="pit-title">クラック・エピデミックとヒップホップ</span>
          <span class="pit-desc">1980〜90年代インナーシティの実像。このヴァースが産まれた時代背景をまず知ると、解説の密度が変わる。</span>
          <span class="pit-foot"><span class="pit-time">約5分</span><span class="pit-go">コラムを読む →</span></span>
        </a>
        <a href="/columns/ny-golden-era-1994" class="pit">
          <span class="pit-tape" aria-hidden="true"></span>
          <span class="pit-kicker">COLUMN ／ 時代解説</span>
          <span class="pit-title">1994年 NYヒップホップ黄金期</span>
          <span class="pit-desc">Nas・Wu-Tang・Bigが同時に産まれた年。C.R.E.A.M.リリースの同年、なにが起きていたのかを一望する。</span>
          <span class="pit-foot"><span class="pit-time">約7分</span><span class="pit-go">コラムを読む →</span></span>
        </a>
      </div>
    </div>

    <!-- ===================== -->
    <!-- 学習ユニット群（主役）  -->
    <!-- ===================== -->
    <div id="units"></div>
    <section class="mb-12">
      <h2 class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-2 border-b border-[var(--c-border)] pb-2">
        学ぶ表現 — スラング・韻・言葉遊び・AAVE
      </h2>
      <p class="text-xs text-[var(--c-dim)] mb-6">
        各見出しは「この曲から学べる英語表現」。各ユニットはまず上に英語の用例（1〜2行）を置いてあります。<strong class="text-[var(--c-text)]">先に英語を音で追い、行のどこが学習対象かを確かめてから</strong>下の日本語解説に進むと、英語が苦手でも置いていかれません。マイクアイコンはそのリリックを歌うMC、▶は公式PVの該当箇所への頭出しリンク（音源解析で付与＋PVのイントロぶんを補正済み、秒数は概算）です。引用は解説に必要な最小限の断片だけに留めている。各ユニットには「語法 — どう使うか」欄（その表現が文中でどう機能するかの日本語解説）と、解説者が後から公式投稿（Instagram / X / YouTube）を貼れる埋め込みスロットを用意しています。
      </p>

      <!-- ① crime side / New York Times side -->
      <LearningUnit
        heading="crime side / New York Times side — 同音をぶつける言葉遊び"
        label="★ 言葉遊び"
        mc="Raekwon（Verse 1）"
        t={TS["crime-side"].t} tApprox={TS["crime-side"].approx} youtubeId={YT}
        embed=""
      >
        <Fragment slot="eng">I grew up on the crime side, the New York Times side<br />Stayin' alive was no jive</Fragment>
        <Fragment slot="jpn">犯罪が蔓延る側、（だが）ニューヨーク・タイムズ紙に載る側で育った／生き延びるのは、冗談ごとじゃなかった</Fragment>
        <p class="text-xs text-[var(--c-dim)] mb-1">▶ Verse 1のいちばん最初、Raekwonがこの曲世界の口火を切る一行目。</p>
        <p>まず上の一行を、声に出して追ってみてください。鍵は行の前半 <strong class="text-[var(--c-text)]">crime side</strong>（犯罪多発地域）と後半 <strong class="text-[var(--c-text)]">Times side</strong> ——ここで同じ「- side」の音が返ってくる。冒頭の一行にもう脚韻が仕込まれているんです。そのうえ後半の <strong class="text-[var(--c-text)]">New York Times</strong> が「権威ある新聞」と「自分の街＝ニューヨーク」のダブルミーニング。つまり「育った場所は、事件として新聞の三面記事に載るような街だった」を、固有名詞ひとつにギュッと畳んでいる。<code>- side</code> を韻の軸に据えるこの作り、まず音から入ると一気に腑に落ちます。</p>
      </LearningUnit>

      <!-- ② 'Lo goose -->
      <LearningUnit
        heading="'Lo goose — ブランド名がステータス語彙になる"
        label="★ スラング／文化"
        mc="Raekwon（Verse 1）"
        t={TS["lo-goose"].t} youtubeId={YT}
        embed=""
      >
        <Fragment slot="eng">So then we moved to Shaolin land<br />A young youth, yo, rockin' the gold tooth, <QuickSlang word="'Lo goose" desc="Polo Ralph Laurenのグースダウンジャケット。当時のゲットーにおける最高のステータスアイテム" /></Fragment>
        <Fragment slot="jpn">それで俺たちはシャオリン（＝スタテンアイランド）へ移った／血気盛んな若者、金歯を光らせ、ポロのダウンを着こなす</Fragment>
        <p class="text-xs text-[var(--c-dim)] mb-1">▶ Verse 1前半、Raekwonが少年時代の出で立ちを描く件。上は2行で、学習対象は下の行。</p>
        <p>上の行の<strong class="text-[var(--c-text)]">いちばん最後</strong>、「…rockin' the gold tooth, <strong class="text-[var(--c-text)]">'Lo goose</strong>」——この行末の <strong class="text-[var(--c-text)]">'Lo goose</strong> が学習ポイントです。<strong class="text-[var(--c-text)]">'Lo</strong> は Polo（Ralph Lauren）の略、<strong class="text-[var(--c-text)]">goose</strong> はグースダウン（羽毛）ジャケット。つなげて「'Lo goose」＝ポロのダウンジャケット。面白いのは、本来は白人富裕層の象徴だったラルフローレンを、万引き集団 <strong class="text-[var(--c-text)]">Lo-Lifes</strong> や麻薬資金で手に入れ、自分たちのステータス記号へ堂々と読み替えたゲットー文化が、この一語に丸ごと入っているところ。すぐ手前の <code>rockin'</code>（＝wearing、着こなす）も、AAVE的な動詞の使い方として一緒に覚えておきたい。</p>
        <Fragment slot="usage">
          <p><strong class="text-[var(--c-text)]">rock</strong> は「（服・靴・アクセサリーなどを）かっこよく身につける／着こなす」という他動詞。<code>rock + 名詞</code>の形で使い、単に着る（wear）よりも「それを堂々と見せびらかす・似合っている」というニュアンスが乗る。例: <em>rock a gold chain</em>（金のチェーンをキメる）、<em>rock those sneakers</em>（あのスニーカーを履きこなす）。進行形 <code>rockin'</code> で「今まさに着こなしている」状態を表す。</p>
          <p>ブランド名を短縮した <strong class="text-[var(--c-text)]">'Lo</strong>（＝Polo）のように、ヒップホップでは固有名詞を切り詰めてスラング化するのが定石。リスナーが元を補完できる前提で、語感とリズムを優先して縮める。</p>
        </Fragment>
      </LearningUnit>

      <!-- ③ G off -->
      <LearningUnit
        heading="G off — 一語に三つの意味を畳む（トリプルエンタンドル）"
        label="★ 言葉遊び（最重要）"
        mc="Raekwon（Verse 1）"
        t={TS["g-off"].t} youtubeId={YT}
        embed=""
      >
        <Fragment slot="eng">A young youth, yo, rockin' the gold tooth, 'Lo goose<br />Only way I begin to <QuickSlang word="G off" desc="①Get off（成功する・抜け出す）②Gangstaとして動く③G（Grand=1000ドル）を稼ぐ、のトリプルミーニング" /> was drug loot</Fragment>
        <Fragment slot="jpn">血気盛んな若者、金歯を光らせ、ポロのダウン／のし上がる唯一の方法は、麻薬の稼ぎしかなかった</Fragment>
        <p class="text-xs text-[var(--c-dim)] mb-1">▶ Verse 1前半、②「'Lo goose」のすぐ次の行。Raekwonが"のし上がる道"を語る件。学習対象は下の行。</p>
        <p>上の行の真ん中、「Only way I begin to <strong class="text-[var(--c-text)]">G off</strong> was drug loot」——この <strong class="text-[var(--c-text)]">G off</strong> の二語が、この曲いちばんの仕掛けです。ここに三つの意味が同時に通っている。①<em>get off</em>＝ゲットーを抜け出す／成功する、②<em>gangsta</em> として動く、③<em>G（grand＝1,000ドル）</em>を稼ぐ。たった2語で三重に読める。Geniusでも「12音節のトリプルエンタンドル」として知られる箇所で、初めて気づくとちょっと鳥肌が立ちます。行末の <code>loot</code>（戦利品・金）も、ストリート語彙の定番なので押さえておきたい。</p>
        <Fragment slot="usage">
          <p>核になる <strong class="text-[var(--c-text)]">get off</strong> は句動詞で、文脈により意味が振れる多義語。ここでは「（厳しい環境から）抜け出す・うまくいく」の意で使われている。<code>get off + (the streets / the block)</code> なら「ストリートから足を洗う」、文末で単独だと「成功する・キマる」。聞き手は前後関係から意味を選び取る——その<strong class="text-[var(--c-text)]">どれにも取れる曖昧さ</strong>こそ、ここでは <em>gangsta として動く</em>・<em>G（=1,000ドル）を稼ぐ</em> の読みも同時に走らせる仕掛けになっている。</p>
          <p>学習上のコツ: 句動詞は「動詞＋前置詞/副詞」を1セットの意味として丸ごと覚える。get off を「get＋off」と分解せず、「抜け出す」という1語の感覚で蓄えると、リスニングで瞬時に取れる。</p>
        </Fragment>
      </LearningUnit>

      <!-- ④ runnin' up in gates / woolies -->
      <LearningUnit
        heading="runnin' up in gates — 句動詞＋名詞スラングで情景を圧縮"
        label="★ スラング／句動詞"
        mc="Raekwon（Verse 1）"
        t={TS["runnin-up-gates"].t} youtubeId={YT}
        embed=""
      >
        <Fragment slot="eng">Started smokin' <QuickSlang word="woolies" desc="マリファナにコカインやクラックを混ぜた非常に危険なジョイント" /> at sixteen / And runnin' up in <QuickSlang word="gates" desc="ドラッグの売買拠点（トラップハウス）。武装強盗で突入する行為が「runnin' up in gates」" /></Fragment>
        <Fragment slot="jpn">16歳でウーリーズを吸い始め／売人のアジトに押し入っていた</Fragment>
        <p class="text-xs text-[var(--c-dim)] mb-1">▶ Verse 1中盤、Raekwonが16歳からの薬物と強盗の日々を語り出す件。</p>
        <p>上は2行あります。学習ポイントは<strong class="text-[var(--c-text)]">下の行</strong>「And <strong class="text-[var(--c-text)]">runnin' up in gates</strong>」。句動詞 <strong class="text-[var(--c-text)]">run up in ~</strong>（～に押し入る・襲撃する）に、スラング <strong class="text-[var(--c-text)]">gates</strong>（ドラッグ売買拠点＝トラップハウス）が組み合わさり、武装強盗という最もリスクの高い行為がわずか数語に圧縮されています。上の行に出てくる <strong class="text-[var(--c-text)]">woolies</strong> は、マリファナにコカイン／クラックを混ぜた危険なジョイント。こういう固有のスラングは、知らないと字面を追っても意味が取れない——でも逆に、ここさえ分かれば一気に情景が立ち上がる。スラング学習のいちばん面白いところです。</p>
        <Fragment slot="usage">
          <p><strong class="text-[var(--c-text)]">run up in ~</strong> は「～に（突然・強引に）押し入る、踏み込む」を表す句動詞。<code>up</code> が「勢いよく接近する」、<code>in</code> が「中へ」を担い、二つ合わさって「ガサ入れのように突入する」という荒々しい含意になる。目的語には場所（a spot, the gates, the crib）を取り、<em>run up in the spot</em> のように使う。標準英語の <em>break into</em> より口語的・攻撃的。</p>
          <p>進行形 <code>runnin' up in ~</code> は「常習的にそれをやっていた」という反復・習慣のニュアンス。過去の生活を語るヴァースで多用される時制感覚だ。</p>
        </Fragment>
      </LearningUnit>

      <!-- ⑤ keys from across seas -->
      <LearningUnit
        heading="Catchin' keys from across seas — 過去と未来を貫くダブルミーニング"
