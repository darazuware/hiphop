---
import LearningUnit from '../../components/LearningUnit.astro';
import DiveCards from '../../components/DiveCards.astro';
import QuickSlang from '../../components/QuickSlang.astro';
import AmazonMusicReference from '../../components/AmazonMusicReference.astro';
import SongLayout from '../../layouts/SongLayout.astro';
import { songs } from '../../data/songs';
const record = songs.find(song => song.slug === '/songs/93-til-infinity')!;
const recordAmazon = `https://www.amazon.co.jp/s?k=${encodeURIComponent(record.artists + ' ' + record.album)}&i=music&tag=wax1124-22`;
const recordMercari = `https://jp.mercari.com/search?keyword=${encodeURIComponent(record.artists + ' ' + record.album)}&afid=3150124771`;

const mauiStay = 'https://hb.afl.rakuten.co.jp/hgc/5852bc79.f9142da9.5852bc7a.df572a4b/?pc=https%3A%2F%2Ftravel.rakuten.co.jp%2FHOTEL%2F148254%2F148254.html&link_type=text&ut=eyJwYWdlIjoidXJsIiwidHlwZSI6InRleHQiLCJjb2wiOjF9';

const contextProducts = {
  forty: { query: 'Olde English 800', mercariLabel: 'メルカリで関連品を探す' },
  timbs: { query: 'Timberland ブーツ ブラック', mercariLabel: 'メルカリで探す' },
};
const contextAmazon = (query: string) => `https://www.amazon.co.jp/s?k=${encodeURIComponent(query)}&tag=wax1124-22`;
const contextMercari = (query: string) => `https://jp.mercari.com/search?keyword=${encodeURIComponent(query)}&afid=3150124771`;

// 学習ユニットのPVタイムスタンプ。agent/src/extract-unit-timestamps.mjs で album音源を
// whisper単語アライメントして取得（whisperSec）し、運営者の実測値があれば manualSec が
// 上書きする二層構造。詳細は docs/timestamp-override.md。approx=true は概算（未実測）。
import tsData from '../../../agent/93-til-infinity/assets/units-timestamps.json';
const YT = "fXJc2NYwHjw";
const TS = Object.fromEntries(tsData.map((u) => [u.id, { t: u.t, approx: u.approx }]));
---

<SongLayout
  title="93 'Til Infinity 和訳・意味・スラング解説 | Souls of Mischief"
  description="93 'Til Infinityのタイトルの意味と、Souls of Mischiefの4人が描くチルな日常を解説。25の表現を和訳・スラング解説とPV頭出しで読み解き、Billy Cobham「Heather」を使ったビートの元ネタにも触れます。全歌詞の対訳ではなく、引用断片に和訳を添えた解説記事です。"
  slug="93-til-infinity"
  highlights={[
    '93 \'Til Infinityはオークランドの若者の「チル」を描いた西海岸ゴールデンエラの定番曲',
    'スラング・韻・言葉遊び・AAVEを「学ぶ表現」単位で解説（PV頭出しリンク付き）',
    'A-PlusがBilly Cobham「Heather」を刻んだ、まどろむようなジャジーループ',
  ]}
  youtubeId="fXJc2NYwHjw"
  sampleYoutubeId="l7Q-JfAV2xk"
  sampleTitle="Billy Cobham - Heather"
  sampleInContent={true}
  learningPage={true}
  songDuration={286}
>

    <section slot="record" id="record-summary" aria-label="作品情報" class="record-summary">
      <a href={recordAmazon} target="_blank" rel="noopener sponsored nofollow" aria-label={`${record.album}をAmazonで探す [PR]`}
        data-affiliate-merchant="amazon" data-affiliate-item={record.album} data-affiliate-position="song-cover">
        <img src="/images/covers/93-til-infinity.jpg" alt={`${record.album}のアルバムジャケット`} width="192" height="192" fetchpriority="high" />
        <span class="record-pr">Amazonで探す → [PR]</span>
      </a>
      <div class="record-info">
        <dl>
          <dt>アーティスト</dt><dd>{record.artists}</dd>
          <dt>リリース</dt><dd>1993年</dd>
          <dt>アルバム</dt><dd>{record.album}</dd>
          <dt>プロデュース</dt><dd>{record.producer}</dd>
          <dt>エリア / BPM</dt><dd>Oakland / {record.bpm}</dd>
        </dl>
        <a href={recordMercari} target="_blank" rel="noopener sponsored nofollow" data-affiliate-merchant="mercari" data-affiliate-item={record.album} data-affiliate-position="r103-record-mercari" class="record-pr">メルカリで盤を探す → [PR]</a>
      </div>
    </section>

    <section slot="intro" id="reading-start" aria-labelledby="reading-start-title" class="mb-5">
      <h2 id="reading-start-title" class="text-base font-semibold mb-2">「チルする」の中身を、4人が見せてくれる</h2>
      <div class="space-y-3 text-sm text-[var(--c-muted)] leading-relaxed">
        <p>「93 'Til Infinity」は「1993年から、<br />
ずっと」という意味。<br />
<code>'til</code> は until（〜まで）の短縮形、<br />
<code>infinity</code> は「無限」です。</p>
        <p>友達とくつろぐ、<br />
服や靴を選ぶ。<br />
4人の短いバースから、<br />
チルな日常が見えてきます。</p>
      </div>
      <nav aria-label="この曲を読む3つの入口" class="mt-4 grid gap-2 sm:grid-cols-3">
        <a href="#story" class="block rounded-lg border border-[var(--c-border)] bg-[var(--c-surface)] p-3 hover:border-[var(--c-gold)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--c-gold)]">
          <span class="block text-sm font-semibold text-[var(--c-gold)]">曲全体の意味 →</span>
          <span class="block mt-1 text-xs text-[var(--c-muted)]">4人が描く、チルな日常</span>
        </a>
        <a href="#units" class="block rounded-lg border border-[var(--c-border)] bg-[var(--c-surface)] p-3 hover:border-[var(--c-gold)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--c-gold)]">
          <span class="block text-sm font-semibold text-[var(--c-gold)]">和訳つき表現 →</span>
          <span class="block mt-1 text-xs text-[var(--c-muted)]">スラング・韻など25の解説</span>
        </a>
        <a href="#behind" class="block rounded-lg border border-[var(--c-border)] bg-[var(--c-surface)] p-3 hover:border-[var(--c-gold)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--c-gold)]">
          <span class="block text-sm font-semibold text-[var(--c-gold)]">ビートの元ネタ →</span>
          <span class="block mt-1 text-xs text-[var(--c-muted)]">Billy Cobham「Heather」</span>
        </a>
      </nav>
      <p class="mt-3 text-xs text-[var(--c-dim)]">引用した短い用例に和訳を添え、<br />
意味や使い方を解説しています。<br />
全歌詞の対訳は掲載していません。</p>
    </section>

    <div id="song-reading-body">
    <!-- Table of Contents -->
    <nav id="article-toc" aria-label="記事の目次" tabindex="-1" class="mb-10 scroll-mt-40 p-4 bg-[var(--c-surface)] border border-[var(--c-border)] rounded-lg">
      <p class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-3">目次</p>
      <ol class="space-y-1.5 text-sm text-[var(--c-muted)] list-none">
        <li><a href="#story" class="hover:text-[var(--c-gold)] transition-colors">01 — ストーリーの流れ（まず曲全体をつかむ）</a></li>
        <li><a href="#units" class="hover:text-[var(--c-gold)] transition-colors">02 — 学ぶ表現（スラング・韻・言葉遊び・AAVE）</a></li>
        <li><a href="#background" class="hover:text-[var(--c-gold)] transition-colors">03 — 文化的背景</a></li>
        <li><a href="#behind" class="hover:text-[var(--c-gold)] transition-colors">04 — サンプル・制作の裏側</a></li>
        <li><a href="#legacy" class="hover:text-[var(--c-gold)] transition-colors">05 — 評価とその後の影響</a></li>
      </ol>
    </nav>

    <a href="#article-toc" class="toc-return">↑ 目次に戻る</a>

    <!-- ストーリー -->
    <section id="story" class="mb-12 scroll-mt-40">
      <h2 class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-5 border-b border-[var(--c-border)] pb-2">
        ストーリーの流れ — まず曲全体をつかむ
      </h2>
      <p class="text-xs text-[var(--c-dim)] mb-5">この曲は物語というより、<br />
4人のMCが順番にマイクを回して「自分のチルの流儀」を見せ合う、<br />
リレー形式のポッセカット（大人数の曲）です。<br />
誰が何を担当しているかをざっくり押さえると、<br />
次章で一語ずつ掘るときに楽になります。</p>
      <div class="space-y-4 text-sm text-[var(--c-muted)] leading-relaxed">
        <p><strong class="text-[var(--c-text)]">Intro（Tajai）</strong>では、<br />
East Oaklandから来た4人を紹介。<br />
スタジオで maxin'（くつろいでいる）という、<br />
録音中の様子から始まります。</p>
        <p><strong class="text-[var(--c-text)]">Verse 1〜4</strong>は、<br />
Opio → A-Plus → Tajai → Phesto と短く回していきます。<br />
電話で女の子を誘い、<br />
40オンスの酒を冷やし、<br />
葉っぱでマウイ気分になり、<br />
映画とデートの段取りを立てる、<br />
という流れです。</p>
        <p>要は週末の過ごし方。<br />
カリフォルニアの陽気な空気がそのまま音になっています。</p>
        <p><strong class="text-[var(--c-text)]">Chorus</strong>の「This is how we chill from '93 'til」が、<br />
曲全体の合言葉。<br />
<em>'til</em> の後ろの <em>infinity</em>（無限に）が省略されていて、<br />
タイトルと響き合う作りです。</p>
        <p><strong class="text-[var(--c-text)]">後半（Verse 5〜12）</strong>では、<br />
スニーカーや服へのこだわり、<br />
フリースタイルの腕自慢、<br />
クルーの結束、<br />
そしてオークランド（the Land）への愛着が語られています。<br />
最後のアウトロでは Hieroglyphics の仲間（Casual、<br />
Del the Funky Homosapien ら）の名前を次々に呼んでいきます。</p>



      </div>
    </section>

<figure class="context-photo" id="photo-oakland-aerial">
          <img src="/images/context/93-til-infinity/oakland-aerial.jpg" alt="丘陵の住宅地と市街地、湾を上空から見たオークランド" width="1280" height="853" style="max-width: 660.26px" loading="lazy" decoding="async" />
          <figcaption>上空から見たオークランド。丘陵の住宅地から市街地、サンフランシスコ湾へ続いています（2022年撮影）。<small><a href="https://commons.wikimedia.org/wiki/File:Aerial_view_of_Oakland_CA_August_2022.jpg" target="_blank" rel="noopener noreferrer">写真：4300streetcar</a> · <a href="https://creativecommons.org/licenses/by/4.0" target="_blank" rel="noopener noreferrer">CC BY 4.0</a></small></figcaption>
        </figure>

    <!-- 学習ユニット -->
    <div id="units" class="scroll-mt-40"></div>
    <section class="mb-12">
      <h2 class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-2 border-b border-[var(--c-border)] pb-2">
        学ぶ表現 — スラング・韻・言葉遊び・AAVE
      </h2>
      <p class="text-xs text-[var(--c-dim)] mb-6">見出しの表現を、<br />
和訳とスラング・文法の解説で読み解きます。</p>
      <p class="text-xs text-[var(--c-dim)] mb-6">▶でPVの該当箇所へ飛べます。</p>


      <!-- ① chill / from '93 'til -->
      <LearningUnit
        heading="This is how we chill from '93 'til — 省略のきいたタイトルフレーズ"
        label="★ 構文／スラング"
        mc="Souls of Mischief（Chorus）"
        t={TS["chill-93-til"].t} tApprox={TS["chill-93-til"].approx} youtubeId={YT}
        embed=""
      >
        <Fragment slot="eng">This is how we chill from '93 'til<br />This is how we chill from '93 'til</Fragment>
        <Fragment slot="jpn">これが俺たちの過ごし方、'93から（ずっと）／これが俺たちの過ごし方、'93から</Fragment>
        <p class="text-xs text-[var(--c-dim)] mb-1">▶ 各バースの合間に繰り返されるフック。曲名そのものです。</p>
        <p>まずキーワードの <strong class="text-[var(--c-text)]"><QuickSlang word="chill" desc="リラックスする・のんびり過ごす・たむろする。最重要の日常スラング" /></strong>。<br />
「リラックスする・だらだら過ごす・たむろする」という、<br />
今でも超頻出の日常スラングです。</p>
        <p>日本でもいつの間にか「カフェでチルする」「シーシャで一服してチルする」みたいに、<br />
くつろぐ意味でそのまま使われるようになりましたよね。</p>
        <p>そして学習ポイントは行末 <strong class="text-[var(--c-text)]">from '93 'til</strong>。<br />
これは <code>from 1993 'til infinity</code>（1993年から永遠に）の <strong class="text-[var(--c-text)]">infinity を省略した</strong>言い回しで、<br />
曲名「93 'Til Infinity」と響き合っています。</p>
        <p><code>'til</code> は <em>until</em>（〜まで）の短縮。<br />
後ろの目的語をあえて言い切らずに余韻で残す、<br />
この<strong class="text-[var(--c-text)]">省略の感覚</strong>が、<br />
口語のリズムを作っています。</p>
        <p>「俺たちのチルは'93から、<br />
この先ずっと変わらない」という宣言が、<br />
たった数語に畳まれています。</p>
        <Fragment slot="usage">
          <p><strong class="text-[var(--c-text)]">chill</strong> は動詞・形容詞・間投詞すべてで使える万能スラング。<em>I'm just chillin'</em>（ただまったりしてる）、<em>a chill spot</em>（くつろげる場所）、<em>Chill!</em>（落ち着け！</p>
          <p>）。NYの <em>lamp</em> と同義だが、chill の方が全国区で通じる。</p>
          <p><strong class="text-[var(--c-text)]">'til</strong> は <em>until / till</em> の口語短縮。<em>from A 'til B</em>（AからBまで）の形で使い、ここでは B（infinity）を省いて余韻にしている。</p>
          <p>会話でも <em>'til then</em>（それまで）のように頻出。</p>
        </Fragment>
      </LearningUnit>

      <!-- intro maxin -->
      <LearningUnit
        heading="I'm chillin' with my man Phesto — 自己紹介から始まるイントロ"
        label="★ 構成／スラング"
        mc="Tajai（Intro）"
        t={TS["intro-maxin"].t} tApprox={TS["intro-maxin"].approx} youtubeId={YT}
        embed=""
      >
        <p class="text-xs text-[var(--c-dim)] mb-1">▶ 曲の口火を切るイントロ。Tajaiがメンバーを紹介するくだり。</p>

        <p>曲はTajaiの語りかけから始まります。<br />
PhestoやOpioの名前を挙げ、<br />
スタジオにいる仲間を紹介していく。</p>

        <p>ここで学習ポイントは <strong class="text-[var(--c-text)]"><QuickSlang word="my man" desc="my man＝相棒・仲間。親しい男friend への呼びかけ・言及に使う定番の口語" /></strong>（マイ・マン）という言い方。</p>
        <p>「俺の相棒」という意味で、<br />
親しい仲間を指すときの超定番の口語です。<br />
<code>my man Phesto</code> のように、<br />
名前の前にそのまま付けて使えます。</p>
        <p>この曲のキー動詞 <strong class="text-[var(--c-text)]">maxin'</strong>（だらける・くつろぐ）も、<br />
このイントロで顔を出します。<br />
何をするでもなくスタジオでまったりしている、<br />
その温度感の紹介から入るのが、<br />
いかにもこの曲らしい始まり方だと思います。</p>
      </LearningUnit>

      <!-- intro cloudy -->
      <LearningUnit
        heading="sometimes it gets a little cloudy — 天気に見せかけた煙の描写"
        label="★ 言葉遊び"
        mc="Tajai（Intro）"
        t={TS["intro-cloudy"].t} tApprox={TS["intro-cloudy"].approx} youtubeId={YT}
        embed=""
      >
        <p class="text-xs text-[var(--c-dim)] mb-1">▶ イントロの後半、部屋の様子を語るくだり。</p>
        <p>イントロの終盤で、<br />
Tajaiが「ときどき、<br />
ちょっと <strong class="text-[var(--c-text)]">cloudy</strong>（曇ってくる）」と言います。<br />
学習ポイントはこの <strong class="text-[var(--c-text)]">cloudy</strong> の使い方。</p>
        <p>文字どおりなら「曇り空」ですが、<br />
ここは天気の話ではありません。<br />
部屋にこもった葉っぱの煙で視界が白くかすむ様子を、<br />
<strong class="text-[var(--c-text)]">天気の言葉に見せかけて言い換えている</strong>わけです。</p>
        <p>直接的な言葉を避けて情景だけ置く、<br />
この曲の抜けた品の良さがよく出ています。</p>
        <p>この「直接言わずに近い日常語で匂わせる」やり方は、<br />
あとの Good Vibrations（グッド・ヴァイブレーション）や indo（上物の葉っぱ）のくだりにもつながっていきます。<br />
イントロの時点で、<br />
もう曲全体のトーンが決まっています。</p>
      </LearningUnit>

      <!-- v1 seven digits -->
      <LearningUnit
        heading="Dial the seven digits — 「番号を回す」電話まわりの口語"
        label="★ 口語表現"
        mc="Opio（Verse 1）"
        t={TS["v1-seven-digits"].t} tApprox={TS["v1-seven-digits"].approx} youtubeId={YT}
        embed=""
      >
        <Fragment slot="eng">Dial the seven digits, call up</Fragment>
        <Fragment slot="jpn">7桁の番号を回して、電話をかける</Fragment>
        <p class="text-xs text-[var(--c-dim)] mb-1">▶ Verse 1（Opio）の頭、女の子に電話するところから週末が動き出すくだり。</p>
        <p>Opioのバースは、<br />
電話をかける場面から始まります。<br />
学習ポイントは <strong class="text-[var(--c-text)]">dial the seven digits</strong>。</p>
        <p><code>dial</code> は「（電話の番号を）回す・押す」という動詞で、<br />
いまはスマホでも <em>dial a number</em> とそのまま使います。</p>
        <p>面白いのは <strong class="text-[var(--c-text)]">seven digits</strong>（7桁）という言い方。<br />
市外局番を省いた市内通話の電話番号がちょうど7桁で、<br />
「近所の子に電話する」という距離感まで数字が語っています。</p>
        <p>1993年の、<br />
固定電話に番号を打ち込む手触りがそのまま残った一句です。</p>
        <p><code>call up</code>（電話をかける）の <strong class="text-[var(--c-text)]">up</strong> は「相手に連絡を取る」を締める副詞。<br />
<em>call up a friend</em> のように、<br />
日常会話でもそのまま使えます。</p>

      </LearningUnit>

      <!-- ② 40 / stoge -->
      <LearningUnit
        heading="Here's a 40 — swig it! / the fattest stoge — 週末のチル語彙"
        label="★ スラング"
        mc="Opio（Verse 1）"
        t={TS["forty-stoge"].t} tApprox={TS["forty-stoge"].approx} youtubeId={YT}
        embed=""
      >
        <Fragment slot="eng">Here's a 40 — swig it! You know it's frigid<br />Damn! That's the fattest stoge I ever seen</Fragment>
        <Fragment slot="jpn">ほら40（オンスの酒）だ、グイっといけ！キンキンに冷えてる／うわ！こんなにぶっといブラント、見たことない</Fragment>
        <p class="text-xs text-[var(--c-dim)] mb-1">▶ Verse 1（Opio）中盤、週末の小道具が並ぶくだり。スラングが3つ。</p>
        <p><strong class="text-[var(--c-text)]"><QuickSlang word="40" desc="40オンス（約1.2L）入りのモルトリカー（麦芽酒）。ストリートの定番" /></strong> は、<br />
40オンス入りの麦芽酒（モルトリカー）のこと。<br />
ボトルの容量を、<br />
そのまま酒の呼び名にしています。</p>
        <figure class="context-photo" id="photo-forty" data-image-source="user-provided">
          <a href={contextAmazon(contextProducts.forty.query)} target="_blank" rel="noopener sponsored nofollow"
            data-affiliate-merchant="amazon" data-affiliate-item={contextProducts.forty.query} data-affiliate-position="r103-forty-photo">
            <img src="/images/context/93-til-infinity/forty-user.jpg" alt="Olde English 800の40オンスボトルと、ボトルが写った集合写真" width="1280" height="772" style="max-width: 729.53px" loading="lazy" decoding="async" />
          </a>
          <figcaption>40オンスのOlde English 800。右側の写真にも、同じボトルが写っています。</figcaption>
          <div class="context-purchase" aria-label="Olde English 800を探す">
            <a href={contextAmazon(contextProducts.forty.query)} target="_blank" rel="noopener sponsored nofollow"
              data-affiliate-merchant="amazon" data-affiliate-item={contextProducts.forty.query} data-affiliate-position="r103-forty-amazon">Amazonで探す → [PR]</a>
            <a href={contextMercari(contextProducts.forty.query)} target="_blank" rel="noopener sponsored nofollow"
