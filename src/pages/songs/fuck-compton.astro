      <!-- ④d step-to -->
      <LearningUnit
        heading="step to — 「喧嘩を売る・向かってくる」という動詞句"
        label="★ スラング"
        mc="Tim Dog（Verse 2）"
        t={TS["step-to"].t} tApprox={TS["step-to"].approx} youtubeId={YT}
