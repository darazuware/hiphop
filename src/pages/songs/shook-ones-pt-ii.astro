    <!-- 評価と影響 -->
    <section id="legacy" class="mb-12">
      <h2 class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-5 border-b border-[var(--c-border)] pb-2">
        評価とその後の影響
      </h2>

      <div class="mb-4 overflow-hidden border-2 border-[var(--c-orange)] text-sm" style="border-radius:0">
        <div class="grid grid-cols-3 bg-[var(--c-bg)] text-[var(--c-very-dim)] text-xs uppercase tracking-widest">
          <div class="p-3 border-b border-[var(--c-border)]">指標</div>
          <div class="p-3 border-b border-l border-[var(--c-border)]">記録</div>
          <div class="p-3 border-b border-l border-[var(--c-border)]">意義</div>
        </div>
        {[
          ['アルバム「The Infamous」', 'Billboard 200 最高3位（1995年）', 'ハードコアNYヒップホップがメインストリームのチャート頂点圏に到達したことを証明した'],
          ['8 Mile（映画・2002年）', '冒頭のラップバトルシーンで使用', 'Eminemがバトルの相手の出だしを潰すために使ったビートとして世界的に知名度が広がった'],
          ['影響と引用', '後世への無数の引用', '"halfway crooks" という概念はヒップホップの価値観の語彙として定着。"shook one" も侮辱語として生き続けている'],
        ].map(([metric, record, significance]) => (
