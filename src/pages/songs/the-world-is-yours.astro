            ['lampin\'', 'くつろぐ、だらっと過ごす'],
            ['Big Willie', '羽振りのいい大物、成金'],
            ['profile', '見せびらかす、かっこつける'],
            ['loot / fly', 'お金／かっこいい'],
            ['shout-out', '名前を挙げてのあいさつ、感謝'],
          ].map(([w, d]) => (
            <div class="text-sm">
              <span class="font-semibold text-[var(--c-text)]">{w}</span>
