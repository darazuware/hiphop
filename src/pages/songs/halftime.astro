      </LearningUnit>

      <LearningUnit
        heading="Nas ain't all that 「大したことない」の言い方"
        label="★ スラング"
        mc="Nas（Verse 2）"
        t={TS["aint-all-that"].t} tApprox={TS["aint-all-that"].approx} youtubeId={YT}
