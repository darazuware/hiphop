---
import LyricsBlock from '../../components/LyricsBlock.astro';
import QuickSlang from '../../components/QuickSlang.astro';
import SongLayout from '../../layouts/SongLayout.astro';
import AmazonAlbumCta from "../../components/AmazonAlbumCta.astro";
---

<SongLayout
  title="The 1st Time 和訳・意味・スラング解説 | Jamo Gang"
  description="Jamo Gang「The 1st Time」の歌詞和訳とスラング徹底解説。DJ Premierプロデュース、Ras Kass・El Gant・J57にSlug（Atmosphere）が客演。2020年インディー・ブーンバップの傑作を徹底解説。"
  slug="the-1st-time"
  youtubeId="w-BckT8oSrw"
  highlights={[
    'DJ Premierがプロデュース——プレミアのスタジオで「偶然」生まれたコラボの経緯',
    'Slug（Atmosphere）を客演に迎えた「DJ Premier × Slug」という夢のコラボが初実現',
    'Ras Kass（LA）、El Gant・J57（NY）、Slug（Minneapolis）——地域を超えた東西中西部の連帯',
  ]}
>

  <!-- この曲の意味 -->
  <section class="mb-6">
    <h2 class="text-base font-semibold mb-2">■この曲の意味（要約）</h2>
    <p class="text-sm text-[var(--c-muted)] leading-relaxed">2020年リリースのJamo Gang EP収録曲。Jamo Gangは西海岸のRas Kass、ニューヨークのEl GantとJ57によるスーパーグループ。DJ Premierのスタジオでの偶然のセッションから生まれたこの曲は、各MCが独自の視点でリリシズム・スキルへの誇り、ストリートの現実、そして人生の皮肉を描く。タイトル「The 1st Time」はRefrain「And I said it the first time（初めに言ったはずだ）」から来ており、自分の言葉の真実性と一貫性への宣言を象徴する。</p>
  </section>

  <!-- 概要 -->
  <section class="mb-6">
    <h2 class="text-base font-semibold mb-2">■概要</h2>
    <p class="text-sm text-[var(--c-muted)] leading-relaxed">2020年リリース。プロデュースはDJ Premier。Ras Kass（カリフォルニア州ラスカンジュラス出身）、El Gant（ニューヨーク）、J57（ニューヨーク）の3MCグループJamo Gangに、Atmosphere（ミネアポリス）のSlugが客演参加。DJ Premierのスタジオでのセッション中に生まれた楽曲で、J57がアトランタのAtmosphereライブ後にSlugへ客演を依頼したことで実現。ミュージックビデオはJ57が監督を務め、DJ PremierとSlugも出演した。BPMは約90のミッドテンポ・ブーンバップ。</p>
  </section>

  <!-- 導入 -->
  <section class="mb-10">
    <h2 class="text-base font-semibold mb-2">■導入（制作背景）</h2>
    <p class="text-sm text-[var(--c-muted)] leading-relaxed">Jamo Gangの3人がDJ Premierのスタジオを訪れた際、Premierが未発表のビートを披露。El Gantがその場で「このビートで録らせてくれ」と直談判し、Premierは「基準に達しなければ出さない」という条件で承諾した。その後J57がアトランタのAtmosphereライブに足を運び、終演後にSlugを客演へ誘い快諾を得た。J57にとってこの曲は「非常に大きな意味を持つ」作品であり、地域・世代を超えたヒップホップの連帯を体現している。</p>
  </section>

  <!-- Table of Contents -->
  <nav class="mb-10 p-4 bg-[var(--c-surface)] border border-[var(--c-border)] rounded-lg">
    <p class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-3">目次</p>
    <ol class="space-y-1.5 text-sm text-[var(--c-muted)] list-none">
      <li><a href="#lyrics" class="hover:text-[var(--c-gold)] transition-colors">01 — 歌詞和訳と意味解説</a></li>
      <li><a href="#background" class="hover:text-[var(--c-gold)] transition-colors">02 — 文化的背景</a></li>
      <li><a href="#behind" class="hover:text-[var(--c-gold)] transition-colors">03 — 制作の裏側</a></li>
      <li><a href="#legacy" class="hover:text-[var(--c-gold)] transition-colors">04 — 評価とその後の影響</a></li>
    </ol>
  </nav>

  <div id="lyrics"></div>

  <!-- ===================== -->
  <!-- INTRO                 -->
  <!-- ===================== -->
  <AmazonAlbumCta query="Jamo Gang The 1st Time" cover="/images/covers/the-1st-time.jpg" title="The 1st Time / Jamo Gang EP" artist="Jamo Gang" />

</SongLayout>
