---
import LearningUnit from '../../components/LearningUnit.astro';
import DiveCards from '../../components/DiveCards.astro';
import QuickSlang from '../../components/QuickSlang.astro';
import SongLayout from '../../layouts/SongLayout.astro';
import MercariCta from '../../components/MercariCta.astro';
const recordAmazon = `https://www.amazon.co.jp/s?k=${encodeURIComponent('Nas Illmatic')}&i=music&tag=wax1124-22`;

// 公式音源の頭出しは11件ともfallback由来の推定値。運営者実測・字幕照合は未確認。
import tsData from '../../../agent/ny-state-of-mind/assets/units-timestamps.json';
const YT = "hI8A14Qcv68";
const TS = Object.fromEntries(tsData.map((u) => [u.id, { t: u.t, approx: u.approx }]));
---

<SongLayout
  title="N.Y. State of Mind 和訳・意味・スラング解説 | Nas（Illmatic）"
  description="N.Y. State of Mindの意味と、Nasが描くクイーンズブリッジの日常を解説。11の表現を和訳・スラング・AAVE文法で読み解き、DJ Premierのサンプル元と制作背景も紹介。公式音源の頭出しは推定位置を明示しています。"
  slug="ny-state-of-mind"
  highlights={[
    '曲名は「ニューヨークで生きる者の心の状態」。街の危険とラッパーとしての自負を描く',
    '11の表現を和訳・スラング・文法で解説（公式音源の頭出しは推定値）',
    'DJ Premierの不穏なピアノループとスクラッチ・フックの作り方',
  ]}
  youtubeId="hI8A14Qcv68"
  learningPage={true}
  songDuration={296}
>

    <section slot="record" id="record-summary" aria-label="作品情報" class="record-summary">
      <a href={recordAmazon} target="_blank" rel="noopener sponsored nofollow" aria-label="IllmaticをAmazonで探す [PR]"
        data-affiliate-merchant="amazon" data-affiliate-item="Nas Illmatic" data-affiliate-position="song-cover">
        <img src="/images/covers/ny-state-of-mind.jpg" alt="Nas『Illmatic』のアルバムジャケット" width="192" height="192" fetchpriority="high" />
        <span class="record-pr">Amazonで探す → [PR]</span>
      </a>
      <dl>
        <dt>アーティスト</dt><dd>Nas（ナズ）</dd>
        <dt>リリース</dt><dd>1994年</dd>
        <dt>アルバム</dt><dd>Illmatic · 2曲目</dd>
        <dt>プロデュース</dt><dd>DJ Premier</dd>
        <dt>舞台</dt><dd>NY・クイーンズブリッジ</dd>
      </dl>
    </section>

    <section slot="intro" id="reading-start" aria-labelledby="reading-start-title" class="mb-5">
      <h2 id="reading-start-title" class="text-base font-semibold mb-2">街で生き延びる緊張を、Nasの言葉から読む</h2>
      <div class="space-y-3 text-sm text-[var(--c-muted)] leading-relaxed">
        <p>「N.Y. State of Mind」は、<br />
直訳すると「ニューヨークの心の状態」。<br />
ここでは、<br />
危険と隣り合わせの街で生きるNasの警戒心や考え方として読むと、<br />
タイトルが腑に落ちます。</p>
        <p>銃撃の場面、<br />
酒や賭け事、<br />
ラッパーとしての自信。<br />
クイーンズブリッジの日常を、<br />
短い用例の和訳と11の表現解説から読み解きます。</p>
        <p>習慣を表す <code>be</code> の文法や、<br />
金額を人名で呼ぶスラングが分かると、<br />
Nasが何を見ているのかが具体的になります。</p>
      </div>
      <nav aria-label="この曲を読む3つの入口" class="reading-entries">
        <a href="#story"><strong>曲全体の意味 →</strong><span>2つのバースで描く街の光景</span></a>
        <a href="#units"><strong>和訳つき表現 →</strong><span>スラング・比喩・AAVE文法</span></a>
        <a href="#behind"><strong>ビートの元ネタ →</strong><span>ピアノとスクラッチの出所</span></a>
      </nav>
      <p class="mt-3 text-xs text-[var(--c-dim)]">解説に必要な短い用例に和訳を添えています。<br />
全歌詞の対訳は掲載していません。</p>
    </section>

    <div id="song-reading-body">
    <!-- Table of Contents -->
    <nav id="article-toc" aria-label="記事の目次" tabindex="-1" class="mb-10 scroll-mt-40 p-4 bg-[var(--c-surface)] border border-[var(--c-border)] rounded-lg">
      <p class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-3">目次</p>
      <ol class="space-y-1.5 text-sm text-[var(--c-muted)] list-none">
        <li><a href="#story" class="hover:text-[var(--c-gold)] transition-colors">01 — ストーリーの流れ（まず曲全体をつかむ）</a></li>
        <li><a href="#units" class="hover:text-[var(--c-gold)] transition-colors">02 — 学ぶ表現（スラング・韻・言葉遊び・AAVE）</a></li>
        <li><a href="#background" class="hover:text-[var(--c-gold)] transition-colors">03 — 文化的背景</a></li>
        <li><a href="#behind" class="hover:text-[var(--c-gold)] transition-colors">04 — サンプル・制作の裏側</a></li>
        <li><a href="#legacy" class="hover:text-[var(--c-gold)] transition-colors">05 — 評価とその後の影響</a></li>
        <li><a href="#listen-more" class="hover:text-[var(--c-gold)] transition-colors">06 · 収録盤を聴く・探す [PR]</a></li>
      </ol>
    </nav>

    <a href="#article-toc" class="toc-return">↑ 目次に戻る</a>

    <!-- ストーリー -->
    <section id="story" class="mb-12 scroll-mt-40">
      <h2 class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-5 border-b border-[var(--c-border)] pb-2">
        ストーリーの流れ — まず曲全体をつかむ
      </h2>
      <p class="text-xs text-[var(--c-dim)] mb-5">
        Nasは街の光景を、<br />
自分の視点から次々と語っています。<br />
ラップの腕自慢と危険な日常が、<br />
同じバースの中で行き来する曲です。
      </p>
      <div class="space-y-4 text-sm text-[var(--c-muted)] leading-relaxed">
        <p>
          <strong class="text-[var(--c-text)]">Intro</strong>。<br />
「straight out the fuckin' dungeons of rap（ラップの地下牢からまっすぐ出てきた）」という名乗りに続いて、<br />
Nasが「I don't know how to start this shit（どう始めればいいか分からない）」とつぶやきます。
        </p>
        <p>
          この迷いの一言がそのまま音源に残っているのが伝説です（詳細は「制作の裏側」で）。
        </p>
        <p>
          <strong class="text-[var(--c-text)]">Verse 1</strong>は、<br />
ラップの腕前の誇示から始まり、<br />
すぐに銃撃戦の生々しい一人称描写へ。<br />
MAC-10が草むらにあった、<br />
撃った、<br />
弾詰まりした、<br />
という極めて具体的な場面が、<br />
映画のワンシーンのように展開します。
        </p>
        <p>
          終盤、<br />
「sleep is the cousin of death（眠りは死の従兄弟）」という有名な一行で、<br />
常に気を張って生きるしかない緊張を凝縮し、<br />
タイトルの「New York State of Mind」へ着地します。
        </p>
        <p>
          <strong class="text-[var(--c-text)]">Chorus</strong>の「New York state of mind」は、<br />
実はNasの声ではなく、<strong class="text-[var(--c-text)]">RakimのバースをPremierがスクラッチで引用した</strong>もの。<br />
先輩MCの声を借りてフックにするのが渋いところです。
        </p>
        <p>
          <strong class="text-[var(--c-text)]">Verse 2</strong>は、<br />
ギャングスタの夢、<br />
投資とドラッグ売買、<br />
ラッパーとしての矜持が交錯します。<br />
「Life is parallel to Hell（人生は地獄と平行に走る）」という比喩や、<br />
自分のライムを「カプセルなしのビタミン」に喩える件など、<br />
危険な日常と言葉への自負が同居しています。
        </p>
        <p>
          銃撃の場面でも、<br />
Nasは弾詰まりや逃げる動きまで描いています。<br />
大きな言葉で危険を説明するより、<br />
こうした細部のほうが緊張を伝えてくれると思います。
        </p>
        <p class="text-xs text-[var(--c-dim)]">
          ※本ページは批評・教育目的で、<br />
解説に必要な範囲の断片のみを引用しています。<br />
全歌詞の対訳は掲載していません。
        </p>
      </div>
    </section>

    <!-- 学習ユニット -->
    <div id="units" class="scroll-mt-40"></div>
    <section class="mb-12">
      <h2 class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-2 border-b border-[var(--c-border)] pb-2">
        学ぶ表現 — スラング・韻・言葉遊び・AAVE
      </h2>
      <p class="text-xs text-[var(--c-dim)] mb-6">
        11の表現を、<br />
短い用例・和訳・日本語解説の順で読み解きます。</p>
      <p class="text-xs text-[var(--c-dim)] mb-6">AAVEはアフリカ系アメリカ人英語のこと。<br />
教科書の英語と違う形にも、<br />
意味を伝えるためのルールがあります。
      </p>
      <p class="text-xs text-[var(--c-dim)] mb-6">
        埋め込みはNas公式のフル音源（4分56秒）。</p>
<p class="text-xs text-[var(--c-dim)] mb-6">▶の「≈」は推定位置です。11か所とも字幕による照合・実測が済んでいないため、表現の始まりとずれる場合があります。
      </p>

      <!-- ① habitual be -->
      <LearningUnit
        heading="I be kickin' / Be havin' dreams — AAVEの習慣のbe（habitual be）"
        label="★ AAVE文法（最重要）"
        mc="Nas（Verse 1）"
        t={TS["habitual-be"].t} tApprox={TS["habitual-be"].approx} youtubeId={YT}
        embed=""
      >
        <Fragment slot="eng">Rappers: I monkey-flip 'em with the funky rhythm I be kickin'<br />Musician, inflictin' composition of pain</Fragment>
        <Fragment slot="jpn">ラッパーども、俺はファンキーなリズムでやつらをひっくり返す（いつもそうしてる）／痛みの作曲を浴びせるミュージシャンだ</Fragment>
        <p class="text-xs text-[var(--c-dim)] mb-1">▶ Verse 1のいちばん最初、曲の口火を切る一行。学習対象は行末。</p>
        <p>行末の「the funky rhythm <strong class="text-[var(--c-text)]">I be kickin'</strong>」に注目。<br />
標準英語なら <em>I'm kicking</em> か <em>I kick</em> ですが、<br />
ここは <strong class="text-[var(--c-text)]">be</strong> が原形のまま入っています。</p>
        <p>これがAAVE最大の特徴 <strong class="text-[var(--c-text)]">習慣のbe（habitual be）</strong>です。<br />
「いつも・習慣的に〜している」という反復のニュアンスを <code>be ＋ -ing</code> で表します。</p>
        <p>単なる現在進行（今やっている）ではなく「常日頃やっている」という時間幅が出るのがポイントです。</p>
        <p>Verse 2の頭でも <code>Be havin' dreams that I'm a gangsta</code>（いつもギャングスタの夢を見る）ともう一度出てきます。</p>
        <p>冒頭の <strong class="text-[var(--c-text)]"><QuickSlang word="monkey-flip" desc="相手を完全に圧倒する・ひっくり返すこと。レスリング/体操の技に由来するスラング" /></strong>（圧倒する）も覚えておきたいスラングです。</p>
        <Fragment slot="usage">
          <p><strong class="text-[var(--c-text)]">habitual be</strong> は、動詞 be を原形のまま使って「習慣的・反復的にそうである／そうしている」を表すAAVEの文法です。<em>He be working</em>＝「彼はいつも働いている（習慣）」。</p>
          <p>標準英語の <em>He is working</em>（今働いている）とは時間の幅が違います。</p>
          <p>見分け方: <code>主語 ＋ be ＋ 動詞-ing</code> で be が活用していない（am/is/are になっていない）ら、まず「いつも〜している」の習慣のbeを疑う。AAVEではこの be の有無で「今だけ」か「いつも」かを区別する、れっきとした時制表現です。</p>
        </Fragment>
      </LearningUnit>

      <!-- ② Scarface simile -->
      <LearningUnit
        heading="I'm like Scarface sniffin' cocaine — 映画の引用を直喩に畳む"
        label="★ 比喩／引用"
        mc="Nas（Verse 1）"
        t={TS["scarface-simile"].t} tApprox={TS["scarface-simile"].approx} youtubeId={YT}
        embed=""
      >
        <Fragment slot="eng">I'm like Scarface sniffin' cocaine<br />Holdin' an M16, see, with the pen I'm extreme</Fragment>
        <Fragment slot="jpn">俺はコカインを吸うスカーフェイスのようだ／M16を構え、見ろ、ペンを握れば俺は極端だ</Fragment>
        <p class="text-xs text-[var(--c-dim)] mb-1">▶ Verse 1前半、自分のラップの激しさを喩える件。学習対象は上の行。</p>
        <p>「I'm <strong class="text-[var(--c-text)]">like</strong> Scarface sniffin' cocaine」。<br />
直喩（<code>A is like B</code>）で、<br />
自分を映画『スカーフェイス』の主人公トニー・モンタナに重ねています。</p>
        <p><strong class="text-[var(--c-text)]">Scarface</strong> は1983年の同名映画の主人公で、<br />
ヒップホップでは「成り上がりと破滅」の象徴として無数に引用される名前です。</p>
        <p>下の行の <code>with the pen I'm extreme</code>（ペンを握れば極端だ）は、<br />
銃（M16）と<strong class="text-[var(--c-text)]">ペン（＝ラップを書く力）</strong>を並べて、<br />
暴力と言葉を同じ武器として語るレトリックです。</p>
        <p>映画の引用を直喩で取り込みつつ、<br />
自分の本当の武器はペンだとずらしています。<br />
比喩を読むことが、<br />
そのまま文化のレファレンスを読むことになる好例です。</p>
      </LearningUnit>

      <!-- ③ steelo -->
      <LearningUnit
        heading="Y'all know my steelo — スタイルを指すNYスラング"
        label="★ スラング"
        mc="Nas（Verse 1）"
        t={TS["steelo"].t} tApprox={TS["steelo"].approx} youtubeId={YT}
        embed=""
      >
        <Fragment slot="eng">Y'all know my steelo, with or without the airplay</Fragment>
        <Fragment slot="jpn">お前ら俺のスタイル（steelo）は知ってるだろ、ラジオでかかろうがかかるまいが</Fragment>
        <p class="text-xs text-[var(--c-dim)] mb-1">▶ Verse 1前半、自分の流儀を宣言する件。</p>
        <p>学習ポイントは <strong class="text-[var(--c-text)]"><QuickSlang word="steelo" desc="style（スタイル）が崩れたスラング。その人独自のやり方・流儀・美学" /></strong>。<br />
これは <em>style</em>（スタイル）が音的に崩れてできたスラングで、<br />
「その人独自のやり方・流儀・美学」を指します。</p>
        <p><code>Y'all know my steelo</code>（俺の流儀は知ってるだろ）のように使います。<br />
行頭の <strong class="text-[var(--c-text)]">Y'all</strong>（＝you all）は南部・AAVE由来の二人称複数で、<br />
これも頻出です。</p>
        <p><code>with or without the airplay</code>（ラジオでかかろうがかかるまいが）は、<br />
商業的成功に左右されない自分の姿勢を示す決め台詞です。<br />
スラング一語に、<br />
その人のアイデンティティが乗っているのが分かる箇所です。</p>
      </LearningUnit>

      <!-- ④ E&J / Grants / cee-lo -->
      <LearningUnit
        heading="E&J, bent, Grants, cee-lo — 一行に畳まれたNYストリート語彙"
        label="★ スラング（地域語）"
        mc="Nas（Verse 1）"
        t={TS["ej-grants-ceelo"].t} tApprox={TS["ej-grants-ceelo"].approx} youtubeId={YT}
        embed=""
      >
        <Fragment slot="eng">I keep some E&J, sittin' bent up in the stairway<br />Or either on the corner bettin' Grants with the cee-lo champs</Fragment>
        <Fragment slot="jpn">E&Jを切らさず、階段でへべれけになって座ってる／でなきゃ街角で、cee-loの猛者たちとグラント（50ドル札）を賭けてる</Fragment>
        <p class="text-xs text-[var(--c-dim)] mb-1">▶ Verse 1中盤、日常の過ごし方を描く2行。スラングが4つ詰まっています。</p>
        <p>この2行はスラングの宝庫です。</p>
<p><strong class="text-[var(--c-text)]"><QuickSlang word="E&J" desc="E&J Brandy（エラドビントナーズの安価なブランデー）。ストリートの定番の酒" /></strong> は安価なブランデーの銘柄、<strong class="text-[var(--c-text)]">bent</strong> は「酔っ払った・ラリった」状態を指します。</p>
        <p><strong class="text-[var(--c-text)]"><QuickSlang word="Grants" desc="50ドル札のこと。紙幣に描かれた第18代大統領ユリシーズ・S・グラントに由来" /></strong> は「50ドル札」（紙幣に描かれたグラント大統領から）、<strong class="text-[var(--c-text)]"><QuickSlang word="cee-lo" desc="サイコロ3個で行うストリートの賭博ゲーム" /></strong> はサイコロ賭博のことです。<br />
たった2行で、<br />
酒・酩酊・賭博という街角の時間が立ち上がります。</p>
        <p><strong class="text-[var(--c-text)]">紙幣を大統領の名で呼ぶ</strong>（Grants＝50ドル、<br />
ほかに Franklins＝100ドルなど）のは英語スラングの定番なので、<br />
ここで覚えておくと他の曲でも効きます。</p>
        <p>スラングは地域の方言で、<br />
知ることはその街の地図を手に入れることに近いんです。</p>
        <Fragment slot="usage">
          <p>アメリカの紙幣スラングは <strong class="text-[var(--c-text)]">肖像の人物名</strong>で呼ぶのが定番です。<em>Grants</em>＝50ドル（グラント）、<em>Franklins</em>＝100ドル（フランクリン）、<em>Jacksons</em>＝20ドル（ジャクソン）。</p>
          <p>金額を直接言わずに人名で示すので、肖像と額面のペアを知っておくと聞き取れます。</p>
          <p><strong class="text-[var(--c-text)]">bent</strong> は「酔った・ハイになった」を表す形容詞スラングです。<em>get bent</em> で「酩酊する」。</p>
          <p>標準英語の drunk より口語的でストリート寄りの語感です。</p>
        </Fragment>
      </LearningUnit>

      <!-- ⑤ cousin of death -->
      <LearningUnit
        heading="sleep is the cousin of death — 一行で世界観を射抜く比喩"
        label="★ 比喩（最重要）"
        mc="Nas（Verse 1）"
        t={TS["cousin-of-death"].t} tApprox={TS["cousin-of-death"].approx} youtubeId={YT}
        embed=""
      >
        <Fragment slot="eng">I never sleep, huh, 'cause sleep is the cousin of death</Fragment>
        <Fragment slot="jpn">俺は決して眠らない、なぜなら眠りは死の従兄弟だから</Fragment>
        <p class="text-xs text-[var(--c-dim)] mb-1">▶ Verse 1の終盤、緊張の核心を一行に凝縮する件（Verse 2でも反復）。</p>
        <p>この曲、<br />
いや、<br />
ヒップホップ全体でも屈指の名フレーズです。<br />
「sleep is the <strong class="text-[var(--c-text)]">cousin of death</strong>（眠りは死の従兄弟）」。</p>
        <p>眠りと死を <strong class="text-[var(--c-text)]">cousin（従兄弟）</strong>という血縁語で結ぶ比喩で、<br />
「気を抜いて眠れば、<br />
死がすぐ隣に来る」というストリートの強迫を、<br />
たった一行で射抜いています。</p>
        <p>眠ること＝無防備になること＝死に近づくこと、<br />
という連想が <code>cousin</code> 一語に畳まれています。</p>
        <p><code>I never sleep</code>（俺は決して眠らない）と前置きしてからこの比喩に落とすことで、<br />
「眠れない」のではなく「眠らない（生き延びるために）」という能動の緊張に読み替わります。</p>
        <p>Verse 2の終わりでもう一度繰り返されることで、<br />
曲全体を貫くテーマだと分かる作りです。<br />
何度聴いても唸ります。</p>
      </LearningUnit>

      <!-- ⑥ state of mind / title -->
      <LearningUnit
        heading="I think of crime when I'm in a New York State of Mind — タイトルの着地"
        label="★ 表現／テーマ"
        mc="Nas（Verse 1）"
        t={TS["state-of-mind"].t} tApprox={TS["state-of-mind"].approx} youtubeId={YT}
        embed=""
      >
        <Fragment slot="eng">Beyond the walls of intelligence, life is defined<br />I think of crime when I'm in a New York State of Mind</Fragment>
        <Fragment slot="jpn">知性の壁の向こうで、人生は定義される／ニューヨーク・ステイト・オブ・マインドにいると、俺は犯罪のことを考える</Fragment>
        <p class="text-xs text-[var(--c-dim)] mb-1">▶ Verse 1の締め、タイトルに着地する2行。</p>
        <p>学習ポイントは <strong class="text-[var(--c-text)]">state of mind</strong> という英語の定型表現です。<br />
「心の状態・精神状態・物の見方」を意味するイディオムで、<em>a New York state of mind</em> なら「ニューヨーク的なものの見方／NYにいるときの心持ち」を指します。</p>
        <p>Billy Joelの名曲タイトルでもある言い回しを、<br />
Nasは <code>I think of crime</code>（犯罪のことを考える）と接続することで、<br />
まったく別の、<br />
緊張と暴力に満ちたNY観へと塗り替えています。</p>
        <p>同じ定型句が、<br />
置かれる文脈でここまで意味を変えるのか、<br />
という好例です。</p>
        <p>上の行 <code>life is defined</code>（人生が定義される）と <code>State of Mind</code> で <strong class="text-[var(--c-text)]">defined / Mind</strong> の脚韻も効いています。</p>
        <Fragment slot="usage">
          <p><strong class="text-[var(--c-text)]">state of mind</strong> は「心の状態・心境・物の見方」を表す名詞句。<em>be in a good state of mind</em>（良い精神状態にある）、<em>a positive state of mind</em>（前向きな心持ち）のように使う、日常でも頻出のイディオム。</p>
          <p>地名＋state of mind で「その土地（に染まった）特有の感覚」を表せる。Nasはこの定型句に「犯罪を考える」を接続して、NYのダークな側面を一語で立ち上げている。</p>
        </Fragment>
      </LearningUnit>

      <!-- ⑦ Moet / TEC -->
      <LearningUnit
        heading="drinkin' Moëts, holdin' TECs — ブランドと銃で描くギャングスタの夢"
        label="★ スラング／文化"
        mc="Nas（Verse 2）"
        t={TS["moet-tec"].t} tApprox={TS["moet-tec"].approx} youtubeId={YT}
        embed=""
      >
        <Fragment slot="eng">Be havin' dreams that I'm a gangsta, drinkin' Moëts, holdin' TECs<br />Makin' sure the cash came correct, then I stepped</Fragment>
        <Fragment slot="jpn">いつもギャングスタの夢を見る、モエを飲み、TECを構える／金がきっちり入るのを確かめて、それから立ち去った</Fragment>
        <p class="text-xs text-[var(--c-dim)] mb-1">▶ Verse 2の冒頭、夢の中のギャングスタ像を描く件。</p>
        <p>上の行はブランド名と銃で「ギャングスタの夢」を一気に描いています。</p>
<p><strong class="text-[var(--c-text)]">Moëts</strong> はシャンパンのモエ・エ・シャンドン（Moët）、<strong class="text-[var(--c-text)]"><QuickSlang word="TECs" desc="TEC-9。当時ストリートで多用された安価なセミオート拳銃" /></strong> は拳銃TEC-9のことです。</p>
        <p>高級シャンパンと安価な銃を同じ行に並べることで、<br />
虚飾と暴力が隣り合う夢の質感が出ています。</p>
        <p>冒頭の <strong class="text-[var(--c-text)]">Be havin'</strong> は、<br />
ユニット①で見た <strong class="text-[var(--c-text)]">習慣のbe</strong>（いつも夢を見る）がここでも使われている箇所です。</p>
        <p>下の行 <code>the cash came correct</code>（金がきっちり入った）の <strong class="text-[var(--c-text)]">come correct</strong> は「ちゃんとする・抜かりなくやる」という頻出スラングなので、<br />
これも一緒に押さえておきたいところです。</p>
        <Fragment slot="usage">
          <p><strong class="text-[var(--c-text)]">come correct</strong> は「（態度・準備・支払いなどを）きちんとする、抜かりなくやる」を表すスラングです。<em>You better come correct</em>（ちゃんとやれよ）のように使います。</p>
          <p>standard の <em>do it right / be on point</em> に近い言い回しです。</p>
          <p>シャンパンや時計などの<strong class="text-[var(--c-text)]">ブランド名</strong>は、ヒップホップでは「成功・地位」の記号として機能します。</p>
          <p>Moët、Cristal、Rolex などはそのまま富のメタファーになるので、銘柄を知っておくと情景が立ち上がりやすくなります。</p>
        </Fragment>
      </LearningUnit>

      <!-- ⑧ blocks / rocks -->
      <LearningUnit
        heading="sewin' up the blocks to sell rocks — ドラッグ経済のスラングと脚韻"
        label="★ スラング／韻"
        mc="Nas（Verse 2）"
        t={TS["blocks-rocks"].t} tApprox={TS["blocks-rocks"].approx} youtubeId={YT}
        embed=""
      >
        <Fragment slot="eng">Investments in stock, sewin' up the blocks to sell rocks<br />Winnin' gunfights with mega-cops</Fragment>
        <Fragment slot="jpn">株への投資、ブロックを縫い上げて（掌握して）ロック（クラック）を売る／メガ級の警官との銃撃戦に勝つ</Fragment>
        <p class="text-xs text-[var(--c-dim)] mb-1">▶ Verse 2前半、ドラッグ経済を語る件。まず音で。</p>
        <p>まず耳に残るのは音の方です。<strong class="text-[var(--c-text)]">stock / blocks / rocks / cops</strong> と <code>-ock(s)</code> の音が連打されていて、<br />
これが聴きどころです。</p>
        <p>意味の方も、<strong class="text-[var(--c-text)]">sew up the blocks</strong>（街区を縫い上げる＝そのエリアの売買を完全に掌握する）という句動詞的な言い回しに、<strong class="text-[var(--c-text)]"><QuickSlang word="rocks" desc="固形のクラック・コカイン（crack rocks）" /></strong>（クラックの固まり）というスラングが組み合わさって、<br />
ドラッグ経済の支配がわずか一行に圧縮されています。</p>
        <p>合法の <code>investments in stock</code>（株式投資）と非合法の <code>sell rocks</code>（クラック売買）を同じ韻でつなぐことで、<br />
両者を地続きに見せる皮肉も効いています。</p>
        <p>脚韻が意味の橋渡しまでしている好例です。</p>
      </LearningUnit>

      <!-- ⑨ lamp like Capone -->
      <LearningUnit
        heading="lamp like Capone — 「くつろぐ」を意味するNYスラング"
        label="★ スラング（地域語）"
        mc="Nas（Verse 2）"
        t={TS["lamp-capone"].t} tApprox={TS["lamp-capone"].approx} youtubeId={YT}
        embed=""
      >
        <Fragment slot="eng">And lamp like Capone, with drug scripts sewn<br />Or the legal luxury life, rings flooded with stones, homes</Fragment>
        <Fragment slot="jpn">そしてカポネのようにくつろぐ、ドラッグの筋書きを縫い込んで／でなきゃ合法の贅沢な暮らし、石（ダイヤ）で埋め尽くした指輪、なあ</Fragment>
        <p class="text-xs text-[var(--c-dim)] mb-1">▶ Verse 2中盤、成功後のくつろぎを夢想する件。学習対象は上の行。</p>
        <p>上の行頭の <strong class="text-[var(--c-text)]"><QuickSlang word="lamp" desc="ニューヨーク特有のスラングで「くつろぐ・のんびり過ごす」。relax / chill と同義" /></strong> が学習ポイントです。<br />
これはニューヨーク特有のスラングで「くつろぐ・まったり過ごす」という意味（<em>relax / chill</em> と同義）。</p>
        <p><code>lamp like Capone</code> で「（伝説のギャング）アル・カポネのように悠然とくつろぐ」という意味になります。<br />
スラングは <strong class="text-[var(--c-text)]">地域の方言</strong>で、<br />
この <em>lamp</em> は特にNYの語感が強い一語です。</p>
        <p>行末の <strong class="text-[var(--c-text)]">stones</strong> は「ダイヤなどの宝石」を指し、<code>rings flooded with stones</code>（石で溢れた指輪）で富を描きます。</p>
        <p><code>Capone / sewn / stones / homes</code> と <strong class="text-[var(--c-text)]">-one/-ones</strong> の脚韻が連なっているのも聴きどころです。</p>
        <Fragment slot="usage">
          <p><strong class="text-[var(--c-text)]">lamp</strong> は動詞で「くつろぐ・たむろする・のんびりする」を表すNYスラングです。<em>just lampin'</em>（ただまったりしてる）のように進行形で使うことが多いです。</p>
          <p>standard の <em>chill / hang out / relax</em> に当たる語です。</p>
          <p><strong class="text-[var(--c-text)]">stones</strong> は文脈によって「宝石（ダイヤ）」を指すスラング。<em>flooded with stones</em>（石で埋め尽くされた）はアクセサリーに宝石を敷き詰めた状態の定番表現。</p>
        </Fragment>
      </LearningUnit>

      <!-- ⑩ vitamin without a capsule -->
      <LearningUnit
        heading="My rhymin' is a vitamin held without a capsule — 隠喩(metaphor)の作り方"
        label="★ 比喩"
        mc="Nas（Verse 2）"
        t={TS["vitamin-capsule"].t} tApprox={TS["vitamin-capsule"].approx} youtubeId={YT}
        embed=""
      >
        <Fragment slot="eng">I'm takin' rappers to a new plateau, through rap slow<br />My rhymin' is a vitamin held without a capsule</Fragment>
        <Fragment slot="jpn">俺はラッパーたちを新たな高みへ連れて行く、ゆっくりとしたラップで／俺のライムはカプセルなしのビタミンだ</Fragment>
        <p class="text-xs text-[var(--c-dim)] mb-1">▶ Verse 2中盤、自分のライムの効き目を喩える件。学習対象は下の行。</p>
        <p>下の行が今回の学習ポイントです。<br />
「My rhymin' is a <strong class="text-[var(--c-text)]">vitamin held without a capsule</strong>」。</p>
        <p>これは <code>like</code> を使わない <strong class="text-[var(--c-text)]">隠喩（metaphor）</strong>。<br />
自分のライムを「カプセルに包まれていないビタミン」に喩えています。</p>
        <p>カプセル（オブラート）がない＝<strong class="text-[var(--c-text)]">薄めも飾りもせず、<br />
栄養（中身）がダイレクトに効く</strong>、<br />
というイメージです。</p>
        <p>直喩（A is like B）が「〜のようだ」と距離を残すのに対し、<br />
隠喩は「A is B」と言い切ることで像をより強く重ねます。</p>
        <p>たった一語の比喩で「俺の言葉は混じりけなしに効く」と宣言してしまう、<br />
Nasらしい一行です。<code>plateau / slow / rhymin'</code> 周辺の音の運びも滑らかで気持ちいいところです。</p>
        <Fragment slot="usage">
          <p><strong class="text-[var(--c-text)]">隠喩（metaphor）</strong>は <em>like / as</em> を使わず「AはBだ」と直接言い切る比喩です。直喩 <em>A is like B</em> より距離が近く、像が強く重なります。</p>
          <p><em>My rhymin' is a vitamin</em>（俺のライムはビタミンだ）のように、be動詞で名詞を直結させるのが基本形です。</p>
          <p>比喩を読むコツ: be動詞の後ろに、文字どおりには成り立たない名詞（rhyme＝vitamin）が来たら隠喩を疑う。その「ありえない等式」が何を強調しているか（ここでは"混じりけなく効く"）を考えると、意図が見えてきます。</p>
        </Fragment>
      </LearningUnit>

      <!-- ⑪ city never sleeps -->
      <LearningUnit
        heading="The city never sleeps, full of villains and creeps — NYの常套句と内部韻"
        label="★ 韻／表現"
        mc="Nas（Verse 2）"
        t={TS["city-never-sleeps"].t} tApprox={TS["city-never-sleeps"].approx} youtubeId={YT}
        embed=""
      >
        <Fragment slot="eng">The city never sleeps, full of villains and creeps<br />That's where I learned to do my hustle, had to scuffle with freaks</Fragment>
        <Fragment slot="jpn">この街は決して眠らない、悪党と不気味な連中で溢れてる／そこで俺はハッスル（生き抜く術）を覚えた、変なやつらと揉めながら</Fragment>
        <p class="text-xs text-[var(--c-dim)] mb-1">▶ Verse 2後半、街そのものを描く件。まず音で。</p>
        <p>ここもまず音の連なりが聴きどころです。<strong class="text-[var(--c-text)]">sleeps / creeps / freaks</strong> と <code>-ee(p/k)s</code> の内部韻が続きます。</p>
        <p>意味の核は <strong class="text-[var(--c-text)]">The city never sleeps</strong>（眠らない街）、<br />
ニューヨークを指す超有名な常套句です。</p>
        <p>Nasはそこに <code>full of villains and creeps</code>（悪党と不気味な連中で溢れた）を付けて、<br />
観光的なきらめきではなく、<br />
夜も危険が絶えない街として描き直しています。</p>
        <p><strong class="text-[var(--c-text)]"><QuickSlang word="hustle" desc="生き抜くために必死で稼ぐ/動くこと。ストリートでの商売や工夫を含む" /></strong>（必死に生き抜く・稼ぐ）も最重要スラングのひとつです。</p>
        <p>常套句を一度借りて、<br />
自分の経験で塗り替える。<br />
表現の手つきがよく分かる箇所です。</p>
      </LearningUnit>
    </section>

    <!-- 文化的背景 -->
    <section id="background" class="mb-12 scroll-mt-40">
