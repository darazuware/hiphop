    <!-- 評価と影響 -->
    <section data-reading-section="05 · 評価とその後の影響" data-reading-kind="記事本体" id="legacy" class="mb-12 scroll-mt-40">
<span class="reader-section-label">記事本体 · 05</span>
      <h2 class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-5 border-b border-[var(--c-border)] pb-2">
        評価とその後の影響
      </h2>

      <dl class="legacy-records mb-4">
        <div><dt>収録アルバム</dt><dd>『Illmatic』（1994年）2曲目。全10曲のアルバムで、最初のラップ曲にあたります。</dd></div>
        <div><dt>プロデュース</dt><dd>DJ Premier。ピアノのループと、声を刻むスクラッチでNasの語りを支えています。</dd></div>
        <div><dt>続編</dt><dd>『I Am...』（1999年）には「N.Y. State of Mind, Pt. II」が収録されています。</dd></div>
      </dl>
      <div class="p-5 bg-[var(--c-surface)] border border-[var(--c-border)] rounded-lg">
        <p class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-2">後世への影響</p>
        <h3 class="font-semibold text-base mb-3">「リリシズムの基準点」になった一曲</h3>
