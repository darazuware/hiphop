---
import LyricsBlock from '../../components/LyricsBlock.astro';
import QuickSlang from '../../components/QuickSlang.astro';
import SongLayout from '../../layouts/SongLayout.astro';
import AmazonAlbumCta from "../../components/AmazonAlbumCta.astro";
---

<SongLayout
  title="Guess Who's Back 和訳・意味・スラング解説 | Rakim"
  description="Rakim「Guess Who's Back」の歌詞和訳とスラング徹底解説。1997年ソロ復帰作。DJ Clark Kentプロデュース、Bob James「Shamboozie」のサンプリング——ヒップホップの王が帰還を宣言した記念碑的な一曲を完全解読。"
  slug="guess-whos-back"
  noindex={true}
  youtubeId="c7ilAD54Lqo"
  highlights={[
    'DJ Clark Kentが手がけたソロ復帰作のリードシングル——Eric B.解散後、Rakim単独名義による堂々たる帰還宣言',
    'Bob James「Shamboozie」(1979) を骨格に、Eric B. & Rakim「My Melody」やPublic Enemy「Bring the Noise」のフレーズをスクラッチで重ねた構成',
    'Eric B.との解散から5年——ソロキャリア初アルバム「The 18th Letter」のリードシングルとしてシーンに衝撃を与えた復帰宣言',
  ]}
>

    <!-- この曲の意味 -->
    <section class="mb-6">
      <h2 class="text-base font-semibold mb-2">■この曲の意味（要約）</h2>
      <p class="text-sm text-[var(--c-muted)] leading-relaxed">Eric B.&ラキムの解散から5年。ソロアーティストとしての復帰を満を持して宣言した楽曲。DJ Clark Kentのソウルフルなビートに乗せ、ラキムは「俺がいなくなっていた間もヒップホップは俺のもの、そして今戻ってきた」と3ヴァースで圧倒的な存在感を示す。単なるカムバック曲ではなく、スキル・哲学・宇宙観まで凝縮した「MCの王の即位宣言」。</p>
    </section>

    <!-- 概要 -->
    <section class="mb-6">
      <h2 class="text-base font-semibold mb-2">■概要</h2>
      <p class="text-sm text-[var(--c-muted)] leading-relaxed">1997年11月4日、ソロデビューアルバム『The 18th Letter』（Universal Records）のリードシングルとしてリリース。プロデュースはDJ Clark Kent——Bob Jamesの「Shamboozie」（1979年）を核に、Eric B. & Rakim「My Melody」やPublic Enemy「Bring the Noise」などRakim自身ゆかりのフレーズをスクラッチで織り込み、重厚かつソウルフルなBPM 94のビートを構築した。</p>
    </section>

    <!-- 導入 -->
    <section class="mb-10">
      <h2 class="text-base font-semibold mb-2">■導入（時代背景）</h2>
      <p class="text-sm text-[var(--c-muted)] leading-relaxed">1990年代後半、ビギーとトゥパックの相次ぐ死でヒップホップシーンは深刻な傷を負っていた。東西抗争の終焉後、メインストリームは商業化が加速する一方で、「本物のMCスキル」を重視する声は根強かった。そこに「史上最も偉大なMC」と称されるラキムが現れ、「Guess Who's Back（誰が戻ってきたと思う？）」と問いかけた——その答えは自明だった。</p>
    </section>

    <!-- Table of Contents -->
    <nav class="mb-10 p-4 bg-[var(--c-surface)] border border-[var(--c-border)] rounded-lg">
      <p class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-3">目次</p>
      <ol class="space-y-1.5 text-sm text-[var(--c-muted)] list-none">
        <li><a href="#lyrics" class="hover:text-[var(--c-gold)] transition-colors">01 — 歌詞和訳と意味解説</a></li>
        <li><a href="#background" class="hover:text-[var(--c-gold)] transition-colors">02 — 文化的背景</a></li>
        <li><a href="#behind" class="hover:text-[var(--c-gold)] transition-colors">03 — 制作の裏側</a></li>
        <li><a href="#legacy" class="hover:text-[var(--c-gold)] transition-colors">04 — 評価とその後の影響</a></li>
      </ol>
    </nav>

    <div id="lyrics"></div>

    <!-- ===================== -->
    <!-- INTRO                 -->
    <!-- ===================== -->
    <AmazonAlbumCta query="Rakim Guess Who's Back" cover="/images/covers/guess-whos-back.jpg" title="The 18th Letter" artist="Rakim" />

    <!-- まとめ -->
    <section class="mb-12">
      <h2 class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-5 border-b border-[var(--c-border)] pb-2">
        まとめ
      </h2>
      <ul class="space-y-2 text-sm text-[var(--c-muted)] list-disc list-inside leading-relaxed">
        <li>DJ Clark Kentのプロダクションによる、Eric B.解散後のRakim単独名義リードシングルとしての歴史的な帰還。</li>
        <li>Bob James「Shamboozie」のメランコリックなフレーズが「王の帰還」の重みを倍増させた絶妙なサンプリング選択。</li>
        <li>「Born with three 7's / Bury me in Cairo」——Five-Percent Nationとアフロセントリズムが融合したラキム哲学の結晶。</li>
        <li>「I'mma move crowds to two-thousand and somethin'」——1997年から未来を見通した予言は完璧に的中した。</li>
      </ul>
    </section>

</SongLayout>
