      <LearningUnit
        heading="a brother from another mother — 血縁を超えた絆のイディオム"
        label="★ イディオム"
        mc="Fat Joe（Verse 4）"
        t={TS["brother-another-mother"].t} tApprox={TS["brother-another-mother"].approx} youtubeId={YT}
