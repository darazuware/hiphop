---
import Layout from '../../layouts/Layout.astro';
import { columns } from '../../data/columns';
---

<Layout
  title="コラム一覧 — ヒップホップの文化・歴史・言語を深掘り"
  description="WAX&THINKのコラム一覧。歌詞解説を超えて、ヒップホップの文化・歴史・言語・映画・プロデューサー論を事実ベースで深掘りした読み物をまとめて紹介。"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8">

    <header class="mb-8">
      <a href="/" class="text-[var(--c-very-dim)] text-xs hover:text-[var(--c-gold)] transition-colors mb-3 inline-block">← 曲一覧に戻る</a>
      <p class="text-[var(--c-gold)] text-xs uppercase tracking-widest mb-1">Columns</p>
      <h1 class="text-2xl md:text-3xl font-bold leading-tight mb-1">読み物</h1>
      <p class="text-[var(--c-dim)] text-sm">全{columns.length}本 — 歌詞を超えた、ヒップホップの文化・歴史・言語・映画</p>
    </header>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {columns.map(col => (
        <a href={col.slug} class="flex flex-col p-4 bg-[var(--c-surface)] border border-[var(--c-border)] rounded-lg hover:border-[var(--c-gold)] transition-colors group">
          <span class="text-[var(--c-gold)] text-[10px] uppercase tracking-widest mb-2 inline-block">{col.tag}</span>
          <h2 class="text-sm font-bold leading-snug mb-2 group-hover:text-[var(--c-gold)] transition-colors">{col.title}</h2>
          <p class="text-[var(--c-very-dim)] text-xs leading-relaxed line-clamp-3 flex-1">{col.description}</p>
          {col.relatedSongs && col.relatedSongs.length > 0 && (
            <p class="text-[var(--c-very-dim)] text-[10px] font-mono mt-3 pt-3 border-t border-[var(--c-border)]">関連 {col.relatedSongs.length} 曲</p>
          )}
        </a>
      ))}
    </div>

  </div>
</Layout>
